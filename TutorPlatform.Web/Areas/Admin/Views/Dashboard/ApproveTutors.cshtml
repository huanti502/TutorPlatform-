@model IEnumerable<TutorPlatform.Core.Models.TutorProfile>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Duyệt gia sư";
}

<section class="section-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a href="/Admin/Dashboard"
               style="color:var(--text-muted);text-decoration:none;
                font-size:0.875rem;">
                ← Dashboard
            </a>
            <div>
                <h4 style="font-weight:800;margin-bottom:0.2rem;">
                    Duyệt gia sư
                </h4>
                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                    @Model.Count(t => !t.IsApproved) gia sư chờ duyệt
                </p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h6 style="font-weight:700;color:var(--text-muted);">
                    Chưa có gia sư nào
                </h6>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var t in Model)
                {
                    var initial = t.User.FullName.FirstOrDefault()
                                   .ToString().ToUpper();
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100"
                             style="border-radius:var(--radius-lg);
                            border:2px solid @(t.IsApproved ?
                                                                   "var(--success-light)" :
                                                                   "var(--border)");">
                            <div class="card-body p-4">

                                <div class="d-flex align-items-start
                                    justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <a href="/Tutor/Detail/@t.Id" class="d-flex align-items-center gap-2 text-decoration-none" style="color:inherit;">
                                            <div class="avatar avatar-md">
                                                @initial
                                            </div>
                                            <div>
                                                <div style="font-weight:700; font-size:0.9rem; color:var(--text-primary);">
                                                    @t.User.FullName
                                                </div>
                                                <div style="font-size:0.78rem; color:var(--text-muted);">
                                                    @t.User.Email
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <span class="status-badge @(t.IsApproved ? "status-completed" : "status-pending")">
                                        @(t.IsApproved ? "Đã duyệt" : "Chờ duyệt")
                                    </span>
                                </div>

                                <!-- Info -->
                                <div style="font-size:0.82rem;
                                    color:var(--text-secondary);
                                    margin-bottom:1rem;">
                                    <div class="mb-1">
                                        <span style="color:var(--text-muted);
                                            font-weight:500;">
                                            Học vấn:
                                        </span>
                                        @t.Education
                                    </div>
                                    <div class="mb-1">
                                        <span style="color:var(--text-muted);
                                            font-weight:500;">
                                            Kinh nghiệm:
                                        </span>
                                        @t.ExperienceYears năm
                                    </div>
                                    <div class="mb-1">
                                        <span style="color:var(--text-muted);
                                            font-weight:500;">
                                            Học phí:
                                        </span>
                                        @t.HourlyRate.ToString("N0")đ/h
                                    </div>
                                </div>

                                <!-- Môn học -->
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var ts in t.TutorSubjects)
                                    {
                                        <span class="badge"
                                              style="background:var(--primary-light);
                                            color:var(--primary);
                                            font-weight:500;">
                                            @ts.Subject.Name
                                        </span>
                                    }
                                </div>

                                <!-- Action -->
                                <form asp-action="ToggleApprove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    @if (t.IsApproved)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                                            Huỷ duyệt
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-success w-100">
                                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                                            Duyệt gia sư
                                        </button>
                                    }
                                </form>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>