@{
    ViewBag.Title = "Dashboard"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4 px-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 style="font-weight:800;margin:0;letter-spacing:-0.03em;">Dashboard</h4>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:2px 0 0;">Tổng quan hệ thống Gia Sư Việt</p>
        </div>
        <div style="background:var(--success-light);color:#065F46;padding:6px 14px;border-radius:var(--radius-full);font-size:0.8rem;font-weight:600;border:1px solid #A7F3D0;">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:5px;" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        @{
            var kpiData = new[] {
                ("Gia sư", ViewBag.TotalTutors?.ToString() ?? "0", "var(--primary)", "var(--primary-light)",
                 "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"),
                ("Học viên", ViewBag.TotalStudents?.ToString() ?? "0", "var(--success)", "var(--success-light)",
                 "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87m-4-12a4 4 0 0 1 0 7.75"),
                ("Tổng lịch học", ViewBag.TotalBookings?.ToString() ?? "0", "#7C3AED", "#EDE9FE",
                 "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"),
                ("Chờ xác nhận", ViewBag.PendingBookings?.ToString() ?? "0", "var(--warning)", "var(--warning-light)",
                 "M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"),
                ("Hoàn thành", ViewBag.CompletedBookings?.ToString() ?? "0", "var(--success)", "var(--success-light)",
                 "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3"),
                ("Doanh thu", ((decimal)(ViewBag.TotalRevenue ?? 0)).ToString("N0") + "đ", "var(--danger)", "var(--danger-light)",
                 "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"),
            };
        }
        @foreach (var (label, value, color, bg, path) in kpiData)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="stat-card">
                    <div class="d-flex align-items-start justify-content-between">
                        <div>
                            <div class="stat-label">@label</div>
                            <div class="stat-value mt-2" style="color:@color;font-size:1.5rem;">@value</div>
                        </div>
                        <div class="stat-icon" style="background:@bg;">
                            <svg width="20" height="20" fill="none" stroke="@color" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="@path" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 style="font-weight:700;margin:0;font-size:0.9rem;">Doanh thu ước tính</h6>
                            <p style="color:var(--text-muted);font-size:0.78rem;margin:2px 0 0;">12 tháng gần nhất (nghìn VNĐ)</p>
                        </div>
                        <div style="background:var(--primary-light);color:var(--primary);padding:4px 10px;border-radius:var(--radius-full);font-size:0.75rem;font-weight:600;">Năm 2026</div>
                    </div>
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <h6 style="font-weight:700;margin:0;font-size:0.9rem;">Người dùng mới</h6>
                        <p style="color:var(--text-muted);font-size:0.78rem;margin:2px 0 0;">Tăng trưởng 12 tháng</p>
                    </div>
                    <canvas id="growthChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Tutors + Recent Bookings -->
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body" style="padding-bottom:0;">
                    <h6 style="font-weight:700;margin-bottom:1rem;font-size:0.9rem;">
                        <svg width="16" height="16" fill="none" stroke="var(--warning)" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
                        Top 5 Gia sư
                    </h6>
                </div>
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Gia sư</th>
                            <th class="text-center">Buổi</th>
                            <th class="text-center">Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rankColors = new[] { "#F59E0B","#94A3B8","#CD7F32","var(--text-muted)","var(--text-muted)" };
                            int idx = 0;
                        }
                        @foreach (var t in (ViewBag.TopTutors as List<TutorPlatform.Core.Models.TutorProfile> ?? new()))
                        {
                            <tr>
                                <td>
                                    <span style="font-weight:800;color:@rankColors[idx];font-size:0.9rem;font-family:'Plus Jakarta Sans',sans-serif;">@(idx + 1)</span>
                                </td>
                                <td>
                                    <div style="font-weight:600;font-size:0.875rem;color:var(--text-primary);">@t.User?.FullName</div>
                                    <small style="color:var(--text-muted);">@t.TeachingArea</small>
                                </td>
                                <td class="text-center">
                                    <span style="font-weight:700;color:var(--success);">@t.Bookings.Count(b => b.Status == "Completed")</span>
                                </td>
                                <td class="text-center">
                                    <span style="color:var(--warning);font-weight:700;font-size:0.875rem;">
                                        ★ @(t.ReceivedReviews.Any() ? t.ReceivedReviews.Average(r => r.Rating).ToString("0.#") : "—")
                                    </span>
                                </td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body" style="padding-bottom:0;">
                    <h6 style="font-weight:700;margin-bottom:1rem;font-size:0.9rem;">
                        <svg width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24" style="margin-right:6px;" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Lịch đặt gần đây
                    </h6>
                </div>
                <div style="max-height:320px;overflow-y:auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Học viên</th>
                                <th>Gia sư</th>
                                <th>Môn</th>
                                <th>Trạng thái</th>
                                <th>Ngày</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in (ViewBag.RecentBookings as List<TutorPlatform.Core.Models.Booking> ?? new()))
                            {
                                var (bBg, bColor, bLabel) = b.Status switch {
                                    "Pending"   => ("var(--warning-light)", "#D97706", "Chờ duyệt"),
                                    "Confirmed" => ("var(--success-light)", "#059669", "Đã xác nhận"),
                                    "Completed" => ("var(--primary-light)", "var(--primary)", "Hoàn thành"),
                                    "Rejected"  => ("var(--danger-light)", "var(--danger)", "Từ chối"),
                                    _           => ("var(--bg-subtle)", "var(--text-muted)", b.Status)
                                };
                                <tr>
                                    <td style="font-size:0.8rem;">@b.Student?.FullName</td>
                                    <td style="font-size:0.8rem;">@b.TutorProfile?.User?.FullName</td>
                                    <td style="font-size:0.8rem;">@b.Subject?.Name</td>
                                    <td>
                                        <span style="background:@bBg;color:@bColor;border-radius:4px;padding:2px 8px;font-size:0.72rem;font-weight:600;">
                                            @bLabel
                                        </span>
                                    </td>
                                    <td style="font-size:0.78rem;color:var(--text-muted);">@b.CreatedAt.ToString("dd/MM")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() || '#4F46E5';
        const successColor = getComputedStyle(document.documentElement).getPropertyValue('--success').trim() || '#10B981';

        fetch("/Admin/Dashboard/GetRevenueChart").then(r => r.json()).then(data => {
            new Chart(document.getElementById("revenueChart"), {
                type: "line",
                data: {
                    labels: data.map(d => d.label),
                    datasets: [{
                        label: "Doanh thu (nghìn VNĐ)",
                        data: data.map(d => d.revenue),
                        borderColor: "#4F46E5",
                        backgroundColor: "rgba(79,70,229,0.08)",
                        fill: true, tension: 0.4, pointRadius: 4,
                        pointBackgroundColor: "#4F46E5",
                        borderWidth: 2
                    }, {
                        label: "Số buổi học",
                        data: data.map(d => d.count),
                        borderColor: "#10B981",
                        backgroundColor: "transparent",
                        tension: 0.4, yAxisID: "y2",
                        borderWidth: 2, pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { labels: { font: { family: 'Inter', size: 12 }, usePointStyle: true } } },
                    scales: {
                        x: { grid: { color: "rgba(0,0,0,0.04)" }, ticks: { font: { family: 'Inter', size: 11 } } },
                        y: { grid: { color: "rgba(0,0,0,0.04)" }, ticks: { font: { family: 'Inter', size: 11 } }, title: { display: true, text: "Nghìn VNĐ", font: { size: 11 } } },
                        y2: { position: "right", grid: { drawOnChartArea: false }, ticks: { font: { family: 'Inter', size: 11 } }, title: { display: true, text: "Số buổi", font: { size: 11 } } }
                    }
                }
            });
        });

        fetch("/Admin/Dashboard/GetGrowthChart").then(r => r.json()).then(data => {
            new Chart(document.getElementById("growthChart"), {
                type: "bar",
                data: {
                    labels: data.map(d => d.label),
                    datasets: [
                        { label: "Gia sư mới", data: data.map(d => d.tutors), backgroundColor: "rgba(79,70,229,0.75)", borderRadius: 4 },
                        { label: "Học viên mới", data: data.map(d => d.students), backgroundColor: "rgba(16,185,129,0.75)", borderRadius: 4 }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { labels: { font: { family: 'Inter', size: 12 }, usePointStyle: true } } },
                    scales: {
                        x: { grid: { color: "rgba(0,0,0,0.04)" }, ticks: { font: { family: 'Inter', size: 11 } } },
                        y: { beginAtZero: true, ticks: { stepSize: 1, font: { family: 'Inter', size: 11 } }, grid: { color: "rgba(0,0,0,0.04)" } }
                    }
                }
            });
        });
    </script>
}
