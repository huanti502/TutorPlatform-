<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — Admin | Gia Sư Việt</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-polish.css" asp-append-version="true" />
    <style>
            body {
                background: var(--bg);
            }

            /* ── Sidebar ── */
            .admin-sidebar {
                width: 240px;
                height: 100vh;
                overflow: hidden;
                background: var(--text-primary);
                position: fixed;
                top: 0;
                left: 0;
                z-index: 200;
                display: flex;
                flex-direction: column;
            }

            .admin-sidebar-logo {
                padding: 20px 16px;
                display: flex;
                align-items: center;
                gap: 10px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            .admin-sidebar-logo-text {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-weight: 800;
                font-size: 1rem;
                color: #fff;
                letter-spacing: -0.03em;
            }

            .admin-sidebar .nav-section {
                font-size: 0.68rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: rgba(255,255,255,0.35);
                padding: 16px 16px 6px;
                font-weight: 600;
            }

            .admin-sidebar .nav-link {
                color: rgba(255,255,255,0.65) !important;
                padding: 9px 12px;
                border-radius: var(--radius-sm);
                margin: 1px 8px;
                font-size: 0.875rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 10px;
                transition: var(--transition-fast);
            }

                .admin-sidebar .nav-link:hover {
                    background: rgba(255,255,255,0.08);
                    color: #fff !important;
                }

                .admin-sidebar .nav-link.active {
                    background: rgba(79,70,229,0.35);
                    color: #fff !important;
                    font-weight: 600;
                }

                .admin-sidebar .nav-link svg {
                    flex-shrink: 0;
                    opacity: 0.8;
                }

                .admin-sidebar .nav-link:hover svg,
                .admin-sidebar .nav-link.active svg {
                    opacity: 1;
                }

            /* ── Main ── */
            .admin-main {
                margin-left: 240px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ── Topbar ── */
            .admin-topbar {
                background: var(--surface);
                padding: 0 24px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 100;
                min-height: 60px;
            }

            .admin-content {
                flex: 1;
            }

            @@media (max-width: 991px) {
                .admin-sidebar {
                    transform: translateX(-100%);
                    transition: transform 0.25s ease;
                    box-shadow: var(--shadow-xl);
                }

                    .admin-sidebar.open {
                        transform: translateX(0);
                    }

                .admin-main {
                    margin-left: 0;
                }
                /* backdrop behind the open sidebar */
                .admin-backdrop {
                    position: fixed;
                    inset: 0;
                    background: rgba(15,23,42,0.45);
                    backdrop-filter: blur(1px);
                    z-index: 150;
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity 0.25s ease;
                }

                    .admin-backdrop.show {
                        opacity: 1;
                        visibility: visible;
                    }

                body.admin-no-scroll {
                    overflow: hidden;
                }
            }

            @@media (min-width: 992px) {
                .admin-backdrop {
                    display: none;
                }
            }
    
        /* sidebar gọn + tự cuộn */
        .admin-sidebar .nav-link { padding: 5px 12px; font-size: .82rem; margin: 1px 6px; border-radius: 8px; }
        .admin-sidebar .nav-link svg { width: 14px; height: 14px; }
        .admin-sidebar .nav-section { margin: 9px 14px 3px; font-size: .62rem; letter-spacing: .09em; opacity: .55; text-transform: uppercase; }
        .admin-sidebar-logo { padding-top: 12px; padding-bottom: 8px; }
        .admin-sidebar nav { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding-bottom: 8px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.22) transparent; }
        .admin-sidebar nav::-webkit-scrollbar { width: 5px; }
        .admin-sidebar nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.22); border-radius: 99px; }
</style>
</head>
<body>

    <!-- ── Sidebar ── -->
    <aside class="admin-sidebar" id="adminSidebar" role="navigation" aria-label="Admin navigation">
        <div class="admin-sidebar-logo">
            <div class="brand-logo">
                <svg width="16" height="16" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <path d="M6 10L14 6L22 10V14C22 18.4 18.4 21.6 14 22C9.6 21.6 6 18.4 6 14V10Z" fill="white" />
                </svg>
            </div>
            <span class="admin-sidebar-logo-text">TutorAdmin</span>
        </div>

        <nav class="mt-2 flex-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
               href="/Admin">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>

            <div class="nav-section">Vận hành</div>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PendingTutors" ? "active" : "")"
               href="/Admin/PendingTutors">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /><polyline points="16 11 18 13 22 9" /></svg>
                Duyệt Gia sư
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" || ViewContext.RouteData.Values["action"]?.ToString() == "UserDetail" ? "active" : "")"
               href="/Admin/Users">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87m-4-12a4 4 0 0 1 0 7.75" /></svg>
                Người dùng
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Subjects" ? "active" : "")"
               href="/Admin/Subjects">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                Môn học
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Complaints" ? "active" : "")"
               href="/Admin/Complaints">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                Khiếu nại
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SupportTickets" ? "active" : "")"
               href="/Admin/SupportTickets">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                Hỗ trợ / Liên hệ
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Withdrawals" ? "active" : "")"
               href="/Admin/Withdrawals">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                Duyệt rút tiền
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")"
               href="/Admin/Reports">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></svg>
                Báo cáo
            </a>

            <div class="nav-section">Tài chính</div>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Revenue" ? "active" : "")"
               href="/Admin/Revenue">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                Doanh thu
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Packages" ? "active" : "")"
               href="/Admin/Packages">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                Gói học
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Coupons" ? "active" : "")"
               href="/Admin/Coupons">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12V8H4v4" /><path d="M2 12h20v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z" /><path d="M12 7v15" /><path d="M12 7a2.5 2.5 0 0 1 2.5-2.5C16 4.5 16 7 16 7" /><path d="M12 7a2.5 2.5 0 0 0-2.5-2.5C8 4.5 8 7 8 7" /></svg>
                Mã giảm giá
            </a>

            <div class="nav-section">Phân tích</div>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "active" : "")"
               href="/Admin/Statistics">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                Thống kê
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Sentiment" ? "active" : "")"
               href="/Admin/Sentiment">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" /></svg>
                Cảm xúc ĐG
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")"
               href="/Admin/AuditLogs">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
                Nhật ký
            </a>

            <div class="nav-section">Kiểm duyệt</div>
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "BannedWords" ? "active" : "")"
               href="/Admin/BannedWords">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9.5 9.5 5 5M14.5 9.5l-5 5"/></svg>
                Từ cấm
            </a>


            <div class="nav-section">Hệ thống</div>
            <a class="nav-link" href="/">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                Về trang chủ
            </a>

            <div style="padding:0 8px;margin-top:auto;">
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="nav-link w-100 border-0"
                            style="background:none;cursor:pointer;color:rgba(239,68,68,0.8) !important;margin:1px 0;">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Đăng xuất
                    </button>
                </form>
            </div>
        </nav>
    </aside>

    <!-- Backdrop for mobile sidebar -->
    <div class="admin-backdrop" id="adminBackdrop" aria-hidden="true"></div>

    <!-- ── Main ── -->
    <div class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">
            <div style="display:flex;align-items:center;gap:12px;">
                <button class="d-lg-none border-0 bg-transparent p-1" id="sidebarToggle" aria-label="Mở sidebar">
                    <svg width="20" height="20" fill="none" stroke="var(--text-primary)" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>
                <div>
                    <span style="font-size:0.75rem;color:var(--text-muted);">Admin</span>
                    <span style="margin:0 6px;color:var(--border-strong);">/</span>
                    <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">@ViewBag.Title</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="avatar avatar-sm" style="font-size:12px;">
                    @User.Identity?.Name?[0].ToString().ToUpper()
                </div>
                <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">@User.Identity?.Name</span>
            </div>
        </header>

        <!-- Alerts -->
        <div class="px-4 pt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                    @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                    @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info d-flex align-items-center gap-2">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    @TempData["Info"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
        </div>

        <main class="admin-content" id="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
        const sidebar = document.getElementById('adminSidebar');
        const toggle = document.getElementById('sidebarToggle');
        const backdrop = document.getElementById('adminBackdrop');

        function openSidebar() {
        sidebar?.classList.add('open');
        backdrop?.classList.add('show');
        document.body.classList.add('admin-no-scroll');
        }
        function closeSidebar() {
        sidebar?.classList.remove('open');
        backdrop?.classList.remove('show');
        document.body.classList.remove('admin-no-scroll');
        }

        toggle?.addEventListener('click', () => {
        sidebar?.classList.contains('open') ? closeSidebar() : openSidebar();
        });
        backdrop?.addEventListener('click', closeSidebar);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });
        // close after navigating on mobile
        sidebar?.querySelectorAll('a.nav-link').forEach(a => a.addEventListener('click', closeSidebar));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>