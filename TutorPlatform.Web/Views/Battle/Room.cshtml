@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Battle Room";
}

<style>
.battle-wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .scoreboard {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .player-score {
        text-align: center;
    }

    .score-num {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1;
    }

    .timer-wrap {
        text-align: center;
    }

    .timer-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #f0f2f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0 auto 4px;
    }

        .timer-circle.urgent {
            background: #fee2e2;
            color: #dc2626;
            animation: battlePulse .5s infinite;
        }

    .option-btn {
        width: 100%;
        text-align: left;
        padding: 12px 16px;
        margin-bottom: 8px;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        background: white;
        cursor: pointer;
        font-size: 0.95rem;
        transition: all .15s;
    }

        .option-btn:hover {
            border-color: #6366f1;
            background: #f5f3ff;
        }

        .option-btn.correct {
            border-color: #22c55e;
            background: #f0fdf4;
            color: #166534;
        }

        .option-btn.wrong {
            border-color: #ef4444;
            background: #fef2f2;
            color: #991b1b;
        }

    .progress-bar-battle {
        height: 8px;
        border-radius: 4px;
        background: #e5e7eb;
        margin-bottom: 1.5rem;
    }

    .progress-fill {
        height: 100%;
        border-radius: 4px;
        background: #6366f1;
        transition: width .3s ease;
    }

    #result-card {
        display: none;
    }

    #loading-card {
        text-align: center;
        padding: 3rem;
    }

    @@keyframes battlePulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }
</style>

<div class="battle-wrap">
<div id="loading-card">
<div class="spinner-border text-primary mb-3" role="status"></div>
<p class="text-muted" id="loading-msg">Đang kết nối với đối thủ và tải câu hỏi...</p>
</div>

    <div id="battle-card" style="display:none">
<div class="scoreboard">
<div class="player-score">
<div class="fw-bold" id="p1-name">Player 1</div>
<div class="score-num text-primary" id="score1">0</div>
</div>

            <div class="timer-wrap">
<div class="timer-circle" id="timer-circle">60</div>
<small class="text-muted">giây</small>
<div class="mt-1 text-muted small" id="q-counter">Câu 1/10</div>
</div>

            <div class="player-score">
<div class="fw-bold" id="p2-name">Player 2</div>
<div class="score-num text-danger" id="score2">0</div>
</div>
</div>

        <div class="progress-bar-battle">
<div class="progress-fill" id="q-progress" style="width:10%"></div>
</div>

        <div class="card shadow-sm mb-3">
<div class="card-body">
<p class="fw-semibold fs-5 mb-3" id="question-text">Đang tải câu hỏi...</p>
<div id="options-wrap"></div>
</div>
</div>
</div>

    <div id="result-card" class="text-center">
<div id="result-emoji" style="font-size:4rem" class="mb-2"></div>
<h3 class="fw-bold" id="result-title"></h3>
<p class="text-muted" id="result-detail"></p>

        <div class="d-flex justify-content-center gap-3 my-3">
<div class="card px-4 py-3 text-center border-primary">
<div class="fs-3 fw-bold text-primary" id="final-score1">0</div>
<small id="final-p1-name" class="text-muted"></small>
</div>

            <div class="card px-4 py-3 text-center border-danger">
<div class="fs-3 fw-bold text-danger" id="final-score2">0</div>
<small id="final-p2-name" class="text-muted"></small>
</div>
</div>

        <div class="alert alert-success" id="xp-alert" style="display:none"></div>

        <a href="/Battle" class="btn btn-primary mt-2"> Trận mới</a>
<a href="/Quiz" class="btn btn-outline-secondary mt-2 ms-2"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"/></svg> Quiz thường</a>
</div>
</div>

@section Scripts {

    <script>
const roomId = '@ViewBag.RoomId';
        const myId = '@ViewBag.MyId';
        const myName = '@ViewBag.MyName';

        // Phòng vệ: nếu không lấy được mã phòng từ URL thì báo rõ ngay,
        // tránh gọi JoinRoom("") rồi nhận lỗi "không tìm thấy phòng" khó hiểu.
        if (!roomId) {
        showLoadingError("Thiếu mã phòng Battle trong đường dẫn.");
        }

        let questions = [];
        let currentQ = 0;
        let answered = false;
        let timeLeft = 60;
        let timerHandle = null;
        let battleInfo = null;
        let battleStarted = false;
        let finished = false;
        let questionsLoaded = false;

        // ── Kết nối SignalR
        const conn = new signalR.HubConnectionBuilder()
        .withUrl("/battleHub")
        .withAutomaticReconnect([0, 1000, 2000, 5000]) // retry nhanh hơn
        .build();

        // ── Nhận thông tin phòng
        conn.on("RoomInfo", info => {
        battleInfo = info;
        document.getElementById("p1-name").textContent = info.player1Name || "Player 1";
        document.getElementById("p2-name").textContent = info.player2Name || "Đang chờ đối thủ...";
        document.getElementById("final-p1-name").textContent = info.player1Name || "Player 1";
        document.getElementById("final-p2-name").textContent = info.player2Name || "Player 2";
        });

        // ── Lỗi phòng
        conn.on("RoomError", message => {
        showLoadingError(message);
        });

        // ── Cả 2 đã vào phòng → Player1 generate câu hỏi
        conn.on("BothReady", async () => {
        if (!battleInfo) {
        showLoadingError("Chưa nhận được thông tin trận đấu.");
        return;
        }

        // Chỉ Player1 generate câu hỏi
        if (myId !== battleInfo.player1Id) return;
        if (questionsLoaded) return;
        questionsLoaded = true;

        setLoadingMsg(" Đang tải câu hỏi từ AI...");

        try {
        const res = await fetch("/Battle/GenerateQuestions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
        subjectId: battleInfo.subjectId,
        level: battleInfo.level
        })
        });

        const json = await res.json();

        if (!json.success) {
        showLoadingError("Lỗi tải câu hỏi: " + (json.error || "Không rõ lỗi."));
        return;
        }

        if (!json.data || !json.data.questions) {
        showLoadingError("AI trả về dữ liệu câu hỏi không hợp lệ.");
        return;
        }

        await conn.invoke("BroadcastQuestions", roomId, JSON.stringify(json.data.questions));
        } catch (err) {
        console.error(err);
        showLoadingError("Không thể tải câu hỏi. Hãy kiểm tra API AI hoặc kết nối mạng.");
        }
        });

        // ── Nhận câu hỏi → bắt đầu trận
        conn.on("ReceiveQuestions", questionsJson => {
        try {
        questions = JSON.parse(questionsJson);
        } catch (err) {
        showLoadingError("Dữ liệu câu hỏi bị lỗi.");
        return;
        }

        if (!questions || questions.length === 0) {
        showLoadingError("Không có câu hỏi để bắt đầu trận đấu.");
        return;
        }

        document.getElementById("loading-card").style.display = "none";
        document.getElementById("battle-card").style.display = "block";
        startBattle();
        });

        // ── KHÔI PHỤC SAU F5: server gửi lại câu hỏi + điểm + thời gian còn lại
        conn.on("ResumeBattle", ({ questionsJson, score1, score2, secondsLeft, answeredCount }) => {
        if (battleStarted || finished) return;
        try {
        questions = JSON.parse(questionsJson);
        } catch (err) {
        showLoadingError("Dữ liệu câu hỏi bị lỗi.");
        return;
        }
        if (!questions || questions.length === 0) {
        showLoadingError("Không có câu hỏi để tiếp tục trận đấu.");
        return;
        }

        // Khôi phục điểm
        document.getElementById("score1").textContent = score1;
        document.getElementById("score2").textContent = score2;

        // Nhảy tới câu chưa trả lời (client trả lời tuần tự nên = số câu đã trả lời)
        currentQ = Math.min(answeredCount || 0, questions.length);

        document.getElementById("loading-card").style.display = "none";
        document.getElementById("battle-card").style.display = "block";

        // Bắt đầu lại với thời gian còn lại của server
        startBattle(secondsLeft);

        // Nếu đã trả lời hết câu thì hiện thông báo chờ kết quả
        if (currentQ >= questions.length) {
        document.getElementById("question-text").textContent =
        "Bạn đã trả lời hết câu hỏi. Chờ hết giờ để xem kết quả.";
        document.getElementById("options-wrap").innerHTML = "";
        }
        });

        // ── Cập nhật điểm
        conn.on("ScoreUpdate", ({ score1, score2 }) => {
        document.getElementById("score1").textContent = score1;
        document.getElementById("score2").textContent = score2;
        });

        // ── Kết quả trận
        conn.on("BattleResult", ({ result, winnerId, winnerName, score1, score2, xpWinner, xpLoser }) => {
        if (finished) return;
        finished = true;
        clearInterval(timerHandle);

        document.getElementById("battle-card").style.display = "none";
        document.getElementById("loading-card").style.display = "none";
        document.getElementById("result-card").style.display = "block";

        // So sánh bằng ID người dùng (chắc chắn), KHÔNG so bằng tên hiển thị
        // vì tên tiếng Việt có dấu dễ lệch nhau ở mức mã Unicode.
        const iWon = result !== "draw" && winnerId === myId;

        let emoji, title, detail;
        if (result === "draw") {
        emoji = ""; title = "Hòa!"; detail = "Hai bên cân tài nhau!";
        } else if (iWon) {
        emoji = ""; title = "Bạn thắng!"; detail = "Xuất sắc!";
        } else {
        emoji = ""; title = "Bạn thua!"; detail = `${winnerName} giỏi hơn lần này!`;
        }

        document.getElementById("result-emoji").textContent = emoji;
        document.getElementById("result-title").textContent = title;
        document.getElementById("result-detail").textContent = detail;
        document.getElementById("final-score1").textContent = score1;
        document.getElementById("final-score2").textContent = score2;

        const xpGained = iWon ? xpWinner : xpLoser;
        if (xpGained > 0) {
        const xpAlert = document.getElementById("xp-alert");
        xpAlert.textContent = `+${xpGained} XP nhận được!`;
        xpAlert.style.display = "block";
        }
        });

        // ── Đối thủ rời trận
        conn.on("OpponentLeft", () => {
        clearInterval(timerHandle);
        alert("Đối thủ đã rời trận.");
        window.location.href = "/Battle";
        });

        // ── Reconnect → tự join lại phòng
        conn.onreconnected(async () => {
        console.log("SignalR reconnected, rejoining room...");
        try {
        await conn.invoke("JoinRoom", roomId);
        } catch (err) {
        console.error("Rejoin failed:", err);
        }
        });

        // ── Khởi động
        conn.start()
        .then(async () => {
        try {
        await conn.invoke("JoinRoom", roomId);
        } catch (err) {
        console.error(err);
        showLoadingError("Không thể vào phòng Battle. Hãy quay lại và tạo trận mới.");
        }
        })
        .catch(err => {
        console.error(err);
        showLoadingError("Không thể kết nối BattleHub. Hãy kiểm tra SignalR hoặc đăng nhập lại.");
        });

        // ── Nếu sau 30 giây vẫn chưa bắt đầu → thông báo chờ đối thủ
        setTimeout(() => {
        if (!battleStarted && !finished) {
        setLoadingMsg("⏳ Đang chờ đối thủ vào phòng...");
        }
        }, 5000);

        // ── Nếu sau 120 giây vẫn chưa bắt đầu → báo lỗi timeout
        setTimeout(() => {
        if (!battleStarted && !finished) {
        showLoadingError("Đối thủ không vào phòng trong 2 phút. Hãy tạo trận mới.");
        }
        }, 120000);

        function startBattle(startSeconds) {
        if (battleStarted) return;
        battleStarted = true;
        timeLeft = (typeof startSeconds === "number" && startSeconds >= 0) ? startSeconds : 60;

        const circle = document.getElementById("timer-circle");
        circle.textContent = timeLeft;
        if (timeLeft <= 10) circle.classList.add("urgent");

        // Nếu khôi phục mà đã hết giờ → kết thúc luôn
        if (timeLeft <= 0) {
        conn.invoke("FinishBattle", roomId).catch(console.error);
        return;
        }

        timerHandle = setInterval(() => {
        timeLeft--;
        circle.textContent = timeLeft;
        if (timeLeft <= 10) circle.classList.add("urgent");
        if (timeLeft <= 0) {
        clearInterval(timerHandle);
        conn.invoke("FinishBattle", roomId).catch(console.error);
        }
        }, 1000);

        // Chỉ render nếu còn câu chưa trả lời
        if (currentQ < questions.length) renderQuestion();
        }

        function renderQuestion() {
        if (currentQ >= questions.length) return;
        const q = questions[currentQ];
        answered = false;

        document.getElementById("question-text").textContent = q.question || "Không có nội dung câu hỏi";
        document.getElementById("q-counter").textContent = `Câu ${currentQ + 1}/${questions.length}`;
        document.getElementById("q-progress").style.width = `${((currentQ + 1) / questions.length) * 100}%`;

        const wrap = document.getElementById("options-wrap");
        wrap.innerHTML = "";

        if (!q.options || !Array.isArray(q.options)) {
        showLoadingError("Câu hỏi AI trả về thiếu danh sách đáp án.");
        return;
        }

        q.options.forEach((opt, i) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.textContent = opt;
        btn.onclick = () => pickAnswer(i, q.correctIndex);
        wrap.appendChild(btn);
        });
        }

        function pickAnswer(chosen, correct) {
        if (answered) return;
        answered = true;
        const isCorrect = chosen === correct;

        document.querySelectorAll(".option-btn").forEach((b, i) => {
        b.disabled = true;
        if (i === correct) b.classList.add("correct");
        else if (i === chosen && !isCorrect) b.classList.add("wrong");
        });

        conn.invoke("SubmitAnswer", roomId, currentQ, isCorrect).catch(console.error);

        setTimeout(() => {
        currentQ++;
        if (currentQ < questions.length) {
        renderQuestion();
        } else {
        document.getElementById("question-text").textContent =
        "Bạn đã trả lời hết câu hỏi. Chờ hết giờ để xem kết quả.";
        document.getElementById("options-wrap").innerHTML = "";
        }
        }, 1200);
        }

        function setLoadingMsg(msg) {
        const el = document.getElementById("loading-msg");
        if (el) el.textContent = msg;
        }

        function showLoadingError(message) {
        document.getElementById("loading-card").style.display = "block";
        document.getElementById("battle-card").style.display = "none";
        document.getElementById("loading-card").innerHTML = `
        <p class="text-danger fw-bold">${message}</p>
<p class="text-muted small">Không mở lại link phòng cũ. Hãy quay lại Battle và tạo trận mới.</p>
<a href="/Battle" class="btn btn-primary mt-2">Quay lại Battle</a>
`;
        }
    </script>
}
