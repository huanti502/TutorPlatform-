@model IEnumerable<TutorPlatform.Core.Models.AppUser>
@{
    ViewData["Title"] = "Tin nhắn";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<style>
    .conv-item {
        transition: all 0.18s ease;
        border-bottom: 1px solid var(--border) !important;
        cursor: pointer;
    }
    .conv-item:last-child { border-bottom: none !important; }
    .conv-item:hover {
        background: var(--primary-light) !important;
        transform: translateX(4px);
    }
    .online-dot {
        width: 10px; height: 10px; border-radius: 50%;
        background: #059669;
        border: 2px solid #fff;
        position: absolute; bottom: 0; right: 0;
    }
</style>

<section class="section-sm">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                <!-- Header -->
                <div class="d-flex align-items-center
                            justify-content-between mb-4">
                    <div>
                        <h4 style="font-weight:800;margin-bottom:0.2rem;">
                            Tin nhắn
                        </h4>
                        @if (unreadCount > 0)
                        {
                            <p style="color:var(--text-muted);
                                      font-size:0.875rem;margin:0;">
                                <span style="color:#059669;font-weight:700;">
                                    @unreadCount
                                </span>
                                tin nhắn chưa đọc
                            </p>
                        }
                        else
                        {
                            <p style="color:var(--text-muted);
                                      font-size:0.875rem;margin:0;">
                                Tất cả đã đọc
                            </p>
                        }
                    </div>
                    <div style="width:40px;height:40px;border-radius:10px;
                                background:var(--primary-light);
                                display:flex;align-items:center;
                                justify-content:center;">
                        <svg width="20" height="20" fill="none"
                             stroke="var(--primary)" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5
                                     a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                    </div>
                </div>

                <!-- Conversation list -->
                <div class="card"
                     style="border-radius:var(--radius-xl);border:none;
                            box-shadow:var(--shadow-md);overflow:hidden;">

                    @if (!Model.Any())
                    {
                        <div class="p-5 text-center">
                            <div style="width:64px;height:64px;border-radius:18px;
                                        background:var(--primary-light);
                                        display:flex;align-items:center;
                                        justify-content:center;
                                        margin:0 auto 1rem;">
                                <svg width="28" height="28" fill="none"
                                     stroke="var(--primary)" stroke-width="1.5"
                                     viewBox="0 0 24 24">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5
                                             a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                </svg>
                            </div>
                            <h6 style="font-weight:700;margin-bottom:0.4rem;">
                                Chưa có cuộc trò chuyện nào
                            </h6>
                            <p style="color:var(--text-muted);
                                      font-size:0.85rem;margin:0;">
                                Nhắn tin với gia sư từ trang hồ sơ của họ
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var partner in Model)
                            {
                                var initial = partner.FullName
                                    .FirstOrDefault().ToString().ToUpper();
                                <a asp-action="Chat"
                                   asp-route-id="@partner.Id"
                                   class="conv-item list-group-item
                                          list-group-item-action
                                          d-flex align-items-center
                                          gap-3 p-3 text-decoration-none">

                                    <!-- Avatar with online indicator -->
                                    <div style="position:relative;flex-shrink:0;">
                                        <div class="avatar avatar-md">
                                            @initial
                                        </div>
                                        <span class="online-dot"></span>
                                    </div>

                                    <!-- Info -->
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="d-flex align-items-center
                                                    justify-content-between">
                                            <span style="font-weight:700;
                                                         font-size:0.9rem;
                                                         color:var(--text-primary);">
                                                @partner.FullName
                                            </span>
                                            <span class="badge"
                                                  style="background:@(partner.Role == "Tutor" ? "var(--primary-light)" : "var(--success-light)");
                                                         color:@(partner.Role == "Tutor" ? "var(--primary)" : "#059669");
                                                         font-size:0.68rem;">
                                                @partner.Role
                                            </span>
                                        </div>
                                        <div style="font-size:0.8rem;
                                                    color:var(--text-muted);
                                                    margin-top:2px;
                                                    overflow:hidden;
                                                    text-overflow:ellipsis;
                                                    white-space:nowrap;">
                                            @partner.Email
                                        </div>
                                    </div>

                                    <!-- Arrow -->
                                    <svg width="16" height="16" fill="none"
                                         stroke="var(--text-muted)" stroke-width="2"
                                         viewBox="0 0 24 24" style="flex-shrink:0;">
                                        <path d="m9 18 6-6-6-6"/>
                                    </svg>
                                </a>
                            }
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</section>