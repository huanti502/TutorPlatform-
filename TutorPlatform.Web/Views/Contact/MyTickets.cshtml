@model List<TutorPlatform.Core.Models.SupportTicket>
@{
    ViewData["Title"] = "Yêu cầu hỗ trợ của tôi";

    string BadgeClass(string s) => s switch
    {
        "Open" => "bg-warning text-dark",
        "InProgress" => "bg-info text-dark",
        "Resolved" => "bg-success",
        _ => "bg-secondary"
    };
    string StatusText(string s) => s switch
    {
        "Open" => "Đang chờ",
        "InProgress" => "Đang xử lý",
        "Resolved" => "Đã phản hồi",
        _ => "Đã đóng"
    };
}

<div class="container py-5" style="max-width:860px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Yêu cầu hỗ trợ của tôi</h3>
        <a asp-action="Index" class="btn btn-primary btn-sm px-3">+ Gửi yêu cầu mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                Bạn chưa gửi yêu cầu hỗ trợ nào.
            </div>
        </div>
    }
    else
    {
        foreach (var t in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                        <div>
                            <span class="badge bg-light text-dark border me-2">@t.Category</span>
                            <span class="fw-semibold">@t.Subject</span>
                        </div>
                        <span class="badge @BadgeClass(t.Status)">@StatusText(t.Status)</span>
                    </div>
                    <p class="text-muted small mb-2" style="white-space:pre-line;">@t.Content</p>
                    <div class="text-muted" style="font-size:0.75rem;">Gửi lúc @t.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>

                    @if (!string.IsNullOrEmpty(t.AdminReply))
                    {
                        <div class="mt-3 p-3 rounded-3" style="background:var(--primary-light);">
                            <div class="fw-semibold small mb-1" style="color:var(--primary);">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="me-1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                Phản hồi từ quản trị viên
                            </div>
                            <div class="small" style="white-space:pre-line;">@t.AdminReply</div>
                            @if (t.RepliedAt != null)
                            {
                                <div class="text-muted mt-1" style="font-size:0.72rem;">@t.RepliedAt.Value.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
