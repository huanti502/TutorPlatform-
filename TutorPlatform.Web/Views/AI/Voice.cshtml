@{
    ViewData["Title"] = "Trợ lý giọng nói";
}

<style>
.voice-wrap { max-width: 640px; margin: 0 auto; }
    .mic-btn {
        width: 96px; height: 96px; border-radius: 50%; border: none;
        background: #7c3aed; color: #fff; font-size: 2.2rem;
        box-shadow: 0 8px 24px rgba(124,58,237,.35);
        transition: transform .15s ease, background .15s ease;
    }
    .mic-btn:hover { transform: scale(1.05); }
    .mic-btn.listening {
        background: #ef4444;
        animation: pulse 1.2s infinite;
    }
    .mic-btn.speaking { background: #059669; }
    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(239,68,68,.45); }
        70% { box-shadow: 0 0 0 22px rgba(239,68,68,0); }
        100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
    }
    .vc-msg { border-radius: 14px; padding: .6rem .9rem; max-width: 85%; font-size: .92rem; }
    .vc-user { background: #7c3aed; color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
    .vc-ai { background: #f1f5f9; color: #1e293b; margin-right: auto; border-bottom-left-radius: 4px; }
</style>

<div class="container py-4 voice-wrap">
<div class="text-center mb-3">
<h3 class="mb-1"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg> Trợ lý giọng nói AI</h3>
<p class="text-muted mb-0">Bấm micro và hỏi bằng giọng nói — AI trả lời và đọc cho bạn nghe.</p>
<p class="text-muted small">Ví dụ: "Tìm gia sư Toán giá dưới 200 nghìn", "Gia sư nào được đánh giá cao nhất?"</p>
</div>

    <div id="chatLog" class="d-flex flex-column gap-2 mb-3 p-3 bg-white border rounded-4 shadow-sm"
         style="min-height:240px;max-height:380px;overflow-y:auto;"></div>

    <div class="text-center">
<div id="voiceStatus" class="small text-muted mb-2">Sẵn sàng — bấm micro để nói</div>
<button id="micBtn" class="mic-btn" title="Nói"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3"/></svg></button>
<div class="mt-2">
<button id="stopSpeak" class="btn btn-sm btn-outline-secondary" style="display:none;">⏹ Dừng đọc</button>
</div>
</div>
</div>

@section Scripts {
<script>
const micBtn = document.getElementById('micBtn');
    const statusEl = document.getElementById('voiceStatus');
    const log = document.getElementById('chatLog');
    const stopBtn = document.getElementById('stopSpeak');
    const history = [];

    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) {
        statusEl.textContent = 'Trình duyệt không hỗ trợ nhận dạng giọng nói. Hãy dùng Chrome hoặc Edge.';
        micBtn.disabled = true;
    }

    const recog = SR ? new SR() : null;
    if (recog) { recog.lang = 'vi-VN'; recog.interimResults = false; recog.maxAlternatives = 1; }

    let listening = false;

    function addMsg(text, who) {
        const div = document.createElement('div');
        div.className = 'vc-msg ' + (who === 'user' ? 'vc-user' : 'vc-ai');
        div.textContent = who === 'user' ? text : text.replace(/\*\*|__/g, '');
        log.appendChild(div);
        log.scrollTop = log.scrollHeight;
    }

    // Bỏ markdown/emoji cho giọng đọc mượt
    function toSpeech(text) {
        return text
            .replace(/[*_#`>~\-]+/g, ' ')
            .replace(/\[(.*?)\]\(.*?\)/g, '$1')
            .replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/gu, '')
            .replace(/\s{2,}/g, ' ').trim();
    }

    // ==== Giọng đọc tiếng Việt ====
    // Chrome nạp danh sách giọng BẤT ĐỒNG BỘ -> phải chờ voiceschanged rồi mới chọn giọng.
    let viVoice = null;
    function pickViVoice() {
        const voices = speechSynthesis.getVoices();
        viVoice = voices.find(v => v.name === 'Google Tiếng Việt')
               || voices.find(v => (v.lang || '').toLowerCase().startsWith('vi'))
               || null;
        return viVoice;
    }
    function ensureViVoice() {
        return new Promise(resolve => {
            if (pickViVoice()) return resolve(viVoice);
            let done = false;
            speechSynthesis.onvoiceschanged = () => {
                if (done) return;
                if (pickViVoice()) { done = true; resolve(viVoice); }
            };
            // chờ tối đa 2s rồi chấp nhận không có
            setTimeout(() => { if (!done) { done = true; resolve(pickViVoice()); } }, 2000);
        });
    }

    // Chia câu dài thành đoạn ngắn (Chrome hay cắt ngang utterance dài)
    function chunkText(text, max = 180) {
        const parts = [];
        let rest = text;
        while (rest.length > max) {
            let cut = rest.lastIndexOf('.', max);
            if (cut < 40) cut = rest.lastIndexOf(',', max);
            if (cut < 40) cut = rest.lastIndexOf(' ', max);
            if (cut < 40) cut = max;
            parts.push(rest.slice(0, cut + 1));
            rest = rest.slice(cut + 1).trim();
        }
        if (rest) parts.push(rest);
        return parts;
    }

    // ==== Dự phòng: đọc bằng Google Translate TTS khi máy không có giọng Việt ====
    let gttsQueue = [];
    let gttsAudio = null;
    let gttsPlaying = false;

    function stopGtts() {
        gttsQueue = [];
        gttsPlaying = false;
        if (gttsAudio) { gttsAudio.pause(); gttsAudio = null; }
        micBtn.classList.remove('speaking');
        stopBtn.style.display = 'none';
    }

    function playGttsQueue() {
        if (!gttsQueue.length) {
            gttsPlaying = false;
            micBtn.classList.remove('speaking');
            stopBtn.style.display = 'none';
            statusEl.textContent = 'Sẵn sàng — bấm micro để nói';
            return;
        }
        const part = gttsQueue.shift();
        const url = '/AI/Tts?text=' + encodeURIComponent(part); // proxy qua server, không bị chặn
        gttsAudio = new Audio(url);
        gttsAudio.onended = playGttsQueue;
        gttsAudio.onerror = () => {
            statusEl.textContent = ' Không phát được giọng đọc. Câu trả lời hiển thị ở trên.';
            stopGtts();
        };
        gttsAudio.play().catch(() => stopGtts());
    }

    function speakViaGtts(text) {
        stopGtts();
        gttsQueue = chunkText(text, 170);
        gttsPlaying = true;
        micBtn.classList.add('speaking');
        stopBtn.style.display = 'inline-block';
        statusEl.textContent = 'Đang đọc câu trả lời…';
        playGttsQueue();
    }

    async function speak(text) {
        const clean = toSpeech(text);
        const voice = ('speechSynthesis' in window) ? await ensureViVoice() : null;

        // Không có giọng Việt trên máy -> dùng Google Translate TTS
        if (!voice) { speakViaGtts(clean); return; }

        speechSynthesis.cancel();
        const chunks = chunkText(clean);
        chunks.forEach((part, i) => {
            const u = new SpeechSynthesisUtterance(part);
            u.voice = voice; u.lang = voice.lang || 'vi-VN'; u.rate = 1.02;
            if (i === 0) u.onstart = () => { micBtn.classList.add('speaking'); stopBtn.style.display = 'inline-block'; statusEl.textContent = 'Đang đọc câu trả lời…'; };
            if (i === chunks.length - 1) u.onend = () => { micBtn.classList.remove('speaking'); stopBtn.style.display = 'none'; statusEl.textContent = 'Sẵn sàng — bấm micro để nói'; };
            speechSynthesis.speak(u);
        });
    }

    stopBtn.addEventListener('click', () => { speechSynthesis.cancel(); stopGtts(); statusEl.textContent = 'Sẵn sàng — bấm micro để nói'; });

    async function ask(text) {
        addMsg(text, 'user');
        statusEl.textContent = 'AI đang suy nghĩ…';
        try {
            const res = await fetch('/AI/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text, history })
            });
            const data = await res.json();
            const reply = data.reply || 'Xin lỗi, mình chưa trả lời được.';
            history.push({ role: 'user', content: text });
            history.push({ role: 'assistant', content: reply });
            if (history.length > 12) history.splice(0, history.length - 12);
            addMsg(reply, 'ai');
            speak(reply);
        } catch {
            statusEl.textContent = 'Có lỗi khi gọi AI. Thử lại nhé.';
        }
    }

    if (recog) {
        micBtn.addEventListener('click', () => {
            if (listening) { recog.stop(); return; }
            speechSynthesis.cancel();
            stopGtts();
            try { recog.start(); } catch { }
        });

        recog.onstart = () => { listening = true; micBtn.classList.add('listening'); statusEl.textContent = ' Đang nghe… hãy nói câu hỏi'; };
        recog.onend = () => { listening = false; micBtn.classList.remove('listening'); if (statusEl.textContent.startsWith('')) statusEl.textContent = 'Sẵn sàng — bấm micro để nói'; };
        recog.onerror = e => {
            listening = false; micBtn.classList.remove('listening');
            statusEl.textContent = e.error === 'not-allowed'
                ? 'Hãy cấp quyền micro cho trang web.'
                : 'Không nghe rõ — bấm micro thử lại.';
        };
        recog.onresult = e => {
            const text = e.results[0][0].transcript;
            ask(text);
        };
    }

    // load voices sớm (Chrome nạp async)
    if ('speechSynthesis' in window) speechSynthesis.getVoices();
</script>
}
