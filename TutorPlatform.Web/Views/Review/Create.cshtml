@{
    ViewData["Title"] = "Đánh giá gia sư";
    var booking = (TutorPlatform.Core.Models.Booking)ViewBag.Booking;
    var initial = booking.TutorProfile.User.FullName
                    .FirstOrDefault().ToString().ToUpper();
}

<style>
.star-btn {
        font-size: 2.5rem;
        cursor: pointer;
        color: #E2E8F0;
        transition: all 0.15s ease;
        line-height: 1;
        user-select: none;
    }
    .star-btn:hover,
    .star-btn.active {
        color: #F59E0B;
        transform: scale(1.15);
    }
    .rating-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-muted);
        min-height: 1.2em;
        transition: all 0.2s;
    }
    .submit-review {
        background: linear-gradient(135deg, #F59E0B, #D97706);
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 0.875rem;
        font-weight: 800;
        font-size: 1rem;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 16px rgba(245,158,11,0.35);
    }
    .submit-review:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(245,158,11,0.4);
    }
</style>

<section class="section-sm">
<div class="container">
<div class="row justify-content-center">
<div class="col-md-6 col-lg-5">

                <!-- Breadcrumb -->
<nav class="mb-4" style="font-size:0.85rem;">
<a asp-controller="Booking" asp-action="MyBookings"
                       class="d-inline-flex align-items-center gap-1"
                       style="color:var(--text-muted);text-decoration:none;
                              font-weight:500;">
<svg width="14" height="14" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
<path d="m15 18-6-6 6-6"/>
</svg>
Trở về lịch học
                    </a>
</nav>

                <div class="card"
                     style="border-radius:24px;border:none;
                            box-shadow:var(--shadow-lg);overflow:hidden;">

                    <!-- Header -->
<div style="background:linear-gradient(135deg,#FFF7ED,#FFFBEB);
                                border-bottom:1px solid #FDE68A;
                                padding:2rem;text-align:center;">

                        <div class="avatar avatar-xl mx-auto mb-3"
                             style="background:linear-gradient(135deg,#F59E0B,#D97706);">
@initial
                        </div>

                        <h5 style="font-weight:800;margin-bottom:0.25rem;
                                   color:#92400E;">
@booking.TutorProfile.User.FullName
                        </h5>
<div style="font-size:0.82rem;color:#B45309;font-weight:500;">
@booking.Subject.Name
                            · @booking.StartTime.ToString("dd/MM/yyyy")
                        </div>
</div>

                    <!-- Body -->
<div class="card-body p-4">

                        <form method="post">
@Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId"
                                   value="@booking.Id"/>

                            <!-- Star rating -->
<div class="text-center mb-4">
<div style="font-size:0.78rem;font-weight:700;
                                            color:var(--text-muted);
                                            text-transform:uppercase;
                                            letter-spacing:0.06em;
                                            margin-bottom:1rem;">
Chất lượng buổi học
                                </div>

                                <div class="d-flex justify-content-center gap-2 mb-2"
                                     id="starRow">
@for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="star-btn @(i <= 5 ? "active" : "")"
                                              data-value="@i"></span>
}
                                </div>

                                <div class="rating-label" id="ratingLabel">
Xuất sắc
                                </div>
<input type="hidden" name="rating"
                                       id="ratingInput" value="5"/>
</div>

                            <!-- Comment -->
<div class="mb-4">
<label class="form-label"
                                       style="font-weight:700;font-size:0.8rem;
                                              text-transform:uppercase;
                                              letter-spacing:0.06em;
                                              color:var(--text-muted);">
Nhận xét của bạn
                                    <span style="text-transform:none;
                                                 letter-spacing:0;
                                                 font-weight:400;">
(tuỳ chọn)
                                    </span>
</label>
<textarea name="comment" class="form-control"
                                          rows="4" id="commentArea"
                                          placeholder="Chia sẻ trải nghiệm học của bạn với gia sư này..."
                                          style="border-radius:12px;resize:none;
                                                 border:1.5px solid var(--border);
                                                 padding:0.75rem 1rem;
                                                 font-size:0.9rem;
                                                 line-height:1.6;"></textarea>
<div class="text-end mt-1"
                                     style="font-size:0.75rem;color:var(--text-muted);">
<span id="charCount">0</span>/500
                                </div>
</div>

                            <button type="submit" class="submit-review">
Gửi đánh giá
                            </button>
</form>

                    </div>
</div>

            </div>
</div>
</div>
</section>

@section Scripts {
    <script>
const stars     = document.querySelectorAll('.star-btn');
        const input     = document.getElementById('ratingInput');
        const label     = document.getElementById('ratingLabel');
        const textarea  = document.getElementById('commentArea');
        const charCount = document.getElementById('charCount');

        const labels = {
            1: 'Rất tệ',
            2: 'Chưa tốt',
            3: 'Bình thường',
            4: 'Tốt',
            5: 'Xuất sắc'
        };

        let selected = 5;

        function highlight(val) {
            stars.forEach(s => {
                const v = parseInt(s.dataset.value);
                s.style.color  = v <= val ? '#F59E0B' : '#E2E8F0';
                s.style.transform = v <= val ? 'scale(1.1)' : 'scale(1)';
            });
            label.textContent = labels[val] || '';
            label.style.color = val >= 4 ? '#059669'
                              : val >= 3 ? '#D97706'
                              : '#DC2626';
        }

        highlight(5);

        stars.forEach(star => {
            star.addEventListener('mouseover', () =>
highlight(parseInt(star.dataset.value)));
            star.addEventListener('mouseout',  () =>
highlight(selected));
            star.addEventListener('click', () => {
                selected = parseInt(star.dataset.value);
                input.value = selected;
                highlight(selected);
            });
        });

        // Char counter
        textarea.addEventListener('input', () => {
            const len = textarea.value.length;
            charCount.textContent = len;
            charCount.style.color = len > 450
                ? '#DC2626' : 'var(--text-muted)';
            if (len > 500) textarea.value = textarea.value.slice(0, 500);
        });
    </script>
}