@model IEnumerable<TutorPlatform.Core.Models.TutorAvailability>
@{
    ViewData["Title"] = "Lịch rảnh";
    var days = new[]{
        (DayOfWeek.Monday,    "Thứ 2"),
        (DayOfWeek.Tuesday,   "Thứ 3"),
        (DayOfWeek.Wednesday, "Thứ 4"),
        (DayOfWeek.Thursday,  "Thứ 5"),
        (DayOfWeek.Friday,    "Thứ 6"),
        (DayOfWeek.Saturday,  "Thứ 7"),
        (DayOfWeek.Sunday,    "CN"),
    };
    var grouped = Model.GroupBy(a => a.DayOfWeek)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<style>
    .day-col {
        background: var(--surface);
        border-radius: 16px;
        border: 1px solid var(--border);
        overflow: hidden;
        transition: all 0.2s;
    }
    .day-col:hover { box-shadow: var(--shadow-md); }
    .day-header {
        padding: 0.875rem;
        text-align: center;
        font-weight: 800;
        font-size: 0.85rem;
        border-bottom: 1px solid var(--border);
    }
    .slot-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
        border-radius: 10px;
        margin: 0.4rem 0.5rem;
        background: var(--primary-light);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--primary);
    }
    .slot-del {
        background: none;
        border: none;
        color: var(--danger);
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 6px;
        transition: background 0.15s;
        line-height: 1;
    }
    .slot-del:hover { background: var(--danger-light); }
    .add-slot-btn {
        width: 100%;
        background: none;
        border: 1.5px dashed var(--border);
        border-radius: 10px;
        padding: 0.5rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--text-muted);
        cursor: pointer;
        margin: 0.4rem 0.5rem;
        width: calc(100% - 1rem);
        transition: all 0.2s;
    }
    .add-slot-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: var(--primary-light);
    }
    .modal-input {
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 0.6rem 0.9rem;
        font-size: 0.9rem;
        width: 100%;
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: border-color 0.2s;
    }
    .modal-input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
    }
</style>

<section class="section-sm">
    <div class="container">

        <!-- Header -->
        <div class="d-flex align-items-center
                    justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h4 style="font-weight:800;margin-bottom:0.2rem;">
                    Lịch rảnh của tôi
                </h4>
                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                    Thiết lập khung giờ bạn có thể dạy học
                </p>
            </div>
            <button class="btn btn-primary"
                    style="border-radius:10px;font-weight:700;"
                    onclick="openAddModal(null)">
                <svg width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="2.5" viewBox="0 0 24 24" class="me-1">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm khung giờ
            </button>
        </div>

        <!-- ===== WEEKLY CALENDAR ===== -->
        <div class="row g-2 mb-4">
            @foreach (var (dow, name) in days)
            {
                var slots = grouped.GetValueOrDefault(dow,
                    new List<TutorPlatform.Core.Models.TutorAvailability>());
                var hasSlots = slots.Any();

                <div class="col day-col"
                     style="min-width:120px;">
                    <div class="day-header"
                         style="background:@(hasSlots ? "var(--primary-light)" : "var(--bg)");
                                color:@(hasSlots ? "var(--primary)" : "var(--text-muted)");">
                        @name
                        @if (hasSlots)
                        {
                            <div style="font-size:0.68rem;font-weight:600;
                                        color:var(--primary);margin-top:2px;">
                                @slots.Count slot
                            </div>
                        }
                    </div>

                    <div class="py-2">
                        @if (!slots.Any())
                        {
                            <div class="text-center py-3"
                                 style="font-size:0.75rem;
                                        color:var(--text-muted);">
                                Trống
                            </div>
                        }
                        else
                        {
                            @foreach (var slot in slots.OrderBy(s => s.StartTime))
                            {
                                <div class="slot-item">
                                    <span>
                                        @slot.StartTime.ToString(@"hh\:mm")
                                        –
                                        @slot.EndTime.ToString(@"hh\:mm")
                                    </span>
                                    <form asp-action="DeleteAvailability"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id"
                                               value="@slot.Id"/>
                                        <button type="submit" class="slot-del"
                                                title="Xoá"
                                                onclick="return confirm('Xoá khung giờ này?')">
                                            ×
                                        </button>
                                    </form>
                                </div>
                            }
                        }

                        <button class="add-slot-btn"
                                onclick="openAddModal('@((int)dow)')">
                            + Thêm
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Summary -->
        <div class="card"
             style="border-radius:16px;border:none;
                    box-shadow:var(--shadow-sm);
                    background:linear-gradient(135deg,
                    var(--primary-light),#F0FDF4);">
            <div class="card-body p-4">
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div style="font-weight:800;font-size:1.5rem;
                                    color:var(--primary);">
                            @Model.Count()
                        </div>
                        <div style="font-size:0.78rem;color:var(--text-muted);
                                    font-weight:600;">
                            Tổng slot
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="font-weight:800;font-size:1.5rem;
                                    color:#059669;">
                            @grouped.Count
                        </div>
                        <div style="font-size:0.78rem;color:var(--text-muted);
                                    font-weight:600;">
                            Ngày trong tuần
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="font-weight:800;font-size:1.5rem;
                                    color:#7C3AED;">
                            @(Model.Any()
                                ? Math.Round(Model.Average(a =>
                                    (a.EndTime - a.StartTime).TotalHours), 1)
                                    .ToString("F1") + "h"
                                : "0h")
                        </div>
                        <div style="font-size:0.78rem;color:var(--text-muted);
                                    font-weight:600;">
                            TB/slot
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ===== ADD MODAL ===== -->
<div id="addModal"
     style="display:none;position:fixed;inset:0;z-index:9999;
            background:rgba(15,23,42,0.5);backdrop-filter:blur(4px);
            align-items:center;justify-content:center;">
    <div style="background:var(--surface);border-radius:24px;padding:2rem;
                width:100%;max-width:400px;margin:1rem;
                box-shadow:0 24px 64px rgba(0,0,0,0.2);">

        <div class="d-flex align-items-center
                    justify-content-between mb-4">
            <h5 style="font-weight:800;margin:0;">
                Thêm khung giờ rảnh
            </h5>
            <button onclick="closeAddModal()"
                    style="background:var(--bg);border:none;
                           width:36px;height:36px;border-radius:10px;
                           cursor:pointer;font-size:1.2rem;
                           color:var(--text-muted);">
                ×
            </button>
        </div>

        <form asp-action="AddAvailability" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Ngày trong tuần</label>
                <select name="dayOfWeek" id="modalDay" class="modal-input">
                    @foreach (var (dow, name) in days)
                    {
                        <option value="@((int)dow)">@name</option>
                    }
                </select>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <label class="form-label">Bắt đầu</label>
                    <input type="time" name="startTime"
                           class="modal-input" value="08:00" required/>
                </div>
                <div class="col-6">
                    <label class="form-label">Kết thúc</label>
                    <input type="time" name="endTime"
                           class="modal-input" value="10:00" required/>
                </div>
            </div>

            <button type="submit"
                    style="width:100%;background:linear-gradient(
                           135deg,var(--primary),#3B82F6);
                           color:#fff;border:none;border-radius:14px;
                           padding:0.875rem;font-weight:800;
                           font-size:0.95rem;cursor:pointer;
                           box-shadow:0 4px 16px rgba(37,99,235,0.3);
                           transition:all 0.2s;"
                    onmouseover="this.style.transform='translateY(-2px)'"
                    onmouseout="this.style.transform=''">
                <svg width="17" height="17" fill="none" stroke="currentColor"
                     stroke-width="2.5" viewBox="0 0 24 24"
                     style="margin-right:6px;">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                Lưu khung giờ
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal(dow) {
            const modal = document.getElementById('addModal');
            modal.style.display = 'flex';
            if (dow !== null) {
                document.getElementById('modalDay').value = dow;
            }
            document.body.style.overflow = 'hidden';
        }
        function closeAddModal() {
            document.getElementById('addModal').style.display = 'none';
            document.body.style.overflow = '';
        }
        // Close on backdrop click
        document.getElementById('addModal')
            .addEventListener('click', function(e) {
                if (e.target === this) closeAddModal();
            });
        // Close on Escape
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeAddModal();
        });
    </script>
}