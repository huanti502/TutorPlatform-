@{
    ViewData["Title"] = "Chờ xét duyệt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pending-card {
        max-width: 560px;
        margin: 4rem auto;
        background: var(--surface);
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        padding: 3rem 2.5rem;
        text-align: center;
    }

    .pending-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #FFF7ED;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        text-align: left;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border);
    }

        .step-item:last-child {
            border-bottom: none;
        }

    .step-num {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
    }
</style>

<section class="section-sm">
    <div class="container">
        <div class="pending-card">

            <div class="pending-icon">
                <svg width="36" height="36" fill="none" stroke="#D97706"
                     stroke-width="1.8" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>

            <h4 style="font-weight:800;margin-bottom:0.5rem;">
                Hồ sơ đang chờ xét duyệt
            </h4>
            <p style="color:var(--text-muted);font-size:0.95rem;margin-bottom:2rem;line-height:1.7;">
                Cảm ơn bạn đã đăng ký làm gia sư trên <strong>Gia Sư Việt</strong>!
                Đội ngũ Admin đang xem xét hồ sơ của bạn và sẽ thông báo kết quả
                qua mục <a href="/Account/Notifications">Thông báo</a> sớm nhất có thể.
            </p>

            <div class="mb-3" style="background:var(--bg);border-radius:14px;padding:1.25rem 1.5rem;">
                <p style="font-weight:700;font-size:0.85rem;
                    text-transform:uppercase;letter-spacing:0.06em;
                    color:var(--text-muted);margin-bottom:1rem;">
                    Quy trình xét duyệt
                </p>
                <div class="step-item">
                    <div class="step-num">✓</div>
                    <div>
                        <div style="font-weight:700;font-size:0.9rem;">Nộp hồ sơ</div>
                        <div style="font-size:0.82rem;color:var(--text-muted);">
                            Hồ sơ, ảnh xác minh và bằng cấp đã được gửi thành công
                        </div>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num" style="background:#D97706;">2</div>
                    <div>
                        <div style="font-weight:700;font-size:0.9rem;">Admin xem xét</div>
                        <div style="font-size:0.82rem;color:var(--text-muted);">
                            Đang trong quá trình kiểm duyệt (thường 1–2 ngày làm việc)
                        </div>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num" style="background:#9CA3AF;">3</div>
                    <div>
                        <div style="font-weight:700;font-size:0.9rem;">Kích hoạt tài khoản</div>
                        <div style="font-size:0.82rem;color:var(--text-muted);">
                            Sau khi duyệt, bạn có thể nhận học viên và sử dụng đầy đủ tính năng
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                <a href="/" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;">
                    ← Về trang chủ
                </a>
                <a href="/Account/Notifications" class="btn btn-primary btn-sm" style="border-radius:10px;">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg> Xem thông báo
                </a>
            </div>

        </div>
    </div>
</section>