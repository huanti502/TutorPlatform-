@model TutorPlatform.Core.Models.TutorProfile
@{
    ViewData["Title"] = "Dashboard";
    var totalBookings = (int)(ViewBag.TotalBookings ?? 0);
    var confirmedCount = (int)(ViewBag.ConfirmedCount ?? 0);
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var avgRating = (double)(ViewBag.AvgRating ?? 0.0);
    var totalReviews = (int)(ViewBag.TotalReviews ?? 0);
    var recentBookings = ViewBag.RecentBookings as
        IEnumerable<TutorPlatform.Core.Models.Booking>
        ?? Enumerable.Empty<TutorPlatform.Core.Models.Booking>();

    // Sử dụng trực tiếp Model đã được định nghĩa ở trên
    var profile = Model;

    var statusMap = new Dictionary<string, (string bg, string color, string label)>{
        {"Pending",   ("var(--warning-light)","#D97706","Chờ duyệt")},
        {"Confirmed", ("var(--success-light)","#059669","Xác nhận")},
        {"Cancelled", ("var(--danger-light)","var(--danger)","Đã huỷ")},
        {"Rejected",  ("var(--danger-light)","var(--danger)","Từ chối")},
        {"Completed", ("var(--primary-light)","var(--primary)","Hoàn thành")},
    };
}

<style>
    .dash-stat {
        background: var(--surface);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

        .dash-stat:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(79,70,229,0.2);
        }

        .dash-stat .val {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.04em;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .dash-stat .lbl {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-top: 4px;
        }

        .dash-stat .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

    .trend-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2em 0.6em;
        border-radius: 100px;
    }

    /* MỚI: Badge gamification */
    .badge-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
        color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,.15);
        transition: transform .2s;
        cursor: default;
    }

        .badge-chip:hover {
            transform: translateY(-2px);
        }

    /* MỚI: Chart container */
    .chart-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem;
    }

    /* Action buttons trong bảng */
    .action-btn {
        padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: opacity .2s;
    }

        .action-btn:hover {
            opacity: .85;
        }
</style>

<section class="section-sm">
    <div class="container">

        @* ===== PAGE HEADER ===== *@
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h4 style="font-weight:800;margin-bottom:0.2rem;">Dashboard gia sư</h4>
                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                    Tổng quan hoạt động giảng dạy của bạn
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Availability" class="btn btn-outline-primary btn-sm"
                   style="border-radius:10px;font-weight:600;">
                    <svg width="14" height="14" fill="none" stroke="currentColor"
                         stroke-width="2" viewBox="0 0 24 24" class="me-1">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 6v6l4 2" />
                    </svg>
                    Lịch rảnh
                </a>
                <a asp-action="Profile" class="btn btn-primary btn-sm"
                   style="border-radius:10px;font-weight:600;">
                    <svg width="14" height="14" fill="none" stroke="currentColor"
                         stroke-width="2" viewBox="0 0 24 24" class="me-1">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z" />
                    </svg>
                    Sửa hồ sơ
                </a>
            </div>
        </div>

        @* ===== STAT CARDS ===== *@
        <div class="row g-3 mb-4">

            <div class="col-6 col-lg-3">
                <div class="dash-stat" style="border-top:3px solid #1E40AF;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="icon-box" style="background:var(--primary-light);">
                            <svg width="22" height="22" fill="none" stroke="#1E40AF"
                                 stroke-width="1.8" viewBox="0 0 24 24">
                                <line x1="12" y1="1" x2="12" y2="23" />
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                            </svg>
                        </div>
                        <span class="trend-badge" style="background:var(--primary-light);color:var(--primary);">VND</span>
                    </div>
                    <div class="val" style="color:#1E40AF;">
                        @(totalRevenue >= 1000000
                            ? $"{totalRevenue / 1000000:F1}M"
                            : $"{totalRevenue:N0}")
                    </div>
                    <div class="lbl">Doanh thu</div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="dash-stat" style="border-top:3px solid #7C3AED;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="icon-box" style="background:#F5F3FF;">
                            <svg width="22" height="22" fill="none" stroke="#7C3AED"
                                 stroke-width="1.8" viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                        </div>
                        <span class="trend-badge" style="background:#F5F3FF;color:#7C3AED;">Tổng</span>
                    </div>
                    <div class="val" style="color:#7C3AED;">@totalBookings</div>
                    <div class="lbl">Booking</div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="dash-stat" style="border-top:3px solid #059669;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="icon-box" style="background:#F0FDF4;">
                            <svg width="22" height="22" fill="none" stroke="#059669"
                                 stroke-width="1.8" viewBox="0 0 24 24">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        </div>
                        <span class="trend-badge" style="background:#F0FDF4;color:#059669;">↑</span>
                    </div>
                    <div class="val" style="color:#059669;">@confirmedCount</div>
                    <div class="lbl">Đã xác nhận</div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="dash-stat" style="border-top:3px solid #D97706;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="icon-box" style="background:#FFF7ED;">
                            <svg width="22" height="22" fill="none" stroke="#D97706"
                                 stroke-width="1.8" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 6v6l4 2" />
                            </svg>
                        </div>
                        @if (pendingCount > 0)
                        {
                            <span class="trend-badge" style="background:var(--warning-light);color:#D97706;">Mới!</span>
                        }
                    </div>
                    <div class="val" style="color:#D97706;">@pendingCount</div>
                    <div class="lbl">Chờ duyệt</div>
                </div>
            </div>
        </div>

        @* ===== HÀNG 2: BIỂU ĐỒ + HUY HIỆU (MỚI) ===== *@
        <div class="row g-3 mb-3">

            @* Biểu đồ doanh thu 6 tháng *@
            <div class="col-lg-7">
                <div class="chart-card h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 style="font-weight:700;font-size:0.78rem;text-transform:uppercase;
                            letter-spacing:0.06em;color:var(--text-muted);margin:0;">
                            📈 Doanh thu 6 tháng gần nhất
                        </h6>
                        <span style="font-size:0.75rem;color:var(--text-muted);">VNĐ</span>
                    </div>
                    <canvas id="revenueChart" height="160"></canvas>
                </div>
            </div>

            @* Huy hiệu Gamification *@
            <div class="col-lg-5">
                <div class="chart-card h-100">
                    <h6 style="font-weight:700;font-size:0.78rem;text-transform:uppercase;
                        letter-spacing:0.06em;color:var(--text-muted);margin-bottom:1rem;">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> Huy hiệu của bạn
                        @if (profile?.TutorBadges?.Any() == true)
                        {
                            <span class="trend-badge ms-1"
                                  style="background:var(--warning-light);color:#D97706;">
                                @profile.TutorBadges.Count
                            </span>
                        }
                    </h6>

                    @if (profile?.TutorBadges?.Any() == true)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tb in profile.TutorBadges.OrderByDescending(t => t.EarnedAt))
                            {
                                <div class="badge-chip"
                                     style="background:@tb.Badge?.Color"
                                     title="@tb.Badge?.Description&#10;Đạt: @tb.EarnedAt.ToString("dd/MM/yyyy")">
                                    <span style="font-size:1rem">@tb.Badge?.Icon</span>
                                    <span>@tb.Badge?.Name</span>
                                </div>
                            }
                        </div>
                        <p style="font-size:0.75rem;color:var(--text-muted);margin-top:0.75rem;margin-bottom:0">
                            Di chuột vào huy hiệu để xem mô tả chi tiết
                        </p>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <div style="font-size:3rem;opacity:.3">🏅</div>
                            <p style="font-size:0.82rem;color:var(--text-muted);margin:0.5rem 0 0">
                                Chưa có huy hiệu.<br />
                                Hoàn thành buổi học đầu tiên để nhận!
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ===== HÀNG 3: BOOKING GẦN ĐÂY + RATING + QUICK LINKS ===== *@
        <div class="row g-3">

            @* Booking gần đây *@
            <div class="col-lg-8">
                <div class="card h-100"
                     style="border-radius:var(--radius-xl);border:none;box-shadow:var(--shadow-sm);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 style="font-weight:700;font-size:0.78rem;text-transform:uppercase;
                                letter-spacing:0.06em;color:var(--text-muted);margin:0;">
                                Booking gần đây
                            </h6>
                            <a asp-controller="Booking" asp-action="TutorRequests"
                               style="font-size:0.8rem;font-weight:700;color:var(--primary);">
                                Xem tất cả →
                            </a>
                        </div>

                        @if (!recentBookings.Any())
                        {
                            <div class="text-center py-4">
                                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                                    Chưa có booking nào
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0" style="font-size:0.84rem;">
                                    <thead>
                                        <tr>
                                            <th>Học viên</th>
                                            <th>Môn</th>
                                            <th>Thời gian</th>
                                            <th>Trạng thái</th>
                                            <th>Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var b in recentBookings)
                                        {
                                            var stuInit = b.Student?.FullName
                                                ?.FirstOrDefault().ToString().ToUpper() ?? "?";
                                            var (sbg, sc, sl) = statusMap
                                                .GetValueOrDefault(b.Status,
                                                ("#F1F5F9", "#64748B", b.Status));
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="avatar avatar-sm"
                                                             style="width:30px;height:30px;font-size:11px;">
                                                            @stuInit
                                                        </div>
                                                        <span style="font-weight:600;">
                                                            @b.Student?.FullName
                                                        </span>
                                                    </div>
                                                </td>
                                                <td style="color:var(--text-secondary);">
                                                    @b.Subject?.Name
                                                </td>
                                                <td style="color:var(--text-muted);">
                                                    @b.StartTime.ToString("HH:mm dd/MM")
                                                </td>
                                                <td>
                                                    <span class="badge"
                                                          style="background:@sbg;color:@sc;">
                                                        @sl
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (b.Status == "Pending")
                                                    {
                                                        <form method="post"
                                                              asp-controller="Booking"
                                                              asp-action="UpdateStatus"
                                                              class="d-inline">
                                                            <input type="hidden" name="id" value="@b.Id" />
                                                            <button name="status" value="Confirmed"
                                                                    class="action-btn"
                                                                    style="background:#F0FDF4;color:#059669;">
                                                                ✓ Xác nhận
                                                            </button>
                                                            <button name="status" value="Rejected"
                                                                    class="action-btn ms-1"
                                                                    style="background:#FEF2F2;color:#DC2626;">
                                                                ✗
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (b.Status == "Confirmed")
                                                    {
                                                        <form method="post"
                                                              asp-controller="Booking"
                                                              asp-action="Complete"
                                                              class="d-inline">
                                                            <input type="hidden" name="id" value="@b.Id" />
                                                            <button class="action-btn"
                                                                    style="background:var(--primary-light);color:var(--primary);">
                                                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Hoàn thành
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span style="color:var(--text-muted);
                                                        font-size:0.75rem;">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Rating + Quick Links *@
            <div class="col-lg-4">

                @* Rating card *@
                <div class="card mb-3"
                     style="border-radius:var(--radius-xl);border:none;box-shadow:var(--shadow-sm);
                    background:linear-gradient(135deg,#FFF7ED 0%,#FFFBEB 100%);
                    border:1px solid #FDE68A;">
                    <div class="card-body p-4 text-center">
                        <div style="font-size:3rem;font-weight:800;color:#D97706;
                            line-height:1;letter-spacing:-2px;">
                            @avgRating.ToString("F1")
                        </div>
                        <div class="my-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span style="color:@(i <= Math.Round(avgRating)
                                                                                        ? "#F59E0B" : "#E2E8F0");font-size:1.3rem;">★</span>
                        }
                    </div>
                    <div style="font-size:0.82rem;color:#92400E;font-weight:600;">
                        @totalReviews đánh giá
                    </div>
                </div>
            </div>

            @* Quick links *@
            <div class="card"
                 style="border-radius:var(--radius-xl);border:none;box-shadow:var(--shadow-sm);">
                <div class="card-body p-3">
                    <h6 style="font-weight:700;font-size:0.78rem;text-transform:uppercase;
                        letter-spacing:0.06em;color:var(--text-muted);
                        margin-bottom:0.75rem;">
                        Truy cập nhanh
                    </h6>
                    @foreach (var (href, lbl, icon, bg, color) in new[]{
                            ("/Booking/TutorRequests","Yêu cầu học",
                             "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 15a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 4.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 11a16 16 0 0 0 5.91 5.91l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z",
                             "var(--primary-light)","var(--primary)"),
                            ("/Tutor/Availability","Cập nhật lịch rảnh",
                             "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
                             "#F0FDF4","#059669"),
                            ("/Booking/Calendar","Xem lịch học",
                             "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
                             "#F5F3FF","#7C3AED"),
                            ("/Tutor/Profile","Chỉnh sửa hồ sơ",
                             "M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z",
                             "#FDF2F8","#EC4899"),
                            ("/Document/Index","Tài liệu học tập",
                             "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
                             "#ECFDF5","#059669"),
                            ("/Blog/Create","Viết bài blog",
                             "M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z",
                             "#FFF7ED","#D97706"),
                        })
                    {
                        <a href="@href"
                           class="d-flex align-items-center gap-3 p-2 rounded-3 text-decoration-none mb-1"
                           style="transition:all 0.18s;"
                           onmouseover="this.style.background='var(--bg)'"
                           onmouseout="this.style.background='transparent'">
                            <div style="width:34px;height:34px;border-radius:10px;
                                background:@bg;flex-shrink:0;display:flex;
                                align-items:center;justify-content:center;">
                                <svg width="16" height="16" fill="none"
                                     stroke="@color" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path d="@icon" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <span style="font-size:0.85rem;font-weight:600;
                            color:var(--text-secondary);">@lbl</span>
                            <svg class="ms-auto" width="14" height="14"
                                 fill="none" stroke="var(--text-muted)"
                                 stroke-width="2" viewBox="0 0 24 24">
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // ===== COUNT-UP ANIMATION =====
        document.querySelectorAll('.val').forEach(el => {
        const raw = el.textContent.trim();
        const isM = raw.includes('M');
        const target = parseFloat(raw.replace(/[^0-9.]/g, '')) || 0;
        if (target === 0) return;
        let start = 0;
        const duration = 1200;
        const step = ts => {
        if (!start) start = ts;
        const ease = 1 - Math.pow(1 - Math.min((ts - start) / duration, 1), 3);
        el.textContent = isM
        ? (ease * target).toFixed(1) + 'M'
        : Math.floor(ease * target).toLocaleString('vi-VN');
        if (ease < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        });

        // ===== BIỂU ĐỒ DOANH THU =====
        @if (ViewBag.RevenueChart != null)
        {
            <text>
                const chartData = @Html.Raw(ViewBag.RevenueChart);
                const ctx = document.getElementById("revenueChart");
                if (ctx) {
                new Chart(ctx, {
                type: "bar",
                data: {
                labels: chartData.map(d => d.label),
                datasets: [{
                label: "Doanh thu (VNĐ)",
                data: chartData.map(d => d.revenue),
                backgroundColor: chartData.map((_, i) =>
                i === chartData.length - 1
                ? "rgba(30,64,175,.85)"
                : "rgba(30,64,175,.25)"
                ),
                borderRadius: 10,
                borderSkipped: false,
                hoverBackgroundColor: "rgba(30,64,175,.9)"
                }]
                },
                options: {
                responsive: true,
                plugins: {
                legend: { display: false },
                tooltip: {
                callbacks: {
                label: ctx => " " + ctx.raw.toLocaleString("vi-VN") + " VNĐ"
                }
                }
                },
                scales: {
                y: {
                beginAtZero: true,
                grid: { color: "rgba(0,0,0,.04)" },
                ticks: {
                font: { size: 11 },
                callback: v => v >= 1000000
                ? (v / 1000000).toFixed(1) + "M"
                : v.toLocaleString("vi-VN")
                }
                },
                x: {
                grid: { display: false },
                ticks: { font: { size: 11 } }
                }
                }
                }
                });
                }
            </text>
        }
    </script>
}