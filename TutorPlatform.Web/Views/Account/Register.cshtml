@model TutorPlatform.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div style="min-height:calc(100vh - 130px);background:var(--bg);padding:2.5rem 0;">
    <div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-5">
                <div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                     style="width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),#7C3AED);box-shadow:var(--shadow-primary);">
                    <svg width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                        <path d="M6 10L14 6L22 10V14C22 18.4 18.4 21.6 14 22C9.6 21.6 6 18.4 6 14V10Z" fill="white"/>
                        <path d="M10 14L13 17L18 12" stroke="var(--primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h4 style="font-weight:800;margin-bottom:0.3rem;letter-spacing:-0.03em;">Tạo tài khoản</h4>
                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">Miễn phí — bắt đầu ngay hôm nay</p>
            </div>

            <!-- Chọn loại tài khoản -->
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <div id="btnStudent" onclick="selectRole('Student')"
                         class="card text-center p-3 role-btn active-role" style="cursor:pointer;border:2px solid #2563EB;">
                        <div class="fs-4"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> </div>
                        <div class="fw-semibold text-primary">Học viên</div>
                    </div>
                </div>
                <div class="col-6">
                    <div id="btnTutor" onclick="selectRole('Tutor')"
                         class="card text-center p-3 role-btn" style="cursor:pointer;border:2px solid #e5e7eb;">
                        <div class="fs-4">🖥️</div>
                        <div class="fw-semibold text-muted">Gia sư</div>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0 p-4">
                <!-- Thêm enctype="multipart/form-data" để upload file -->
                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <!-- Role hidden input -->
                    <input type="hidden" asp-for="Role" id="roleInput" value="Student" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control form-control-lg"
                               placeholder="Nguyễn Văn A" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg"
                               placeholder="example@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg"
                               placeholder="0901234567" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg"
                                   placeholder="••••••••" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Xác nhận</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg"
                                   placeholder="••••••••" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- ===== PHẦN MỞ RỘNG DÀNH CHO GIA SƯ ===== -->
                    <!-- Sẽ được ẩn mặc định, chỉ hiện khi chọn Gia Sư -->
                    <div id="tutorFields" style="display: none;" class="mt-4 pt-3 border-top">
                        <h5 class="fw-bold mb-3 text-primary">Thông tin xét duyệt Gia sư</h5>

                        @* Avatar *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                🖼️ Ảnh đại diện <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="avatarFile" id="avatarFile" class="form-control tutor-req"
                                   accept="image/*" onchange="previewAvatar(this)" />
                            <div id="avatarPreview" class="mt-2"></div>
                            <small class="text-muted">Ảnh rõ mặt, nền sáng. Định dạng JPG/PNG, tối đa 5MB.</small>
                        </div>

                        @* Ảnh khuôn mặt xác minh danh tính *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                🤳 Ảnh xác minh danh tính <span class="text-danger">*</span>
                            </label>
                            <div class="alert alert-info py-2 px-3 small mb-2">
                                📋 Yêu cầu: Chụp ảnh bạn đang cầm CMND/CCCD cạnh mặt.
                                Ảnh này chỉ dùng để xác minh bảo mật, không hiển thị công khai.
                            </div>
                            <input type="file" name="facePhotoFile" id="facePhotoFile" class="form-control tutor-req"
                                   accept="image/*" />
                            <small class="text-muted">JPG/PNG, tối đa 10MB.</small>
                        </div>

                        @* Bằng cấp / Chứng chỉ *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> Bằng cấp / Chứng chỉ <span class="text-danger">*</span>
                            </label>
                            <div class="alert alert-warning py-2 px-3 small mb-2">
                                ⚠️ Bắt buộc upload ít nhất 1 bằng cấp hoặc chứng chỉ liên quan
                                đến môn học bạn muốn dạy.
                            </div>
                            <div id="certList">
                                <div class="cert-item d-flex gap-2 mb-2">
                                    <input type="text" name="certTitles" class="form-control tutor-req"
                                           placeholder="Tên bằng cấp (VD: Đại học Sư phạm Toán)" />
                                    <input type="file" name="certFiles" class="form-control tutor-req"
                                           accept="image/*,.pdf" style="max-width:200px" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-1"
                                    onclick="addCertRow()">
                                ➕ Thêm bằng cấp khác
                            </button>
                        </div>
                    </div>
                    <!-- ===== KẾT THÚC PHẦN GIA SƯ ===== -->

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-2 fw-bold fs-5">
                        Tạo tài khoản →
                    </button>
                </form>
            </div>

            <p class="text-center mt-3 text-muted">
                Đã có tài khoản?
                <a asp-action="Login" class="text-primary fw-semibold">Đăng nhập miễn phí</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectRole(role) {
            document.getElementById('roleInput').value = role;

            const btnStudent = document.getElementById('btnStudent');
            const btnTutor = document.getElementById('btnTutor');
            const tutorFields = document.getElementById('tutorFields');

            // Các input bắt buộc nếu chọn Gia sư
            const tutorReqInputs = document.querySelectorAll('.tutor-req');

            if (role === 'Student') {
                btnStudent.style.borderColor = '#2563EB';
                btnStudent.querySelector('.fw-semibold').classList.replace('text-muted', 'text-primary');
                btnTutor.style.borderColor = '#e5e7eb';
                btnTutor.querySelector('.fw-semibold').classList.replace('text-primary', 'text-muted');

                // Ẩn form upload và bỏ tính bắt buộc
                tutorFields.style.display = 'none';
                tutorReqInputs.forEach(el => el.removeAttribute('required'));
            } else {
                btnTutor.style.borderColor = '#2563EB';
                btnTutor.querySelector('.fw-semibold').classList.replace('text-muted', 'text-primary');
                btnStudent.style.borderColor = '#e5e7eb';
                btnStudent.querySelector('.fw-semibold').classList.replace('text-primary', 'text-muted');

                // Hiện form upload và yêu cầu bắt buộc nhập
                tutorFields.style.display = 'block';
                tutorReqInputs.forEach(el => el.setAttribute('required', 'required'));
            }
        }

        function previewAvatar(input) {
            const preview = document.getElementById('avatarPreview');
            preview.innerHTML = '';
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = '100px';
                    img.style.height = '100px';
                    img.style.objectFit = 'cover';
                    img.className = 'rounded-circle border border-2';
                    preview.appendChild(img);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function addCertRow() {
            const certList = document.getElementById('certList');
            const row = document.createElement('div');
            row.className = 'cert-item d-flex gap-2 mb-2';
            row.innerHTML = `
                        <input type="text" name="certTitles" class="form-control" placeholder="Tên bằng cấp (VD: IELTS 7.0)"/>
                        <input type="file" name="certFiles" class="form-control" accept="image/*,.pdf" style="max-width:200px"/>
                        <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()" title="Xóa dòng này"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> </button>
                    `;
            certList.appendChild(row);
        }
    </script>
}