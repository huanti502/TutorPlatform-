@{
    ViewData["Title"] = "Mã khôi phục";
    var codes = ViewBag.RecoveryCodes as string[] ?? Array.Empty<string>();
}

<div class="container py-4" style="max-width:560px;">
    <h3 class="mb-2">✅ Đã bật xác thực 2 lớp</h3>
    <div class="alert alert-warning">
        <b>Hãy lưu lại các mã khôi phục sau.</b> Nếu mất điện thoại, bạn dùng một trong các mã này để đăng nhập.
        Mỗi mã chỉ dùng được một lần.
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row">
                @foreach (var c in codes)
                {
                    <div class="col-6 mb-2"><code style="font-size:1rem;">@c</code></div>
                }
            </div>
        </div>
    </div>

    <a asp-action="TwoFactorAuthentication" class="btn text-white fw-bold" style="background:#7c3aed;border:none;">Hoàn tất</a>
</div>
