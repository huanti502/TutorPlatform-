@model IEnumerable<TutorPlatform.Core.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    var unread = Model.Count(n => !n.IsRead);
    var groups = Model
        .OrderByDescending(n => n.CreatedAt)
        .GroupBy(n => n.CreatedAt.ToLocalTime().Date)
        .ToList();
}

<style>
    .notif-item {
        transition: all 0.18s ease;
        cursor: pointer;
        border-left: 3px solid transparent;
    }

        .notif-item.unread {
            border-left-color: var(--primary);
            background: var(--primary-light) !important;
        }

        .notif-item:hover {
            background: var(--bg) !important;
            transform: translateX(3px);
        }

        .notif-item.unread:hover {
            background: #DBEAFE !important;
        }

    .notif-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .date-group-label {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 0.75rem 1.25rem 0.4rem;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }

    .unread-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--primary);
        flex-shrink: 0;
    }

    .mark-all-btn {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary);
        background: var(--primary-light);
        border: none;
        border-radius: 8px;
        padding: 0.4rem 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .mark-all-btn:hover {
            background: var(--primary);
            color: #fff;
        }
</style>

<section class="section-sm">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 style="font-weight:800;margin-bottom:0.2rem;">
                            Thông báo
                            @if (unread > 0)
                            {
                                <span style="background:var(--primary);color:#fff;font-size:0.72rem;
                                    font-weight:800;padding:0.2em 0.6em;
                                    border-radius:100px;margin-left:6px;vertical-align:middle;">
                                    @unread
                                </span>
                            }
                        </h4>
                        <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                            @if (unread > 0)
                            {
                                <span>@unread thông báo chưa đọc</span>
                            }
                            else
                            {
                                <span>Tất cả đã đọc</span>
                            }
                        </p>
                    </div>
                    @if (unread > 0)
                    {
                        <form asp-action="MarkAllRead" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mark-all-btn">
                                <svg width="13" height="13" fill="none" stroke="currentColor"
                                     stroke-width="2.5" viewBox="0 0 24 24" class="me-1">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                Đọc tất cả
                            </button>
                        </form>
                    }
                </div>

                <div class="card" style="border-radius:20px;border:none;box-shadow:var(--shadow-md);overflow:hidden;">

                    @if (!Model.Any())
                    {
                        <div class="p-5 text-center">
                            <div style="width:64px;height:64px;border-radius:18px;
                                background:var(--primary-light);display:flex;
                                align-items:center;justify-content:center;margin:0 auto 1rem;">
                                <svg width="28" height="28" fill="none" stroke="var(--primary)"
                                     stroke-width="1.5" viewBox="0 0 24 24">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                </svg>
                            </div>
                            <h6 style="font-weight:700;margin-bottom:0.4rem;">Không có thông báo nào</h6>
                            <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                                Các thông báo về lịch học và tin nhắn sẽ xuất hiện ở đây
                            </p>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in groups)
                        {
                            <div class="date-group-label">
                                @{
                                    var today = DateTime.Today;
                                    var diff = (today - group.Key).Days;
                                    var dateLabel = diff == 0 ? "Hôm nay"
                                        : diff == 1 ? "Hôm qua"
                                        : group.Key.ToString("dd/MM/yyyy");
                                }
                                @dateLabel
                            </div>

                            @foreach (var n in group)
                            {
                                var iconBg = "#EFF6FF";
                                var iconColor = "#2563EB";
                                var iconPath = "M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0";

                                if (n.Title.Contains("xác nhận") || n.Title.Contains("Confirmed"))
                                {
                                    iconBg = "#F0FDF4"; iconColor = "#059669";
                                    iconPath = "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3";
                                }
                                else if (n.Title.Contains("từ chối") || n.Title.Contains("Rejected"))
                                {
                                    iconBg = "#FEF2F2"; iconColor = "#DC2626";
                                    iconPath = "M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z";
                                }
                                else if (n.Title.Contains("nhắn") || n.Title.Contains("Message"))
                                {
                                    iconBg = "#F5F3FF"; iconColor = "#7C3AED";
                                    iconPath = "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z";
                                }
                                else if (n.Title.Contains("lịch") || n.Title.Contains("Booking"))
                                {
                                    iconBg = "#FFF7ED"; iconColor = "#D97706";
                                    iconPath = "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z";
                                }

                                <div class="notif-item @(!n.IsRead ? "unread" : "")"
                                     style="padding:1rem 1.25rem;background:var(--surface);">

                                    @if (!string.IsNullOrEmpty(n.Link))
                                    {
                                        <a href="@n.Link" class="d-flex align-items-start gap-3 text-decoration-none">
                                            <div class="notif-icon" style="background:@iconBg;">
                                                <svg width="18" height="18" fill="none" stroke="@iconColor"
                                                     stroke-width="2" viewBox="0 0 24 24">
                                                    <path d="@iconPath" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <span style="font-weight:700;font-size:0.875rem;color:var(--text-primary);">
                                                        @n.Title
                                                    </span>
                                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                        <span style="font-size:0.72rem;color:var(--text-muted);white-space:nowrap;">
                                                            @n.CreatedAt.ToLocalTime().ToString("HH:mm")
                                                        </span>
                                                        @if (!n.IsRead)
                                                        {
                                                            <div class="unread-dot"></div>
                                                        }
                                                    </div>
                                                </div>
                                                <p style="margin:0.25rem 0 0;font-size:0.82rem;color:var(--text-secondary);line-height:1.5;">
                                                    @n.Content
                                                </p>
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="notif-icon" style="background:@iconBg;">
                                                <svg width="18" height="18" fill="none" stroke="@iconColor"
                                                     stroke-width="2" viewBox="0 0 24 24">
                                                    <path d="@iconPath" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <span style="font-weight:700;font-size:0.875rem;color:var(--text-primary);">
                                                        @n.Title
                                                    </span>
                                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                        <span style="font-size:0.72rem;color:var(--text-muted);white-space:nowrap;">
                                                            @n.CreatedAt.ToLocalTime().ToString("HH:mm")
                                                        </span>
                                                        @if (!n.IsRead)
                                                        {
                                                            <div class="unread-dot"></div>
                                                        }
                                                    </div>
                                                </div>
                                                <p style="margin:0.25rem 0 0;font-size:0.82rem;color:var(--text-secondary);line-height:1.5;">
                                                    @n.Content
                                                </p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>

            </div>
        </div>
    </div>
</section>