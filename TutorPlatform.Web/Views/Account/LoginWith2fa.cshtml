@model TutorPlatform.Web.ViewModels.TwoFactorLoginViewModel
@{
    ViewData["Title"] = "Xác thực 2 lớp";
    var rememberMe = (bool)(ViewBag.RememberMe ?? false);
}

<div class="container py-5" style="max-width:420px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1">Xác thực 2 lớp</h4>
            <p class="text-muted small">Mở app Authenticator và nhập mã 6 số đang hiển thị.</p>

            <div asp-validation-summary="All" class="text-danger small mb-2"></div>

            <form asp-action="LoginWith2fa" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rememberMe" value="@rememberMe" />
                <div class="mb-3">
                    <label class="form-label">Mã xác thực</label>
                    <input asp-for="Code" class="form-control form-control-lg text-center"
                           autocomplete="off" inputmode="numeric" placeholder="123456" autofocus />
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMachine" class="form-check-input" />
                    <label asp-for="RememberMachine" class="form-check-label">Ghi nhớ thiết bị này</label>
                </div>
                <button type="submit" class="btn w-100 text-white fw-bold" style="background:#7c3aed;border:none;">Xác nhận</button>
            </form>
        </div>
    </div>
</div>
