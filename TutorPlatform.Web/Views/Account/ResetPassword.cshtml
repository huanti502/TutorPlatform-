@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var token = ViewBag.Token as string ?? "";
    var email = ViewBag.Email as string ?? "";
}

<div style="min-height:calc(100vh - 130px);display:flex;
    align-items:center;background:var(--bg);padding:2rem 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <!-- Icon + title -->
                <div class="text-center mb-4">
                    <div class="mx-auto mb-3 d-flex align-items-center
                        justify-content-center"
                         style="width:60px;height:60px;border-radius:18px;
                        background:linear-gradient(135deg,#F0FDF4,#DCFCE7);">
                        <svg width="28" height="28" fill="none"
                             stroke="#059669" stroke-width="1.8"
                             viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                        </svg>
                    </div>
                    <h4 style="font-weight:800;margin-bottom:0.4rem;">
                        Đặt lại mật khẩu
                    </h4>
                    <p style="color:var(--text-muted);font-size:0.875rem;
                        max-width:280px;margin:0 auto;">
                        Tạo mật khẩu mới cho tài khoản của bạn
                    </p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div style="background:var(--danger-light);
                        border-radius:12px;padding:1rem;
                        margin-bottom:1rem;font-size:0.875rem;
                        color:var(--danger);font-weight:600;">
                        ⚠ @TempData["Error"]
                    </div>
                }

                <!-- Hiển thị thông tin email -->
                @if (!string.IsNullOrEmpty(email))
                {
                    <div style="background:var(--primary-light);
                        border-radius:12px;padding:0.75rem 1rem;
                        margin-bottom:1rem;font-size:0.82rem;
                        color:var(--primary);font-weight:600;
                        display:flex;align-items:center;gap:0.5rem;">
                        <svg width="14" height="14" fill="none"
                             stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9
                            2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                        Đặt lại cho: <strong>@email</strong>
                    </div>
                }

                <div class="card"
                     style="border-radius:20px;border:none;
                    box-shadow:var(--shadow-lg);">
                    <div class="card-body p-4">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mb-3"
                                 style="border-radius:10px;font-size:0.85rem;">
                                @Html.ValidationSummary(true)
                            </div>
                        }

                        <form asp-action="ResetPassword" method="post">
                            @Html.AntiForgeryToken()

                            <!-- Hidden fields — dùng Razor variable đã lấy ở trên -->
                            <input type="hidden" name="token" value="@token" />
                            <input type="hidden" name="email" value="@email" />

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu mới</label>
                                <div style="position:relative;">
                                    <input type="password" name="newPassword"
                                           id="newPwd" class="form-control"
                                           style="padding:0.65rem 2.5rem
                                    0.65rem 0.9rem;"
                                           placeholder="Tối thiểu 6 ký tự"
                                           required minlength="6" />
                                    <button type="button"
                                            onclick="togglePwd('newPwd','eyeNew')"
                                            style="position:absolute;right:10px;
                                        top:50%;transform:translateY(-50%);
                                        background:none;border:none;
                                        cursor:pointer;
                                        color:var(--text-muted);">
                                        <svg id="eyeNew" width="16" height="16"
                                             fill="none" stroke="currentColor"
                                             stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8
                                            -4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Xác nhận mật khẩu mới
                                </label>
                                <div style="position:relative;">
                                    <input type="password" name="confirmPassword"
                                           id="confirmPwd" class="form-control"
                                           style="padding:0.65rem 2.5rem
                                    0.65rem 0.9rem;"
                                           placeholder="Nhập lại mật khẩu"
                                           required minlength="6" />
                                    <button type="button"
                                            onclick="togglePwd('confirmPwd',
                                        'eyeConfirm')"
                                            style="position:absolute;right:10px;
                                        top:50%;transform:translateY(-50%);
                                        background:none;border:none;
                                        cursor:pointer;
                                        color:var(--text-muted);">
                                        <svg id="eyeConfirm" width="16" height="16"
                                             fill="none" stroke="currentColor"
                                             stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8
                                            -4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Password strength meter -->
                            <div class="mb-4">
                                <div style="display:flex;gap:4px;margin-bottom:4px;">
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <div class="strength-bar"
                                             style="height:4px;flex:1;
                                            border-radius:100px;
                                            background:var(--border);
                                            transition:background 0.3s;">
                                        </div>
                                    }
                                </div>
                                <div id="strengthLabel"
                                     style="font-size:0.72rem;
                                    color:var(--text-muted);
                                    font-weight:600;min-height:1em;">
                                </div>
                            </div>

                            <button type="submit" class="btn w-100"
                                    style="padding:0.7rem;border-radius:10px;
                                font-size:0.95rem;font-weight:700;
                                background:linear-gradient(
                                135deg,#059669,#10B981);
                                color:#fff;border:none;
                                box-shadow:0 4px 14px
                                rgba(5,150,105,0.3);">
                                <svg width="17" height="17" fill="none"
                                     stroke="currentColor" stroke-width="2.5"
                                     viewBox="0 0 24 24" class="me-1">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                Đặt lại mật khẩu
                            </button>
                        </form>

                    </div>
                </div>

                <p class="text-center mt-3"
                   style="font-size:0.875rem;color:var(--text-muted);">
                    <a asp-action="Login"
                       style="font-weight:700;color:var(--primary);">
                        ← Quay lại đăng nhập
                    </a>
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePwd(inputId, eyeId) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'text' ? 'password' : 'text';
            document.getElementById(eyeId).style.opacity =
                input.type === 'text' ? '0.4' : '1';
        }

        const pwdInput  = document.getElementById('newPwd');
        const bars      = document.querySelectorAll('.strength-bar');
        const label     = document.getElementById('strengthLabel');
        const levels    = [
            { color:'#EF4444', text:'Quá yếu'   },
            { color:'#F59E0B', text:'Yếu'        },
            { color:'#3B82F6', text:'Trung bình' },
            { color:'#10B981', text:'Mạnh'       },
        ];

        pwdInput.addEventListener('input', () => {
            const v = pwdInput.value;
            let score = 0;
            if (v.length >= 6)  score++;
            if (v.length >= 10) score++;
            if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
            if (/[0-9]/.test(v) && /[^A-Za-z0-9]/.test(v)) score++;

            bars.forEach((bar, i) => {
                bar.style.background = i < score
                    ? levels[score-1].color : 'var(--border)';
            });
            label.textContent  = score > 0 ? levels[score-1].text : '';
            label.style.color  = score > 0
                ? levels[score-1].color : 'var(--text-muted)';
        });
    </script>
}