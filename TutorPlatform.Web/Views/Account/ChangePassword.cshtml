@model TutorPlatform.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div style="min-height:calc(100vh - 130px);display:flex;
            align-items:center;background:var(--bg);padding:2rem 0;">
<div class="container">
<div class="row justify-content-center">
<div class="col-md-5 col-lg-4">

                <div class="text-center mb-4">
<div class="mx-auto mb-3 d-flex align-items-center
                                justify-content-center"
                         style="width:56px;height:56px;border-radius:16px;
                                background:var(--warning-light);">
<svg width="26" height="26" fill="none"
                             stroke="var(--warning)" stroke-width="2"
                             viewBox="0 0 24 24">
<rect x="3" y="11" width="18" height="11" rx="2"/>
<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
</svg>
</div>
<h4 style="font-weight:800;margin-bottom:0.25rem;">
Đổi mật khẩu
                    </h4>
<p style="color:var(--text-muted);font-size:0.875rem;">
Cập nhật mật khẩu bảo mật của bạn
                    </p>
</div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-3"
                         style="font-size:0.875rem;border-radius:10px;">
@TempData["Success"]
                    </div>
}

                <div class="card" style="border-radius:20px;border:none;
                                         box-shadow:var(--shadow-lg);">
<div class="card-body p-4">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 mb-3"
                                 style="font-size:0.85rem;">
@Html.ValidationSummary(true)
                            </div>
}

                        <form asp-action="ChangePassword" method="post">
@Html.AntiForgeryToken()

                            <div class="mb-3">
<label class="form-label">Mật khẩu hiện tại</label>
<input asp-for="CurrentPassword" type="password"
                                       class="form-control" placeholder="••••••••"
                                       style="padding:0.65rem 0.9rem;" />
<span asp-validation-for="CurrentPassword"
                                      class="text-danger"
                                      style="font-size:0.8rem;"></span>
</div>

                            <div class="mb-3">
<label class="form-label">Mật khẩu mới</label>
<input asp-for="NewPassword" type="password"
                                       class="form-control" placeholder="••••••••"
                                       style="padding:0.65rem 0.9rem;" />
<span asp-validation-for="NewPassword"
                                      class="text-danger"
                                      style="font-size:0.8rem;"></span>
</div>

                            <div class="mb-4">
<label class="form-label">Xác nhận mật khẩu mới</label>
<input asp-for="ConfirmPassword" type="password"
                                       class="form-control" placeholder="••••••••"
                                       style="padding:0.65rem 0.9rem;" />
<span asp-validation-for="ConfirmPassword"
                                      class="text-danger"
                                      style="font-size:0.8rem;"></span>
</div>

                            <button type="submit"
                                    class="btn btn-warning w-100 text-white"
                                    style="padding:0.7rem;border-radius:10px;
                                           font-size:0.95rem;font-weight:700;">
Cập nhật mật khẩu
                            </button>
</form>
</div>
</div>
</div>
</div>
</div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}