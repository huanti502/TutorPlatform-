@{
    ViewData["Title"] = "Viết bài mới";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;700&display=swap"
      rel="stylesheet">

<section class="section-sm">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- Header -->
                <div class="mb-4">
                    <a asp-action="Index"
                       class="d-inline-flex align-items-center gap-1 mb-3"
                       style="color:var(--text-muted);text-decoration:none;
                              font-size:0.875rem;font-weight:500;">
                        <svg width="14" height="14" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        Trở về Blog
                    </a>
                    <h4 style="font-family:'Libre Bodoni',serif;font-weight:700;
                               font-size:1.75rem;margin-bottom:0.25rem;">
                        Viết bài mới
                    </h4>
                    <p style="color:var(--text-muted);font-size:0.875rem;">
                        Chia sẻ kiến thức và kinh nghiệm với cộng đồng
                    </p>
                </div>

                <div class="card"
                     style="border-radius:20px;border:none;
                            box-shadow:var(--shadow-md);">
                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Create" method="post"
                              enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <!-- Title -->
                            <div class="mb-4">
                                <label class="form-label"
                                       style="font-weight:700;font-size:0.8rem;
                                              text-transform:uppercase;
                                              letter-spacing:0.06em;
                                              color:var(--text-muted);">
                                    Tiêu đề bài viết
                                </label>
                                <input type="text" name="title"
                                       class="form-control"
                                       placeholder="Nhập tiêu đề hấp dẫn..."
                                       required
                                       style="font-family:'Libre Bodoni',serif;
                                              font-size:1.2rem;font-weight:700;
                                              padding:0.75rem 1rem;
                                              border-radius:12px;
                                              border:2px solid var(--border);" />
                            </div>

                            <!-- Image upload -->
                            <div class="mb-4">
                                <label class="form-label"
                                       style="font-weight:700;font-size:0.8rem;
                                              text-transform:uppercase;
                                              letter-spacing:0.06em;
                                              color:var(--text-muted);">
                                    Ảnh bìa
                                    <span style="text-transform:none;
                                                 letter-spacing:0;
                                                 font-weight:400;">
                                        (tuỳ chọn)
                                    </span>
                                </label>
                                <div style="border:2px dashed var(--border);
                                            border-radius:12px;padding:1.5rem;
                                            text-align:center;background:var(--bg);
                                            cursor:pointer;"
                                     onclick="document.getElementById('imageFile').click()">
                                    <svg width="28" height="28" fill="none"
                                         stroke="#EC4899" stroke-width="1.5"
                                         viewBox="0 0 24 24"
                                         style="display:block;margin:0 auto 0.5rem;">
                                        <rect x="3" y="3" width="18" height="18"
                                              rx="2" ry="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                    <div style="font-size:0.875rem;font-weight:600;
                                                color:var(--text-secondary);">
                                        Nhấn để chọn ảnh bìa
                                    </div>
                                    <div style="font-size:0.78rem;
                                                color:var(--text-muted);
                                                margin-top:0.25rem;">
                                        JPG, PNG — tối đa 5MB
                                    </div>
                                </div>
                                <input type="file" name="imageFile" id="imageFile"
                                       accept="image/*" class="d-none"
                                       onchange="previewImage(this)" />
                                <div id="imgPreview" class="mt-2 d-none">
                                    <img id="imgPreviewEl"
                                         style="max-height:200px;border-radius:10px;
                                                object-fit:cover;width:100%;" />
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="mb-4">
                                <label class="form-label"
                                       style="font-weight:700;font-size:0.8rem;
                                              text-transform:uppercase;
                                              letter-spacing:0.06em;
                                              color:var(--text-muted);">
                                    Nội dung
                                </label>
                                <textarea name="content" class="form-control"
                                          rows="12" required
                                          placeholder="Chia sẻ kiến thức, kinh nghiệm hoặc đặt câu hỏi..."
                                          style="padding:1rem;border-radius:12px;
                                                 border:2px solid var(--border);
                                                 resize:vertical;line-height:1.8;
                                                 font-size:0.95rem;"></textarea>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index"
                                   class="btn btn-outline-secondary"
                                   style="border-radius:10px;font-weight:600;">
                                    Huỷ
                                </a>
                                <button type="submit" class="btn px-4"
                                        style="background:#EC4899;color:#fff;
                                               border-radius:10px;font-weight:700;
                                               border:none;
                                               box-shadow:0 4px 12px
                                               rgba(236,72,153,0.3);">
                                    <svg width="16" height="16" fill="none"
                                         stroke="currentColor" stroke-width="2.5"
                                         viewBox="0 0 24 24" class="me-1">
                                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                                    </svg>
                                    Đăng bài
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('imgPreviewEl').src = e.target.result;
                    document.getElementById('imgPreview').classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}