@{
    ViewData["Title"] = "Đăng lớp cần gia sư";
    var subjects = ViewBag.Subjects as List<TutorPlatform.Core.Models.Subject> ?? new();
}

<div class="container py-5" style="max-width:720px;">
    <h1 class="fw-bold mb-1" style="font-size:1.5rem;">Đăng lớp cần gia sư</h1>
    <p class="text-muted mb-4">Mô tả càng chi tiết, gia sư phù hợp càng dễ tìm thấy bạn.</p>

    <form method="post" asp-action="Create" class="card border-0 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-semibold">Tiêu đề lớp <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control" required maxlength="200"
                           placeholder="VD: Toán lớp 7 lên 8 - 2 buổi/tuần - Quận Bình Thạnh" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">Mô tả chi tiết <span class="text-danger">*</span></label>
                    <textarea name="description" class="form-control" rows="4" required maxlength="2000"
                              placeholder="- Học sinh: giới tính, học lực hiện tại, mục tiêu&#10;- Yêu cầu gia sư: kinh nghiệm, phong cách dạy&#10;- Ghi chú khác..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Môn học</label>
                    <select name="subjectId" class="form-select">
                        <option value="">-- Chọn môn --</option>
                        @foreach (var s in subjects)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Hình thức học <span class="text-danger">*</span></label>
                    <select name="mode" class="form-select" required id="modeSelect">
                        <option value="Online">Trực tuyến</option>
                        <option value="Offline">Tại nhà</option>
                        <option value="Both">Linh hoạt (cả hai)</option>
                    </select>
                </div>
                <div class="col-12" id="locationField" style="display:none;">
                    <label class="form-label small fw-semibold">Khu vực học</label>
                    <input type="text" name="location" class="form-control" maxlength="200"
                           placeholder="VD: Phường 25, Q. Bình Thạnh, TP.HCM" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Lịch học mong muốn <span class="text-danger">*</span></label>
                    <input type="text" name="schedule" class="form-control" required maxlength="200"
                           placeholder="VD: Tối T2, T4 từ 19h - 21h" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Số buổi/tuần <span class="text-danger">*</span></label>
                    <input type="number" name="sessionsPerWeek" class="form-control" min="1" max="7" value="2" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Học phí/buổi (đ) <span class="text-danger">*</span></label>
                    <input type="number" name="budgetPerSession" class="form-control" min="10000" step="10000" required
                           placeholder="200000" />
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary px-4">Đăng lớp</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const modeSel = document.getElementById('modeSelect');
        const locField = document.getElementById('locationField');
        function toggleLoc() { locField.style.display = modeSel.value === 'Online' ? 'none' : ''; }
        modeSel.addEventListener('change', toggleLoc);
        toggleLoc();
    </script>
}
