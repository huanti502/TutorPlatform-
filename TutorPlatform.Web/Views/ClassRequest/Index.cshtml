@model List<TutorPlatform.Core.Models.ClassRequest>
@{
    ViewData["Title"] = "Lớp cần gia sư";
    var subjects = ViewBag.Subjects as List<TutorPlatform.Core.Models.Subject> ?? new();
    var appliedIds = ViewBag.AppliedIds as List<int> ?? new();
    bool isTutor = User.Identity?.IsAuthenticated == true && User.IsInRole("Tutor");
    bool isStudent = User.Identity?.IsAuthenticated == true && User.IsInRole("Student");

    var mySubjectIds = ViewBag.MySubjectIds as List<int> ?? new();
    var myMode = ViewBag.MyMode as string ?? "";
    // Lớp "phù hợp": trùng môn gia sư dạy (và hình thức không xung khắc).
    bool IsMatch(TutorPlatform.Core.Models.ClassRequest c) =>
        isTutor && c.SubjectId.HasValue && mySubjectIds.Contains(c.SubjectId.Value)
        && (myMode == "Both" || c.Mode == "Both" || c.Mode == myMode);

    var displayList = isTutor
        ? Model.OrderByDescending(IsMatch).ToList()   // đẩy lớp phù hợp lên đầu
        : Model;
    int matchCount = isTutor ? Model.Count(IsMatch) : 0;

    string ModeText(string m) => m switch { "Online" => "Trực tuyến", "Offline" => "Tại nhà", _ => "Linh hoạt" };
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
        <h1 class="fw-bold mb-0" style="font-size:1.6rem;letter-spacing:-0.02em;">Danh sách lớp cần gia sư</h1>
        @if (isStudent)
        {
            <div class="d-flex gap-2">
                <a asp-action="My" class="btn btn-outline-primary btn-sm px-3">Lớp của tôi</a>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3">+ Đăng lớp mới</a>
            </div>
        }
    </div>
    <p class="text-muted mb-4">Có <b>@Model.Count</b> lớp đang mở — gia sư có thể gửi đề nghị dạy trực tiếp.</p>

    @if (isTutor && matchCount > 0)
    {
        <div class="alert d-flex align-items-center gap-2 border-0" style="background:var(--primary-light);color:var(--primary);">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
            <span><b>@matchCount lớp</b> phù hợp với môn bạn đang dạy — đã được đẩy lên đầu danh sách.</span>
        </div>
    }

    <form method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <select name="subjectId" class="form-select" style="max-width:190px;">
                <option value="">Chọn môn học</option>
                @foreach (var s in subjects)
                {
                    <option value="@s.Id" selected="@(ViewBag.SubjectId == s.Id)">@s.Name</option>
                }
            </select>
            <select name="mode" class="form-select" style="max-width:170px;">
                @{ var m = ViewBag.Mode as string ?? ""; }
                <option value="">Hình thức dạy</option>
                <option value="Online" selected="@(m == "Online")">Trực tuyến</option>
                <option value="Offline" selected="@(m == "Offline")">Tại nhà</option>
                <option value="Both" selected="@(m == "Both")">Linh hoạt</option>
            </select>
            <input type="text" name="keyword" class="form-control" style="max-width:280px;flex:1;"
                   value="@ViewBag.Keyword" placeholder="Từ khoá, khu vực..." />
            @{ var srt = ViewBag.Sort as string ?? ""; }
            <select name="sort" class="form-select" style="max-width:170px;">
                <option value="" selected="@(srt == "")">Mới nhất</option>
                <option value="price_desc" selected="@(srt == "price_desc")">Học phí cao → thấp</option>
                <option value="price_asc" selected="@(srt == "price_asc")">Học phí thấp → cao</option>
            </select>
            <button type="submit" class="btn btn-primary px-4">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xoá lọc</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                 style="width:72px;height:72px;border-radius:50%;background:var(--primary-light);">
                <svg width="34" height="34" fill="none" stroke="var(--primary)" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
            </div>
            <div class="fw-semibold mb-1">Chưa có lớp nào phù hợp</div>
            <div class="text-muted small">Thử bỏ bớt bộ lọc hoặc quay lại sau nhé.</div>
            @if (isStudent) { <div class="mt-3"><a asp-action="Create" class="btn btn-primary btn-sm px-4">Đăng lớp đầu tiên</a></div> }
        </div></div>
    }

    @foreach (var c in displayList)
    {
        var matched = IsMatch(c);
        <div class="card border-0 shadow-sm mb-3 class-card" style="@(matched ? "border-left:3px solid var(--primary) !important;" : "")">
            <div class="card-body p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-2 col-md-3 text-md-center">
                        <div class="fw-bold" style="color:var(--primary);font-size:1.05rem;">LH@(c.Id.ToString("D4"))</div>
                        <div class="text-muted small">@c.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</div>
                        @if ((DateTime.UtcNow - c.CreatedAt).TotalHours < 24)
                        {
                            <span class="badge mt-1" style="background:#ef4444;color:#fff;">Mới</span>
                        }
                        <span class="badge mt-1 @(c.Mode == "Online" ? "bg-info text-dark" : c.Mode == "Offline" ? "bg-success" : "bg-secondary")">@ModeText(c.Mode)</span>
                    </div>
                    <div class="col-lg-6 col-md-9">
                        <h5 class="fw-bold mb-2" style="font-size:1.02rem;">
                            @c.Title
                            @if (matched)
                            {
                                <span class="badge ms-1" style="background:var(--primary);color:#fff;font-size:.68rem;vertical-align:middle;">✓ Phù hợp với bạn</span>
                            }
                        </h5>
                        @if (c.Student != null)
                        {
                            var lv = TutorPlatform.Web.Services.XpService.GetLevel(c.Student.XpPoints);
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <a asp-controller="StudentProfile" asp-action="Index" asp-route-id="@c.Student.Id"
                                   class="text-muted small text-decoration-none">Đăng bởi <span class="fw-semibold" style="color:var(--primary);">@c.Student.FullName</span></a>
                                @if (c.Student.XpPoints >= 100)
                                {
                                    <span class="badge" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;" title="Học viên tích cực - đã tích luỹ @c.Student.XpPoints XP">
                                        ⭐ @lv.level
                                    </span>
                                }
                            </div>
                        }
                        <p class="text-muted small mb-2" style="white-space:pre-line;">@c.Description</p>
                        <div class="text-muted small mb-2">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            @c.Schedule — @c.SessionsPerWeek buổi/tuần
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (c.Subject != null) { <span class="badge bg-light text-dark border">@c.Subject.Name</span> }
                            @if (!string.IsNullOrEmpty(c.Location))
                            {
                                <span class="badge bg-light text-dark border">
                                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @c.Location
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 text-lg-center">
                        <div class="fw-bold" style="font-size:1.05rem;">@c.BudgetPerSession.ToString("N0")đ<span class="text-muted fw-normal small">/buổi</span></div>
                        <div class="text-muted small"><span class="app-count" data-class-id="@c.Id">@c.Applications.Count</span> đề nghị</div>
                    </div>
                    <div class="col-lg-2 col-md-6 text-lg-end">
                        @if (isTutor)
                        {
                            @if (appliedIds.Contains(c.Id))
                            {
                                <button class="btn btn-outline-success btn-sm px-3" disabled>Đã gửi đề nghị</button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#applyModal"
                                        data-id="@c.Id" data-title="@c.Title" data-budget="@c.BudgetPerSession">
                                    Đề nghị dạy
                                </button>
                            }
                        }
                        else if (!User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3">Đăng nhập để nhận lớp</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (isTutor)
{
    <div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form class="modal-content" method="post" asp-action="Apply">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classRequestId" id="applyRequestId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Đề nghị dạy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="text-muted small mb-3" id="applyClassTitle"></div>
                    <label class="form-label small fw-semibold">Lời nhắn tới học viên</label>
                    <textarea name="message" class="form-control mb-3" rows="3" maxlength="1000"
                              placeholder="Giới thiệu kinh nghiệm và cách bạn sẽ giúp học viên tiến bộ..."></textarea>
                    <label class="form-label small fw-semibold">Học phí đề xuất / buổi (để trống nếu đồng ý mức của lớp)</label>
                    <input type="number" name="proposedRate" class="form-control" min="0" step="10000" id="applyRate" />
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-primary px-4">Gửi đề nghị</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Gán dữ liệu vào modal "Đề nghị dạy" (chỉ chạy khi phần tử tồn tại — tức là gia sư).
        document.getElementById('applyModal')?.addEventListener('show.bs.modal', function (ev) {
            const btn = ev.relatedTarget;
            document.getElementById('applyRequestId').value = btn.dataset.id;
            document.getElementById('applyClassTitle').textContent = 'Lớp: ' + btn.dataset.title;
            document.getElementById('applyRate').placeholder = 'VD: ' + Number(btn.dataset.budget).toLocaleString('vi-VN') + 'đ';
        });
        // Cập nhật số đề nghị mỗi 20s để trạng thái "đang tuyển" luôn mới.
        async function refreshCounts() {
            try {
                const res = await fetch('/ClassRequest/LiveCounts');
                if (!res.ok) return;
                const data = await res.json();
                data.items.forEach(it => {
                    const el = document.querySelector(`.app-count[data-class-id="${it.id}"]`);
                    if (el && el.textContent.trim() !== String(it.count)) {
                        el.textContent = it.count;
                        el.style.transition = 'color .3s';
                        el.style.color = '#16a34a';
                        setTimeout(() => el.style.color = '', 800);
                    }
                });
            } catch (e) { /* im lặng */ }
        }
        setInterval(refreshCounts, 20000);
    </script>
}
