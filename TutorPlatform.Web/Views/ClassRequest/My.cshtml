@model List<TutorPlatform.Core.Models.ClassRequest>
@{
    ViewData["Title"] = "Lớp của tôi";

    string StatusBadge(string s) => s switch
    {
        "Open" => "bg-warning text-dark",
        "Matched" => "bg-success",
        _ => "bg-secondary"
    };
    string StatusText(string s) => s switch
    {
        "Open" => "Đang mở",
        "Matched" => "Đã chọn gia sư",
        _ => "Đã đóng"
    };
}

<div class="container py-5" style="max-width:900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Lớp của tôi</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">+ Đăng lớp mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-5">
            Bạn chưa đăng lớp nào. <a asp-action="Create">Đăng lớp đầu tiên</a> để gia sư tìm đến bạn!
        </div></div>
    }

    @foreach (var c in Model)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
                    <div>
                        <span class="badge @StatusBadge(c.Status) me-2">@StatusText(c.Status)</span>
                        <span class="fw-bold">LH@(c.Id.ToString("D4")) — @c.Title</span>
                        <div class="text-muted small mt-1">
                            @(c.Subject?.Name ?? "Chưa chọn môn") · @c.Schedule · @c.SessionsPerWeek buổi/tuần · @c.BudgetPerSession.ToString("N0")đ/buổi
                        </div>
                    </div>
                    @if (c.Status == "Open")
                    {
                        <form method="post" asp-action="Close" onsubmit="return confirm('Đóng lớp này? Gia sư sẽ không gửi đề nghị được nữa.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Đóng lớp</button>
                        </form>
                    }
                </div>

                <div class="fw-semibold small mb-2 mt-3">
                    Đề nghị dạy (@c.Applications.Count)
                </div>

                @if (!c.Applications.Any())
                {
                    <div class="text-muted small">Chưa có gia sư nào gửi đề nghị.</div>
                }
                else
                {
                    foreach (var a in c.Applications.OrderByDescending(x => x.Status == "Accepted").ThenByDescending(x => x.CreatedAt))
                    {
                        var tutor = a.TutorProfile;
                        var tutorUser = tutor?.User;
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-2"
                             style="background:@(a.Status == "Accepted" ? "var(--primary-light)" : "var(--surface)");border:1px solid var(--border);">
                            @if (!string.IsNullOrEmpty(tutorUser?.AvatarUrl))
                            {
                                <img src="@tutorUser.AvatarUrl" alt="@tutorUser.FullName" class="rounded-circle"
                                     style="width:44px;height:44px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;background:var(--primary);color:#fff;font-weight:700;">
                                    @(tutorUser?.FullName?.Substring(0, 1) ?? "G")
                                </div>
                            }
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div>
                                        <a asp-controller="Tutor" asp-action="Detail" asp-route-id="@tutor?.Id"
                                           class="fw-semibold text-decoration-none">@(tutorUser?.FullName ?? "Gia sư")</a>
                                        <span class="text-muted small ms-1">@tutor?.Education</span>
                                        @if (a.Status == "Accepted") { <span class="badge bg-success ms-1">Đã chọn</span> }
                                        else if (a.Status == "Rejected") { <span class="badge bg-secondary ms-1">Đã từ chối</span> }
                                    </div>
                                    <div class="small fw-semibold">
                                        @((a.ProposedRate ?? c.BudgetPerSession).ToString("N0"))đ/buổi
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(a.Message))
                                {
                                    <div class="text-muted small mt-1" style="white-space:pre-line;">@a.Message</div>
                                }
                                @if (c.Status == "Open" && a.Status == "Pending")
                                {
                                    <form method="post" asp-action="Accept" class="mt-2"
                                          onsubmit="return confirm('Chọn gia sư này? Các đề nghị khác sẽ tự từ chối.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@a.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3">Chấp nhận</button>
                                        <a asp-controller="Tutor" asp-action="Detail" asp-route-id="@tutor?.Id"
                                           class="btn btn-sm btn-outline-primary px-3">Xem hồ sơ</a>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>
