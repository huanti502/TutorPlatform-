@model List<TutorPlatform.Web.Controllers.TutorSearchController.SearchResult>
@using TutorPlatform.Core.Models
@{
    ViewBag.Title = "Tìm kiếm gia sư";
}

<div class="container-fluid py-4">
<div class="row g-4">

        @* Sidebar bộ lọc *@
        <div class="col-lg-3">
<div class="card shadow-sm sticky-top" style="top:80px">
<div class="card-header bg-primary text-white fw-bold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Bộ lọc</div>
<div class="card-body">
<form method="get">
<div class="mb-3">
<label class="form-label fw-semibold">Từ khóa</label>
<input name="keyword" class="form-control" placeholder="Tên, khu vực..."
                                   value="@ViewBag.Keyword" />
</div>
<div class="mb-3">
<label class="form-label fw-semibold">Môn học</label>
<select name="subjectId" class="form-select">
<option value="">-- Tất cả --</option>
@foreach (var s in (ViewBag.Subjects as List<Subject> ?? new()))
                                {
                                    <option value="@s.Id" selected="@(ViewBag.SubjectId?.ToString() == s.Id.ToString())">
@s.Name
                                    </option>
}
                            </select>
</div>
<div class="mb-3">
<label class="form-label fw-semibold">Hình thức</label>
<select name="mode" class="form-select">
<option value="">-- Tất cả --</option>
<option value="Online" selected="@(ViewBag.Mode?.ToString() == "Online")"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg> Online</option>
<option value="Offline" selected="@(ViewBag.Mode?.ToString() == "Offline")"> Tại nhà</option>
<option value="Both" selected="@(ViewBag.Mode?.ToString() == "Both")"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg> Cả hai</option>
</select>
</div>
<div class="mb-3">
<label class="form-label fw-semibold">Cấp học</label>
<select name="level" class="form-select">
<option value="">-- Tất cả --</option>
@foreach (var lv in (ViewBag.Levels as List<string> ?? new()))
                                {
                                    <option value="@lv" selected="@(ViewBag.Level?.ToString() == lv)">@lv</option>
}
                            </select>
</div>
<div class="mb-3">
<label class="form-label fw-semibold">Học phí (VNĐ/giờ)</label>
<div class="d-flex gap-2">
<input type="number" name="minPrice" class="form-control form-control-sm"
                                       placeholder="Từ" value="@ViewBag.MinPrice" step="50000" />
<input type="number" name="maxPrice" class="form-control form-control-sm"
                                       placeholder="Đến" value="@ViewBag.MaxPrice" step="50000" />
</div>
</div>
<div class="mb-3">
<label class="form-label fw-semibold">Rating tối thiểu</label>
<select name="minRating" class="form-select">
<option value="0">Tất cả</option>
<option value="3" selected="@(ViewBag.MinRating?.ToString() == "3")"><svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> 3+</option>
<option value="4" selected="@(ViewBag.MinRating?.ToString() == "4")"><svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> 4+</option>
<option value="4.5" selected="@(ViewBag.MinRating?.ToString() == "4.5")"><svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> 4.5+</option>
</select>
</div>
<div class="mb-4">
<label class="form-label fw-semibold">Sắp xếp</label>
<select name="sortBy" class="form-select">
<option value="rating" selected="@(ViewBag.SortBy?.ToString() == "rating")"><svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg> Rating cao</option>
<option value="price_asc" selected="@(ViewBag.SortBy?.ToString() == "price_asc")"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 6v2m0 8v2"/></svg> Giá thấp→cao</option>
<option value="price_desc" selected="@(ViewBag.SortBy?.ToString() == "price_desc")"> Giá cao→thấp</option>
<option value="newest" selected="@(ViewBag.SortBy?.ToString() == "newest")"> Mới nhất</option>
</select>
</div>
<button type="submit" class="btn btn-primary w-100"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Tìm kiếm</button>
<a href="/TutorSearch/Search" class="btn btn-outline-secondary w-100 mt-2"> Xóa bộ lọc</a>
</form>
</div>
</div>
</div>

        @* Kết quả *@
        <div class="col-lg-9">
<div class="card border-0 shadow-sm mb-3"><div class="card-body py-3">
<div class="d-flex gap-2 flex-wrap align-items-center">
<svg width="18" height="18" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="flex-shrink:0;"><path d="M12 3v2M12 19v2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M3 12h2M19 12h2M5.6 18.4 7 17M17 7l1.4-1.4"/><circle cx="12" cy="12" r="3"/></svg>
<input id="nlQuery" class="form-control" style="flex:1;min-width:240px;" placeholder='Tìm bằng câu tự nhiên: "gia sư Toán online dưới 200k rating cao"...' />
<button id="nlBtn" class="btn text-white fw-bold" style="background:#7c3aed;border:none;">Tìm bằng AI</button>
<a asp-action="Wizard" class="btn btn-outline-secondary">Tìm giúp tôi</a>
</div>
<div id="nlStatus" class="small text-muted mt-1"></div>
</div></div>
<h5 class="fw-bold mb-3">Tìm thấy <span class="text-primary">@ViewBag.TotalCount</span> gia sư</h5>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
<div style="font-size:4rem"></div>
<h5>Không tìm thấy gia sư phù hợp</h5>
<p>Thử điều chỉnh bộ lọc.</p>
</div>
}
            else
            {
                <div class="row g-3">
@foreach (var r in Model)
                    {
                        var t = r.Profile;
                        <div class="col-md-6 col-xl-4">
<div class="card h-100 " style="border-radius:12px;transition:transform .2s;position:relative;"
                                 onmouseover="this.style.transform='translateY(-4px)'"
                                 onmouseout="this.style.transform=''">
<div class="card-body p-4">
@{
                                        var favIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
                                        var isFav = favIds.Contains(t.Id);
                                        var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
                                    }
                                    <label class="position-absolute d-flex align-items-center gap-1 cmp-pill" title="Chọn để so sánh"
       style="top:14px;right:52px;z-index:2;cursor:pointer;font-size:.72rem;font-weight:600;color:var(--text-muted);background:var(--bg-subtle,#f1f5f9);border:1px solid var(--border,#e2e8f0);border-radius:99px;padding:3px 10px 3px 7px;line-height:1;user-select:none;">
<input type="checkbox" class="form-check-input cmp-check" value="@t.Id" style="margin:0;width:13px;height:13px;" /> So sánh
</label>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form asp-controller="Favorite" asp-action="Toggle" method="post"
                                              class="position-absolute" style="top:12px;right:12px;z-index:2;">
@Html.AntiForgeryToken()
                                            <input type="hidden" name="tutorProfileId" value="@t.Id" />
<input type="hidden" name="returnUrl" value="@currentUrl" />
<button type="submit" title="@(isFav ? "Bỏ lưu" : "Lưu gia sư")"
                                                    style="background:none;border:none;cursor:pointer;padding:4px;line-height:0;">
<svg width="22" height="22" viewBox="0 0 24 24"
                                                     fill="@(isFav ? "#EF4444" : "none")"
                                                     stroke="@(isFav ? "#EF4444" : "#9CA3AF")" stroke-width="2"
                                                     aria-hidden="true">
<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
</svg>
</button>
</form>
}
                                    <div class="d-flex align-items-center gap-3 mb-3">
@if (!string.IsNullOrEmpty(t.User?.AvatarUrl))
                                        {
                                            <img src="@t.User.AvatarUrl"
                                                 class="rounded-circle flex-shrink-0"
                                                 style="width:48px;height:48px;object-fit:cover"
                                                 alt="@t.User.FullName" />
}
                                        else
                                        {
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                                 style="width:48px;height:48px;font-size:20px;flex-shrink:0">
@t.User?.FullName?.FirstOrDefault()
                                            </div>
}
                                        <div>
<h6 class="fw-bold mb-0">@t.User?.FullName</h6>
<small class="text-muted"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg> @t.TeachingArea</small>
</div>
</div>

                                    @* Huy hiệu *@
                                    @if (t.TutorBadges?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-2">
@foreach (var tb in t.TutorBadges.Take(3))
                                            {
                                                <span class="badge rounded-pill px-2" style="background:@tb.Badge?.Color;font-size:11px">
@tb.Badge?.Icon @tb.Badge?.Name
                                                </span>
}
                                        </div>
}

                                    @* Rating *@
                                    <div class="d-flex align-items-center gap-1 mb-2">
@for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="text-warning">@(i <= Math.Round(r.AvgRating) ? "" : "")</span>
}
                                        <span class="fw-semibold ms-1">@r.AvgRating.ToString("0.#")</span>
<span class="text-muted small">(@r.ReviewCount)</span>
</div>

                                    <div class="small text-muted mb-3">
<div><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg> @t.Education | ⏱ @t.ExperienceYears năm</div>
<div><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> @r.CompletedCount buổi đã dạy</div>
</div>

                                    <div class="d-flex flex-wrap gap-1 mb-3">
@foreach (var ts in t.TutorSubjects?.Take(3) ?? Enumerable.Empty<TutorSubject>())
                                        {
                                            <span class="badge bg-light text-dark border">@ts.Subject?.Name</span>
}
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
<span class="fw-bold text-primary">
@t.HourlyRate.ToString("N0") <small class="text-muted fw-normal">VNĐ/h</small>
</span>
<a href="/Tutor/Detail/@t.Id" class="btn btn-primary btn-sm">Xem hồ sơ</a>
</div>
</div>
</div>
</div>
}
                </div>

                @* Phân trang *@
                @if ((int)ViewBag.TotalPages > 1)
                {
                    <nav class="mt-4">
<ul class="pagination justify-content-center">
@for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
<a class="page-link"
                                       href="?page=@i&keyword=@ViewBag.Keyword&subjectId=@ViewBag.SubjectId&mode=@ViewBag.Mode&level=@ViewBag.Level&minPrice=@ViewBag.MinPrice&maxPrice=@ViewBag.MaxPrice&minRating=@ViewBag.MinRating&sortBy=@ViewBag.SortBy">@i</a>
</li>
}
                        </ul>
</nav>
}
            }
        </div>
</div>
</div>


<!-- #6: thanh so sánh nổi -->
<div id="cmpBar" class="position-fixed bottom-0 start-50 translate-middle-x mb-3 shadow-lg align-items-center gap-3"
     style="display:none;background:var(--bg,#fff);border:1px solid var(--border,#e2e8f0);border-radius:99px;padding:.6rem 1.2rem;z-index:1050;">
<span class="fw-semibold small">Đã chọn <b id="cmpCount">0</b>/3 gia sư</span>
<button id="cmpGo" class="btn btn-sm text-white fw-bold" style="background:#7c3aed;border:none;border-radius:99px;">So sánh ngay</button>
<button id="cmpClear" class="btn btn-sm btn-outline-secondary" style="border-radius:99px;">Bỏ chọn</button>
</div>

@Html.AntiForgeryToken()
<script>
    // #6: chọn so sánh
    (function () {
        const bar = document.getElementById('cmpBar');
        function ids() { return [...document.querySelectorAll('.cmp-check:checked')].map(c => c.value); }
        function refresh() {
            const n = ids().length;
            document.getElementById('cmpCount').textContent = n;
            bar.style.display = n >= 1 ? 'flex' : 'none';
        }
        document.addEventListener('change', e => {
            if (!e.target.classList.contains('cmp-check')) return;
            if (ids().length > 3) { e.target.checked = false; alert('Chỉ so sánh tối đa 3 gia sư.'); }
            refresh();
        });
        document.getElementById('cmpGo').addEventListener('click', () => {
            const v = ids();
            if (v.length < 2) { alert('Chọn ít nhất 2 gia sư để so sánh.'); return; }
            location.href = '/TutorSearch/Compare?ids=' + v.join(',');
        });
        document.getElementById('cmpClear').addEventListener('click', () => {
            document.querySelectorAll('.cmp-check:checked').forEach(c => c.checked = false);
            refresh();
        });
    })();

    // #19: tìm kiếm ngôn ngữ tự nhiên
    (function () {
        const btn = document.getElementById('nlBtn');
        const input = document.getElementById('nlQuery');
        const st = document.getElementById('nlStatus');
        async function go() {
            const q = input.value.trim();
            if (!q) return;
            st.textContent = 'AI đang phân tích câu tìm kiếm…';
            try {
                const res = await fetch('/TutorSearch/ParseQuery', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: JSON.stringify({ query: q })
                });
                const data = await res.json();
                if (data.ok) location.href = data.url;
                else st.textContent = data.message || 'Không phân tích được.';
            } catch { st.textContent = 'Lỗi mạng, thử lại nhé.'; }
        }
        btn.addEventListener('click', go);
        input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); go(); } });
    })();
</script>
