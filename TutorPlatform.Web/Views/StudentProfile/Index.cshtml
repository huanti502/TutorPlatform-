@using TutorPlatform.Core.Models
@model List<StudentReview>
@{
    var s = ViewBag.Student as AppUser;
    ViewData["Title"] = "Hồ sơ học viên " + s?.FullName;

    string LevelIcon(int xp) =>
        xp >= 2000 ? "👑" : xp >= 1000 ? "🏆" : xp >= 600 ? "⭐" : xp >= 300 ? "🔥" : xp >= 100 ? "📘" : "🌱";
}

<div class="container py-5" style="max-width:820px;">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                @if (!string.IsNullOrEmpty(s?.AvatarUrl))
                {
                    <img src="@s.AvatarUrl" alt="@s.FullName" class="rounded-circle" style="width:76px;height:76px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:76px;height:76px;background:var(--primary);color:#fff;font-size:2rem;font-weight:700;">
                        @(s?.FullName?.Substring(0, 1) ?? "H")
                    </div>
                }
                <div class="flex-grow-1">
                    <h4 class="fw-bold mb-1">@s?.FullName</h4>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;font-size:.85rem;">
                            @LevelIcon(s?.XpPoints ?? 0) @s?.XpLevel
                        </span>
                        <span class="text-muted small">@(s?.XpPoints ?? 0) XP</span>
                        <span class="text-muted small">· Tham gia @(s?.CreatedAt.ToLocalTime().ToString("MM/yyyy"))</span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-2 text-center">
                <div class="col-4">
                    <div class="fs-4 fw-bold">@ViewBag.CompletedCount</div>
                    <div class="text-muted small">Buổi đã học</div>
                </div>
                <div class="col-4">
                    <div class="fs-4 fw-bold">@(((double)ViewBag.AvgRating) > 0 ? ViewBag.AvgRating + " ★" : "—")</div>
                    <div class="text-muted small">Điểm từ gia sư</div>
                </div>
                <div class="col-4">
                    <div class="fs-4 fw-bold">@ViewBag.ReviewCount</div>
                    <div class="text-muted small">Lượt đánh giá</div>
                </div>
            </div>
        </div>
    </div>

    <h6 class="fw-bold mb-3">Đánh giá từ gia sư</h6>
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-4">
            Học viên này chưa có đánh giá nào từ gia sư.
        </div></div>
    }
    else
    {
        foreach (var r in Model)
        {
            var tutorUser = r.Booking?.TutorProfile?.User;
            <div class="card border-0 shadow-sm mb-2">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(tutorUser?.AvatarUrl))
                            {
                                <img src="@tutorUser.AvatarUrl" class="rounded-circle" style="width:34px;height:34px;object-fit:cover;" alt="@tutorUser.FullName" />
                            }
                            <span class="fw-semibold small">@(tutorUser?.FullName ?? "Gia sư")</span>
                        </div>
                        <div style="color:#f59e0b;">
                            @for (int i = 0; i < r.Rating; i++)
                            {
                                <text>★</text>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(r.Comment))
                    {
                        <p class="text-muted small mb-0 mt-2">@r.Comment</p>
                    }
                </div>
            </div>
        }
    }
</div>
