<!-- ===== HERO ===== -->
<section class="hero">
<div class="container">
<div class="row align-items-center g-5">
<div class="col-lg-6">
<div class="d-flex align-items-center gap-2 mb-3">
<span style="background:rgba(255,255,255,0.2);color:#fff;
                        font-size:0.75rem;font-weight:700;letter-spacing:0.08em;
                        padding:0.3em 0.9em;border-radius:100px;
                        text-transform:uppercase;">
Nền tảng học 1-1
                    </span>
</div>
<h1 class="mb-3">
Tìm gia sư<br>
<span style="color:rgba(255,255,255,0.75);">phù hợp nhất</span><br>
cho bạn
                </h1>
<p class="mb-4" style="font-size:1.05rem;max-width:480px;">
Kết nối học sinh với gia sư chất lượng cao.
                    Học online hoặc trực tiếp — linh hoạt theo lịch của bạn.
                </p>

                <!-- Search bar -->
<form asp-controller="Tutor" asp-action="Index" method="get">
<div class="d-flex gap-2 flex-wrap">
<div class="flex-grow-1" style="min-width:220px;max-width:380px;">
<div class="input-group"
                                 style="border-radius:10px;overflow:hidden;
                                box-shadow:0 4px 16px rgba(0,0,0,0.15);">
<span class="input-group-text bg-white border-0 ps-3">
<svg width="17" height="17" fill="none"
                                         stroke="#94A3B8" stroke-width="2" viewBox="0 0 24 24">
<circle cx="11" cy="11" r="8" />
<path d="m21 21-4.35-4.35" />
</svg>
</span>
<input type="text" name="keyword"
                                       class="form-control border-0 py-3"
                                       placeholder="Tìm theo tên, môn học..."
                                       style="font-size:0.9rem;box-shadow:none;" />
</div>
</div>
<button type="submit" class="btn btn-warning btn-lg px-4"
                                style="border-radius:10px;font-weight:700;
                            box-shadow:0 4px 16px rgba(245,158,11,0.4);">
Tìm ngay
                        </button>
</div>
</form>

                <!-- Trust badges -->
<div class="d-flex align-items-center gap-3 mt-4 flex-wrap">
@foreach (var badge in new[] { "Miễn phí đăng ký", "Gia sư được kiểm duyệt", "Đặt lịch dễ dàng" })
                    {
                        <div class="d-flex align-items-center gap-1"
                             style="color:rgba(255,255,255,0.8);font-size:0.82rem;font-weight:500;">
<svg width="15" height="15" fill="none" stroke="currentColor"
                                 stroke-width="2.5" viewBox="0 0 24 24">
<polyline points="20 6 9 17 4 12" />
</svg>
@badge
                        </div>
}
                </div>
</div>

            <!-- Hero visual -->
<div class="col-lg-6 d-none d-lg-block">
<div style="position:relative;">
<div style="background:rgba(255,255,255,0.12);
                        backdrop-filter:blur(12px);
                        border:1px solid rgba(255,255,255,0.2);
                        border-radius:var(--radius-xl);padding:2rem;">
<div class="d-flex align-items-center gap-3 mb-4">
<div class="avatar avatar-lg"
                                 style="background:linear-gradient(135deg,#fff,#E0E7FF);
                                color:var(--primary);font-size:1.8rem;">
N
                            </div>
<div>
<div style="color:#fff;font-weight:700;font-size:1.05rem;">
Nguyễn Thành Nam
                                </div>
<div style="color:rgba(255,255,255,0.7);font-size:0.82rem;">
Gia sư Toán &amp; Vật lý
                                </div>
<div class="stars mt-1" style="font-size:0.8rem;"></div>
</div>
</div>
<div class="d-flex gap-2 flex-wrap mb-3">
@foreach (var tag in new[] { "Toán học", "Vật lý", "THPT" })
                            {
                                <span style="background:rgba(255,255,255,0.15);color:#fff;
                                    font-size:0.75rem;font-weight:600;
                                    padding:0.3em 0.8em;border-radius:100px;">
@tag
                                </span>
}
                        </div>
<div class="d-flex justify-content-between align-items-center">
<div>
<div style="color:rgba(255,255,255,0.6);font-size:0.75rem;">
Học phí / giờ
                                </div>
<div style="color:#fff;font-weight:800;font-size:1.3rem;">
150.000đ
                                </div>
</div>
<span style="background:rgba(16,185,129,0.2);color:#6EE7B7;
                                font-size:0.78rem;font-weight:700;
                                padding:0.35em 0.9em;border-radius:100px;">
● Đã duyệt
                            </span>
</div>
</div>
<!-- Floating badge -->
<div style="position:absolute;top:-16px;right:-16px;
                        background:#fff;border-radius:12px;
                        padding:0.7rem 1rem;
                        box-shadow:0 8px 24px rgba(0,0,0,0.12);">
<div style="font-size:0.7rem;color:#64748B;font-weight:600;">
Đặt lịch thành công
                        </div>
<div style="font-size:0.85rem;font-weight:800;color:#10B981;">
Đã xác nhận
                        </div>
</div>
</div>
</div>
</div>
</div>
</section>

<!-- ===== GIA SƯ NỔI BẬT / GIA SƯ CỦA THÁNG ===== -->
@{
    var featured = ViewBag.FeaturedTutors as List<TutorPlatform.Web.ViewModels.FeaturedTutorVM>
?? new List<TutorPlatform.Web.ViewModels.FeaturedTutorVM>();
}
@if (featured.Any())
{
    <section class="section">
<div class="container">
<div class="text-center mb-4">
<h2 class="fw-bold mb-1"><svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> Gia sư nổi bật</h2>
<p class="text-muted">Những gia sư được đánh giá cao và dạy nhiều buổi nhất trên nền tảng</p>
</div>
<div class="row g-4">
@foreach (var f in featured)
                {
                    <div class="col-sm-6 col-lg-3">
<div class="card h-100 border-0 shadow-sm position-relative" style="border-radius:16px;overflow:hidden;">
@if (f.IsTutorOfMonth)
                            {
                                <div style="position:absolute;top:10px;right:10px;background:#7c3aed;color:#fff;font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:20px;z-index:2;"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21 1.18.54 2.03 2.03 2.03 3.79M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg> Gia sư của tháng</div>
}
                            <div class="card-body text-center p-4">
@if (!string.IsNullOrEmpty(f.AvatarUrl))
                                {
                                    <img src="@f.AvatarUrl" alt="@f.FullName" class="rounded-circle mb-2" style="width:76px;height:76px;object-fit:cover;" />
}
                                else
                                {
                                    <div class="rounded-circle mb-2 d-inline-flex align-items-center justify-content-center"
                                         style="width:76px;height:76px;background:#ede9fe;color:#7c3aed;font-size:1.6rem;font-weight:700;">
@(string.IsNullOrEmpty(f.FullName) ? "?" : f.FullName.Trim()[0].ToString().ToUpper())
                                    </div>
}
                                <h6 class="fw-bold mb-1">@f.FullName</h6>
<div class="small text-muted mb-2">@f.Education</div>
<div class="mb-2">
@if (f.ReviewCount > 0)
                                    {
                                        <span class="text-warning"></span> <b>@f.AvgRating</b>
<span class="text-muted small">(@f.ReviewCount đánh giá)</span>
}
                                    else
                                    {
                                        <span class="text-muted small">Chưa có đánh giá</span>
}
                                </div>
<div class="small text-muted mb-2">@f.CompletedSessions buổi đã dạy</div>
@if (f.Subjects.Any())
                                {
                                    <div class="mb-3">
@foreach (var s in f.Subjects)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@s</span>
}
                                    </div>
}
                                <div class="fw-bold mb-2" style="color:#7c3aed;">@f.HourlyRate.ToString("N0")đ/giờ</div>
<a href="/Tutor/Detail/@f.TutorProfileId" class="btn btn-sm w-100 text-white" style="background:#7c3aed;border:none;">Xem hồ sơ</a>
</div>
</div>
</div>
}
            </div>
</div>
</section>
}

@if (User.IsInRole("Student") && ViewBag.HasRecommendations == true)
{
    var recs = ViewBag.Recommendations as
        List<TutorPlatform.Web.Services.RecommendationService.TutorScore>
?? new();

    <section class="py-4" style="background:linear-gradient(135deg,#f0f4ff,#fafbff)">
<div class="container">
<div class="d-flex align-items-center gap-2 mb-3">
<span style="font-size:1.5rem"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a8 8 0 0 1 8 8c0 5.4-5.3 10.4-8 12C9.3 20.4 4 15.4 4 10a8 8 0 0 1 8-8z"/></svg> </span>
<div>
<h5 class="fw-bold mb-0">AI gợi ý dành riêng cho bạn</h5>
<small class="text-muted">
Dựa trên lịch sử học tập & sở thích của bạn
                    </small>
</div>
</div>

            <div class="row g-3">
@foreach (var r in recs)
                {
                    var t = r.Profile;
                    var avg = r.AvgRating;
                    <div class="col-md-6 col-lg-4">
<div class="card  h-100"
                             style="border-radius:16px;transition:transform .2s"
                             onmouseover="this.style.transform='translateY(-4px)'"
                             onmouseout="this.style.transform=''">
<div class="card-body p-4">
@* AI reason badge *@
                                <div class="mb-2">
<span class="badge rounded-pill px-3"
                                          style="background:#ede9fe;color:#7c3aed;font-size:11px">
<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a8 8 0 0 1 8 8c0 5.4-5.3 10.4-8 12C9.3 20.4 4 15.4 4 10a8 8 0 0 1 8-8z"/></svg> @r.Reason
                                    </span>
</div>

                                @* Avatar + tên *@
                                <div class="d-flex align-items-center gap-3 mb-3">
<div class="rounded-circle bg-primary text-white fw-bold
                                        d-flex align-items-center justify-content-center"
                                         style="width:48px;height:48px;font-size:20px;flex-shrink:0">
@t.User?.FullName?.FirstOrDefault()
                                    </div>
<div>
<h6 class="fw-bold mb-0">@t.User?.FullName</h6>
<small class="text-muted"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> @t.TeachingArea</small>
</div>
</div>

                                @* Huy hiệu *@
                                @if (t.TutorBadges != null && t.TutorBadges.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
@foreach (var tb in t.TutorBadges.Take(2))
                                        {
                                            <span class="badge rounded-pill"
                                                  style="background:@tb.Badge?.Color;
                                                font-size:10px;color:white">
@tb.Badge?.Icon @tb.Badge?.Name
                                            </span>
}
                                    </div>
}

                                @* Rating *@
                                <div class="d-flex align-items-center gap-1 mb-2">
@for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="text-warning" style="font-size:13px">
@(i <= Math.Round(avg) ? "" : "")
                                        </span>
}
                                    <span class="fw-semibold ms-1 small">@avg.ToString("0.#")</span>
<span class="text-muted small">
(@(t.ReceivedReviews?.Count ?? 0) đánh giá)
                                    </span>
</div>

                                @* Môn học *@
                                <div class="d-flex flex-wrap gap-1 mb-3">
@if (t.TutorSubjects != null)
                                    {
                                        foreach (var ts in t.TutorSubjects.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border"
                                                  style="font-size:11px">
@ts.Subject?.Name
                                            </span>
}
                                    }
                                </div>

                                @* Giá + CTA *@
                                <div class="d-flex justify-content-between align-items-center">
<span class="fw-bold text-primary">
@t.HourlyRate.ToString("N0")
                                        <small class="text-muted fw-normal">VNĐ/h</small>
</span>
<a href="/Tutor/Detail/@t.Id"
                                       class="btn btn-primary btn-sm px-3"
                                       style="border-radius:10px">
Xem hồ sơ
                                    </a>
</div>
</div>
</div>
</div>
}
            </div>
</div>
</section>
}

<!-- ===== STATS ===== -->
<section style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2.5rem 0;">
<div class="container">
<div class="row g-4 text-center">
@foreach (var (val, label, color) in stats)
            {
                <div class="col-6 col-md-3">
<div style="font-size:2rem;font-weight:800;color:var(--primary);font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-0.04em;">@val</div>
<div style="font-size:0.78rem;color:var(--text-muted);font-weight:600;margin-top:4px;text-transform:uppercase;letter-spacing:0.05em;">@label</div>
</div>
}
        </div>
</div>
</section>

<!-- ===== MÔN HỌC ===== -->
<section class="section">
<div class="container">
<div class="text-center mb-5">
<h2 style="font-size:1.75rem;font-weight:800;">Môn học phổ biến</h2>
<p style="color:var(--text-secondary);max-width:480px;margin:0.5rem auto 0;">
Tìm gia sư cho bất kỳ môn học nào bạn cần
            </p>
</div>
<div class="row g-3 justify-content-center">
@foreach (var (name, bg, color, path) in subjects)
            {
                <div class="col-6 col-md-4 col-lg-2">
<a asp-controller="Tutor" asp-action="Index"
                       asp-route-keyword="@name"
                       class="d-block text-center text-decoration-none p-4 card h-100 tutor-card"
                       style="border-radius:var(--radius-lg);"
                       >
<div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                             style="width:52px;height:52px;border-radius:14px;background:@bg;">
<svg width="24" height="24" fill="none" stroke="@color"
                                 stroke-width="1.8" viewBox="0 0 24 24">
<path d="@path" stroke-linecap="round" stroke-linejoin="round" />
</svg>
</div>
<div style="font-weight:700;font-size:0.9rem;color:var(--text-primary);">
@name
                        </div>
</a>
</div>
}
        </div>
</div>
</section>

<!-- ===== CÁCH HOẠT ĐỘNG ===== -->
<section class="section" style="background:var(--surface);">
<div class="container">
<div class="text-center mb-5">
<h2 style="font-size:1.75rem;font-weight:800;">Bắt đầu chỉ trong 3 bước</h2>
<p style="color:var(--text-secondary);">Đơn giản, nhanh chóng, hiệu quả</p>
</div>
<div class="row g-4">
@foreach (var (num, title, desc, bg, color, path) in steps)
            {
                <div class="col-md-4">
<div class="text-center p-4">
<div class="mx-auto mb-4 d-flex align-items-center justify-content-center"
                             style="width:64px;height:64px;border-radius:18px;background:@bg;
                            position:relative;">
<svg width="28" height="28" fill="none" stroke="@color"
                                 stroke-width="1.8" viewBox="0 0 24 24">
<path d="@path" stroke-linecap="round" stroke-linejoin="round" />
</svg>
<span style="position:absolute;top:-10px;right:-10px;
                                width:24px;height:24px;border-radius:50%;
                                background:@color;color:#fff;font-size:0.65rem;
                                font-weight:800;display:flex;
                                align-items:center;justify-content:center;">
@num
                            </span>
</div>
<h5 style="font-weight:700;margin-bottom:0.5rem;">@title</h5>
<p style="color:var(--text-secondary);font-size:0.9rem;
                            max-width:260px;margin:0 auto;">
@desc
                        </p>
</div>
</div>
}
        </div>
<div class="text-center mt-4">
<a asp-controller="Account" asp-action="Register"
               class="btn btn-primary btn-lg px-5"
               style="border-radius:12px;font-size:1rem;">
Bắt đầu miễn phí
                <svg width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2.5" viewBox="0 0 24 24">
<path d="M5 12h14M12 5l7 7-7 7" />
</svg>
</a>
</div>
</div>
</section>

<!-- ===== CTA BANNER ===== -->
@if (!User.Identity!.IsAuthenticated)
{
    <section style="background:linear-gradient(135deg,#312E81 0%,var(--primary) 50%,#0EA5E9 100%);padding:4.5rem 0;position:relative;overflow:hidden;">
<div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 80% 20%,rgba(6,182,212,0.15) 0%,transparent 60%);pointer-events:none;"></div>
<div class="container text-center" style="position:relative;">
<div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);color:#fff;border-radius:var(--radius-full);padding:6px 16px;font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1.25rem;">
<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>
Dành cho gia sư
            </div>
<h2 style="color:#fff;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);margin-bottom:0.75rem;letter-spacing:-0.03em;">
Bạn là gia sư giỏi?
            </h2>
<p style="color:rgba(255,255,255,0.75);margin-bottom:2rem;font-size:1.05rem;max-width:480px;margin-left:auto;margin-right:auto;">
Đăng ký dạy học trên Gia Sư Việt — kết nối với hàng trăm học viên ngay hôm nay.
            </p>
<a asp-controller="Account" asp-action="Register"
               class="btn btn-lg px-5"
               style="background:var(--surface);color:var(--primary);border-radius:var(--radius-md);font-weight:700;font-size:1rem;box-shadow:0 8px 24px rgba(0,0,0,0.2);border:none;">
Đăng ký làm gia sư
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
</a>
</div>
</section>
}