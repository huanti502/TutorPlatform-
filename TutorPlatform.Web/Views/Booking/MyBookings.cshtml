@model IEnumerable<TutorPlatform.Core.Models.Booking>
@{
    ViewData["Title"] = "Lịch học của tôi";
    var statusMap = new Dictionary<string, (string bg, string color, string label)>{
        {"Pending",   ("var(--warning-light)","#D97706","Chờ xác nhận")},
        {"Confirmed", ("var(--success-light)","#059669","Đã xác nhận")},
        {"Completed", ("var(--primary-light)","var(--primary)","Đã hoàn thành")},
        {"Cancelled", ("var(--danger-light)","var(--danger)","Đã huỷ")},
        {"Rejected",  ("var(--danger-light)","var(--danger)","Bị từ chối")},
    };
}

<style>
    @@keyframes pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        }
        70% {
            transform: scale(1.02);
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }
</style>

<section class="section-sm">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 style="font-weight:800;margin-bottom:0.25rem;">
                    Lịch học của tôi
                </h4>
                <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                    @Model.Count() buổi học
                </p>
            </div>
            <a asp-controller="Tutor" asp-action="Index"
               class="btn btn-primary"
               style="border-radius:10px;">
                <svg width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                </svg>
                Tìm gia sư
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4" style="border-radius:10px;">
                ✓ @TempData["Success"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="width:72px;height:72px;border-radius:var(--radius-xl);
                    background:var(--primary-light);
                    display:flex;align-items:center;justify-content:center;
                    margin:0 auto 1.25rem;">
                    <svg width="32" height="32" fill="none" stroke="var(--primary)"
                         stroke-width="1.5" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <h6 style="font-weight:700;">Chưa có lịch học nào</h6>
                <p style="color:var(--text-muted);font-size:0.875rem;">
                    Hãy tìm gia sư và đặt lịch học đầu tiên!
                </p>
                <a asp-controller="Tutor" asp-action="Index"
                   class="btn btn-primary mt-2"
                   style="border-radius:10px;">
                    Tìm gia sư ngay
                </a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var b in Model)
                {
                    var (bg, color, label) = statusMap.GetValueOrDefault(
                        b.Status, ("#F1F5F9", "#64748B", b.Status));
                    var tutorInitial = b.TutorProfile.User.FullName
                                        .FirstOrDefault().ToString().ToUpper();
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100" style="border-radius:16px;">
                            <div class="card-body p-4">

                                <!-- Header -->
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar avatar-sm">
                                            @tutorInitial
                                        </div>
                                        <div>
                                            <div style="font-weight:700;font-size:0.875rem;">
                                                @b.TutorProfile.User.FullName
                                            </div>
                                            <div style="font-size:0.75rem; color:var(--text-muted);">
                                                @b.Subject.Name
                                            </div>
                                        </div>
                                    </div>
                                    <span class="badge"
                                          style="background:@bg;color:@color;">
                                        @label
                                    </span>
                                </div>

                                <!-- Info -->
                                <div style="background:var(--bg);border-radius:10px;
                                    padding:0.75rem;margin-bottom:1rem;
                                    font-size:0.82rem;">
                                    <div class="d-flex gap-2 mb-1">
                                        <svg width="14" height="14" fill="none"
                                             stroke="var(--text-muted)" stroke-width="2"
                                             viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M12 6v6l4 2" />
                                        </svg>
                                        <span style="color:var(--text-secondary);">
                                            @b.StartTime.ToString("HH:mm dd/MM/yyyy")
                                            – @b.EndTime.ToString("HH:mm")
                                        </span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <svg width="14" height="14" fill="none"
                                             stroke="var(--text-muted)" stroke-width="2"
                                             viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                            <circle cx="12" cy="10" r="3" />
                                        </svg>
                                        <span style="color:var(--text-secondary);">
                                            @b.TeachingMode
                                        </span>
                                    </div>
                                </div>

                                <!-- Actions -->
                                @{
                                    var now = DateTime.Now;
                                    var reviewedIds = ViewBag.ReviewedIds as HashSet<int> ?? new HashSet<int>();
                                    var alreadyReviewed = reviewedIds.Contains(b.Id);
                                }



                                @* Pending: nút huỷ *@
                                @if (b.Status == "Pending")
                                {
                                    <form asp-action="Cancel" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm w-100"
                                                style="border-radius:8px;
                                            background:var(--danger-light);
                                            color:var(--danger);
                                            font-weight:600;border:none;"
                                                onclick="return confirm('Huỷ lịch học này?')">
                                            Huỷ lịch
                                        </button>
                                    </form>
                                }

                                @* Confirmed: thanh toán + bảng trắng *@
                                else if (b.Status == "Confirmed")
                                {
                                    @* DEMO: Luôn hiện nút vào lớp nếu có MeetingRoomId (kể cả chưa thanh toán) *@
                                    @if (b.MeetingRoomId != null)
                                    {
                                        <a href="https://meet.jit.si/@b.MeetingRoomId" target="_blank"
                                           class="btn btn-success btn-sm w-100 fw-bold mb-2"
                                           style="animation:pulse 1.5s infinite; border-radius:8px; padding:0.6rem;">
                                            🎥 Tham gia lớp học ngay!
                                        </a>
                                    }
                                    @if (!b.IsPaid)
                                    {
                                        <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@b.Id"
                                           class="btn btn-sm w-100 mb-2"
                                           style="border-radius:8px; background:var(--primary); color:white; font-weight:600; border:none;">
                                            💳 Thanh toán ngay
                                        </a>
                                        <form asp-controller="Package" asp-action="UseForBooking" method="post" class="mb-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id" />
                                            <button class="btn btn-sm w-100" style="border-radius:8px;background:#ede9fe;color:#6d28d9;font-weight:600;border:1px solid #ddd6fe;">
                                                📦 Dùng gói học
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="text-center mb-2">
                                            <span class="badge bg-success w-100 py-2" style="border-radius:8px;">
                                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Đã thanh toán
                                            </span>
                                        </div>
                                    }
                                    <a href="/Whiteboard/Index?bookingId=@b.Id"
                                       target="_blank"
                                       class="btn btn-sm w-100 mt-2"
                                       style="background:#1e3a5f; color:white; border-radius:8px;">
                                        🎨 Bảng Trắng
                                    </a>
                                }

                                @* Completed: nút đánh giá *@
                                else if (b.Status == "Completed")
                                {
                                    @if (alreadyReviewed)
                                    {
                                        <div class="text-center">
                                            <span class="badge w-100 py-2"
                                                  style="background:#f0fdf4; color:#059669; border-radius:8px;">
                                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Đã đánh giá
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="/Review/Create?bookingId=@b.Id"
                                           class="btn btn-sm w-100"
                                           style="border-radius:8px;
                                            background:#fef9c3; color:#854d0e;
                                            font-weight:600; border:1px solid #fde047;">
                                            <svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> Đánh giá gia sư
                                        </a>
                                    }
                                }

                                @if (b.Status == "Confirmed" || b.Status == "Completed")
                                {
                                    <a asp-controller="LessonNote" asp-action="View" asp-route-bookingId="@b.Id"
                                       class="btn btn-sm w-100 mt-2"
                                       style="background:#0d9488;color:white;border-radius:8px;">
                                        📝 Ghi chú buổi học
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>