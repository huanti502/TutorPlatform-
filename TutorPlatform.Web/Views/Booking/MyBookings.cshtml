@model IEnumerable<TutorPlatform.Core.Models.Booking>
@{
    ViewData["Title"] = "Lịch học của tôi";
    var statusMap = new Dictionary<string, (string bg, string color, string label)>{
        {"Pending",   ("var(--warning-light)","#D97706","Chờ xác nhận")},
        {"Confirmed", ("var(--success-light)","#059669","Đã xác nhận")},
        {"Completed", ("var(--primary-light)","var(--primary)","Đã hoàn thành")},
        {"Cancelled", ("var(--danger-light)","var(--danger)","Đã huỷ")},
        {"Rejected",  ("var(--danger-light)","var(--danger)","Bị từ chối")},
    };
}

<style>
@@keyframes pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        }
        70% {
            transform: scale(1.02);
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }

    /* Nút hành động gọn cho thẻ lịch học */
    .bk-primary { display:block; width:100%; text-align:center; font-weight:700; padding:.6rem; border-radius:8px; text-decoration:none; border:none; cursor:pointer; }
    .bk-pill { display:inline-flex; align-items:center; gap:6px; font-size:.78rem; font-weight:700; padding:.32rem .7rem; border-radius:20px; }
    .bk-tools { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    .bk-cell { flex:1 1 calc(50% - 4px); min-width:0; margin:0; }
    .bk-btn { width:100%; display:inline-flex; align-items:center; justify-content:center; gap:6px; font-size:.8rem; font-weight:600; padding:.45rem .4rem; border-radius:8px; text-decoration:none; background:#f8fafc; color:#475569; border:1px solid #e5e7eb; cursor:pointer; transition:background .15s; }
    .bk-btn:hover { background:#eef2f7; }
    .bk-btn.danger { color:#dc2626; background:#fef2f2; border-color:#fecaca; }
    .bk-btn.danger:hover { background:#fee2e2; }
</style>

<section class="section-sm">
<div class="container">
<div class="d-flex align-items-center justify-content-between mb-4">
<div>
<h4 style="font-weight:800;margin-bottom:0.25rem;">
Lịch học của tôi
                </h4>
<p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
@Model.Count() buổi học
                </p>
</div>
<a asp-controller="Tutor" asp-action="Index"
               class="btn btn-primary"
               style="border-radius:10px;">
<svg width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="2" viewBox="0 0 24 24">
<circle cx="11" cy="11" r="8" />
<path d="m21 21-4.35-4.35" />
</svg>
Tìm gia sư
            </a>
</div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4" style="border-radius:10px;">
@TempData["Success"]
            </div>
}

        @if (!Model.Any())
        {
            <div class="text-center py-5">
<div style="width:72px;height:72px;border-radius:var(--radius-xl);
                    background:var(--primary-light);
                    display:flex;align-items:center;justify-content:center;
                    margin:0 auto 1.25rem;">
<svg width="32" height="32" fill="none" stroke="var(--primary)"
                         stroke-width="1.5" viewBox="0 0 24 24">
<rect x="3" y="4" width="18" height="18" rx="2" />
<line x1="16" y1="2" x2="16" y2="6" />
<line x1="8" y1="2" x2="8" y2="6" />
<line x1="3" y1="10" x2="21" y2="10" />
</svg>
</div>
<h6 style="font-weight:700;">Chưa có lịch học nào</h6>
<p style="color:var(--text-muted);font-size:0.875rem;">
Hãy tìm gia sư và đặt lịch học đầu tiên!
                </p>
<a asp-controller="Tutor" asp-action="Index"
                   class="btn btn-primary mt-2"
                   style="border-radius:10px;">
Tìm gia sư ngay
                </a>
</div>
}
        else
        {
            var nowUtc = DateTime.UtcNow;
                string GroupOf(TutorPlatform.Core.Models.Booking x) =>
                    (x.Status == "Cancelled" || x.Status == "Rejected") ? "off"
                    : x.Status == "Completed" ? "done"
                    : x.StartTime > nowUtc
                        ? (x.Status == "Pending" ? "pend" : "up")
                        : "done";
                var sorted = Model
                    .Select(x => new { B = x, G = GroupOf(x) })
                    .OrderBy(x => x.G == "up" ? 0 : x.G == "pend" ? 1 : x.G == "done" ? 2 : 3)
                    .ThenBy(x => (x.G == "up" || x.G == "pend") ? x.B.StartTime.Ticks : long.MaxValue - x.B.StartTime.Ticks)
                    .ToList();
                int nUp = sorted.Count(x => x.G == "up");
                int nPend = sorted.Count(x => x.G == "pend");
                int nDone = sorted.Count(x => x.G == "done");
                int nOff = sorted.Count(x => x.G == "off");

            <div class="d-flex gap-2 flex-wrap mb-3" id="bkTabs">
<button type="button" class="btn btn-sm bk-tab active" data-tab="up">Sắp tới <span class="badge rounded-pill" style="background:#7c3aed;">@nUp</span></button>
<button type="button" class="btn btn-sm bk-tab" data-tab="pend">Chờ xác nhận <span class="badge rounded-pill bg-warning text-dark">@nPend</span></button>
<button type="button" class="btn btn-sm bk-tab" data-tab="done">Đã diễn ra <span class="badge rounded-pill bg-success">@nDone</span></button>
<button type="button" class="btn btn-sm bk-tab" data-tab="off">Đã huỷ / Từ chối <span class="badge rounded-pill bg-secondary">@nOff</span></button>
<button type="button" class="btn btn-sm bk-tab" data-tab="all">Tất cả <span class="badge rounded-pill bg-light text-dark border">@Model.Count()</span></button>
            </div>
            <div id="bkEmpty" class="text-center text-muted py-5" style="display:none;">Không có buổi học nào trong mục này.</div>

            <div class="row g-3">
@foreach (var item in sorted)
                {
                    var b = item.B;
                    var (bg, color, label) = statusMap.GetValueOrDefault(
                        b.Status, ("#F1F5F9", "#64748B", b.Status));
                    var tutorInitial = b.TutorProfile.User.FullName
                                        .FirstOrDefault().ToString().ToUpper();
                    <div class="col-md-6 col-xl-4 bk-item" data-tab="@item.G">
<div class="card h-100" style="border-radius:16px;">
<div class="card-body p-4">

                                <!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
<div class="d-flex align-items-center gap-2">
<div class="avatar avatar-sm" style="overflow:hidden;">
@if (!string.IsNullOrEmpty(b.TutorProfile.User.AvatarUrl))
{
    <img src="@b.TutorProfile.User.AvatarUrl" alt="@b.TutorProfile.User.FullName" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
}
else
{
    @tutorInitial
}
                                        </div>
<div>
<div style="font-weight:700;font-size:0.875rem;">
@b.TutorProfile.User.FullName
                                            </div>
<div style="font-size:0.75rem; color:var(--text-muted);">
@b.Subject.Name
                                            </div>
</div>
</div>
<span class="badge"
                                          style="background:@bg;color:@color;">
@label
                                    </span>
</div>

                                <!-- Info -->
<div style="background:var(--bg);border-radius:10px;
                                    padding:0.75rem;margin-bottom:1rem;
                                    font-size:0.82rem;">
<div class="d-flex gap-2 mb-1">
<svg width="14" height="14" fill="none"
                                             stroke="var(--text-muted)" stroke-width="2"
                                             viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
<circle cx="12" cy="12" r="10" />
<path d="M12 6v6l4 2" />
</svg>
<span style="color:var(--text-secondary);">
@b.StartTime.ToString("HH:mm dd/MM/yyyy")
                                            – @b.EndTime.ToString("HH:mm")
                                        </span>
</div>
<div class="d-flex gap-2">
<svg width="14" height="14" fill="none"
                                             stroke="var(--text-muted)" stroke-width="2"
                                             viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
<circle cx="12" cy="10" r="3" />
</svg>
<span style="color:var(--text-secondary);">
@b.TeachingMode
                                        </span>
</div>
</div>

                                <!-- Actions -->
@{
                                    var now = DateTime.Now;
                                    var reviewedIds = ViewBag.ReviewedIds as HashSet<int> ?? new HashSet<int>();
                                    var alreadyReviewed = reviewedIds.Contains(b.Id);
                                }



                                @* Pending: nút huỷ *@
                                @if (b.Status == "Pending")
                                {
                                    <div class="text-center small mb-2" style="color:#D97706;">⏳ Đang chờ gia sư xác nhận</div>
<a asp-action="Reschedule" asp-route-id="@b.Id" class="bk-primary mb-2"
                                       style="background:#eef2ff;color:#4f46e5;border:1px solid #c7d2fe;"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg> Đổi giờ</a>
<form asp-action="Cancel" method="post">
@Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
<button type="submit" class="bk-primary" style="background:var(--danger-light);color:var(--danger);"
                                                onclick="return confirm('Huỷ lịch học này?')">Huỷ lịch</button>
</form>
}

                                @* Confirmed: thanh toán + bảng trắng *@
                                else if (b.Status == "Confirmed")
                                {
                                    @* Nút chính: vào lớp *@
                                    @if (b.MeetingRoomId != null)
                                    {
                                        <a href="https://meet.jit.si/@b.MeetingRoomId" target="_blank"
                                           class="bk-primary" style="background:#059669;color:#fff;animation:pulse 1.5s infinite;">
Vào lớp học
                                        </a>
}

                                    @* Thanh toán / trạng thái *@
                                    @if (!b.IsPaid)
                                    {
                                        <div class="d-flex gap-2 mt-2">
<a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@b.Id"
                                               class="bk-primary" style="background:var(--primary);color:#fff;flex:1;"> Thanh toán</a>
                                            <form asp-controller="Wallet" asp-action="PayBooking" method="post" style="flex:1;display:flex;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <button type="submit" class="bk-primary" style="background:#0ea5e9;color:#fff;width:100%;border:none;"
                                                        onclick="return confirm('Thanh toán buổi học này bằng số dư ví? Tiền sẽ được giữ tới khi buổi học hoàn thành.')">Ví</button>
                                            </form>
<form asp-controller="Package" asp-action="UseForBooking" method="post" style="flex:1;margin:0;">
@Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.Id" />
<button class="bk-primary" style="background:#ede9fe;color:#6d28d9;border:1px solid #ddd6fe;"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.27 6.96 8.73 5.05 8.73-5.05M12 22.08V12"/></svg> Dùng gói</button>
</form>
</div>
}
                                    else
                                    {
                                        <div class="mt-2">
<span class="bk-pill" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;"> Đã thanh toán</span>
</div>
}

                                    @* Nút phụ gọn (lưới 2 cột) *@
                                    <div class="bk-tools">
<a href="/Whiteboard/Index?bookingId=@b.Id" target="_blank" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2a10 10 0 0 0 0 20 2 2 0 0 0 2-2v-1a2 2 0 0 1 2-2h1a5 5 0 0 0 5-5c0-5.5-4.5-10-10-10Z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/></svg> Bảng trắng</a>
<a asp-action="Reschedule" asp-route-id="@b.Id" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg> Đổi giờ</a>
<a asp-controller="LessonNote" asp-action="View" asp-route-bookingId="@b.Id" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Ghi chú</a>
@if (b.IsPaid && b.PaidByPackagePurchaseId == null)
                                        {
                                            <a asp-controller="Payment" asp-action="Receipt" asp-route-bookingId="@b.Id" target="_blank" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg> Biên nhận</a>
}
                                        <form asp-action="Cancel" method="post" class="bk-cell">
@Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
<button type="submit" class="bk-btn danger"
                                                    onclick="return confirm('Huỷ buổi học này? Nếu đã thanh toán, tiền/buổi trong gói sẽ được hoàn.')"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M18 6 6 18M6 6l12 12"/></svg> Huỷ lịch</button>
</form>
</div>
}

                                @* Completed: nút đánh giá *@
                                else if (b.Status == "Completed")
                                {
                                    @if (alreadyReviewed)
                                    {
                                        <div class="text-center">
<span class="bk-pill" style="background:#f0fdf4;color:#059669;border:1px solid #bbf7d0;"> Đã đánh giá</span>
</div>
}
                                    else
                                    {
                                        <a href="/Review/Create?bookingId=@b.Id" class="bk-primary"
                                           style="background:#fef9c3;color:#854d0e;border:1px solid #fde047;"><svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> Đánh giá gia sư</a>
}
                                    <div class="bk-tools">
<a asp-controller="LessonNote" asp-action="View" asp-route-bookingId="@b.Id" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Ghi chú</a>
@if (b.IsPaid && b.PaidByPackagePurchaseId == null)
                                        {
                                            <a asp-controller="Payment" asp-action="Receipt" asp-route-bookingId="@b.Id" target="_blank" class="bk-cell bk-btn"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg> Biên nhận</a>
}
                                    </div>
}

                            </div>
</div>
</div>
}
            </div>
}
    </div>
</section>


<style>
    .bk-tab { border: 1px solid var(--border, #e2e8f0); border-radius: 99px; color: var(--text-secondary, #475569); background: var(--bg, #fff); font-weight: 600; }
    .bk-tab .badge { font-size: .68rem; }
    .bk-tab.active { background: #f5f3ff; border-color: #7c3aed; color: #6d28d9; }
</style>
<script>
    (function () {
        const tabs = document.querySelectorAll('.bk-tab');
        const items = document.querySelectorAll('.bk-item');
        const empty = document.getElementById('bkEmpty');
        function apply(tab) {
            let shown = 0;
            items.forEach(it => {
                const ok = tab === 'all' || it.dataset.tab === tab;
                it.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            empty.style.display = shown === 0 ? 'block' : 'none';
            tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
            try { sessionStorage.setItem('bkTab', tab); } catch (e) { }
        }
        tabs.forEach(t => t.addEventListener('click', () => apply(t.dataset.tab)));
        let saved = 'up';
        try { saved = sessionStorage.getItem('bkTab') || 'up'; } catch (e) { }
        apply(saved);
    })();
</script>
