@model IEnumerable<TutorPlatform.Core.Models.Booking>
@{
    ViewData["Title"] = "Yêu cầu học";
    var statusMap = new Dictionary<string, (string bg, string color, string label)>{
        {"Pending",   ("#FFF7ED","#D97706","Chờ xác nhận")},
        {"Confirmed", ("#F0FDF4","#059669","Đã xác nhận")},
        {"Completed", ("var(--primary-light)","var(--primary)","Đã hoàn thành")},
        {"Cancelled", ("#FEF2F2","#DC2626","Đã huỷ")},
        {"Rejected",  ("#FEF2F2","#DC2626","Đã từ chối")},
    };
}

<style>
    @@keyframes pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        }

        70% {
            transform: scale(1.02);
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }
</style>

<section class="section-sm">
    <div class="container">
        <div class="mb-4">
            <h4 style="font-weight:800;margin-bottom:0.25rem;">
                Yêu cầu học
            </h4>
            <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">
                @Model.Count(b => b.Status == "Pending") yêu cầu đang chờ xác nhận
            </p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="width:72px;height:72px;border-radius:var(--radius-xl);
                    background:var(--success-light);
                    display:flex;align-items:center;justify-content:center;
                    margin:0 auto 1.25rem;">
                    <svg width="32" height="32" fill="none" stroke="#10B981"
                         stroke-width="1.5" viewBox="0 0 24 24">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                        19.79 19.79 0 0 1-8.63-3.07
                        A19.5 19.5 0 0 1 4.99 15
                        a19.79 19.79 0 0 1-3.07-8.67
                        A2 2 0 0 1 3.9 4.22h3
                        a2 2 0 0 1 2 1.72
                        c.127.96.361 1.903.7 2.81
                        a2 2 0 0 1-.45 2.11L8.09 11
                        a16 16 0 0 0 5.91 5.91l1.27-1.27
                        a2 2 0 0 1 2.11-.45
                        c.907.339 1.85.573 2.81.7
                        A2 2 0 0 1 22 17.92z" />
                    </svg>
                </div>
                <h6 style="font-weight:700;">Chưa có yêu cầu nào</h6>
                <p style="color:var(--text-muted);font-size:0.875rem;">
                    Hoàn thiện hồ sơ để học viên tìm thấy bạn!
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var b in Model)
                {
                    var (bg, color, label) = statusMap.GetValueOrDefault(
                        b.Status, ("#F1F5F9", "#64748B", b.Status));
                    var stuInitial = b.Student.FullName
                                      .FirstOrDefault().ToString().ToUpper();
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100" style="border-radius:16px;">
                            <div class="card-body p-4">

                                <!-- Header -->
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar avatar-sm"
                                             style="background:linear-gradient(135deg,#10B981,#059669);">
                                            @stuInitial
                                        </div>
                                        <div>
                                            <div style="font-weight:700; font-size:0.875rem;">
                                                @b.Student.FullName
                                            </div>
                                            <div style="font-size:0.75rem; color:var(--text-muted);">
                                                @b.Subject.Name
                                            </div>
                                        </div>
                                    </div>
                                    <span class="badge" style="background:@bg;color:@color;">
                                        @label
                                    </span>
                                </div>

                                <!-- Info -->
                                <div style="background:var(--bg);border-radius:10px;
                                    padding:0.75rem;margin-bottom:1rem;
                                    font-size:0.82rem;">
                                    <div class="d-flex gap-2 mb-1">
                                        <svg width="14" height="14" fill="none"
                                             stroke="var(--text-muted)" stroke-width="2"
                                             viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M12 6v6l4 2" />
                                        </svg>
                                        <span style="color:var(--text-secondary);">
                                            @b.StartTime.ToString("HH:mm dd/MM/yyyy")
                                            – @b.EndTime.ToString("HH:mm")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(b.Note))
                                    {
                                        <div class="d-flex gap-2 mt-2">
                                            <svg width="14" height="14" fill="none"
                                                 stroke="var(--text-muted)" stroke-width="2"
                                                 viewBox="0 0 24 24" style="flex-shrink:0;margin-top:2px;">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5
                                                a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                            </svg>
                                            <span style="color:var(--text-secondary);">
                                                @b.Note
                                            </span>
                                        </div>
                                    }
                                </div>

                                <!-- Lớp học Jitsi Meeting -->
                                @{
                                    var now = DateTime.Now;
                                    var canJoin = b.Status == "Confirmed" &&
                                                  b.MeetingRoomId != null; // DEMO: bỏ giới hạn thời gian
                                    var joinUrl = $"https://meet.jit.si/{b.MeetingRoomId}";
                                }

                                @if (b.Status == "Confirmed" && b.MeetingRoomId != null)
                                {
                                    <div class="mb-3 text-center">
                                        @if (canJoin)
                                        {
                                            @* Đang trong giờ học → Hiện nút nổi bật *@
                                            <a href="@joinUrl" target="_blank"
                                               class="btn btn-success btn-sm w-100 fw-bold"
                                               style="animation:pulse 1.5s infinite; border-radius:8px; padding:0.6rem;">
                                                🎥 Tham gia lớp học ngay!
                                            </a>
                                        }
                                        else if (now < b.StartTime.AddMinutes(-15))
                                        {
                                            @* Chưa đến giờ → Hiện đếm ngược *@
                                            <div class="text-muted small py-2 px-3" style="background:#f8f9fa; border-radius:8px; border:1px dashed #dee2e6;">
                                                🕒 Lớp mở lúc <strong>@b.StartTime.AddMinutes(-15).ToString("HH:mm")</strong>
                                                <br />
                                                <span class="countdown fw-semibold text-primary"
                                                      data-time="@b.StartTime.AddMinutes(-15).ToString("O")">
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Actions -->
                                @if (b.Status == "Pending")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button name="status" value="Confirmed" class="btn btn-sm btn-success w-50" style="border-radius:8px; font-weight:600;"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Xác nhận</button>
                                        <button name="status" value="Rejected" class="btn btn-sm btn-outline-danger w-50" style="border-radius:8px; font-weight:600;"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> Từ chối</button>
                                    </form>
                                }
                                @if (b.Status == "Confirmed")
                                {
                                    <form asp-action="Complete" method="post" class="mb-2">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button class="btn btn-sm w-100 text-white" style="border-radius:8px; background:var(--primary); font-weight:600; border:none;">🏁 Hoàn thành buổi học</button>
                                    </form>

                                    <!-- Nút Bảng Trắng mới thêm -->
                                    <a href="/Whiteboard/Index?bookingId=@b.Id"
                                       target="_blank"
                                       class="btn btn-sm w-100"
                                       style="background:#1e3a5f; color:white; border-radius:8px;">
                                        🎨 Bảng Trắng
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>