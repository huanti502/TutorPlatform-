@{
    ViewBag.Title = "Đặt lịch học";
    var tutor = ViewBag.Tutor as TutorPlatform.Core.Models.TutorProfile;
}

<div class="container py-4" style="max-width:720px; min-height:calc(100vh - 200px)">
<div class="mb-4">
<h4 class="fw-bold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> Đặt lịch học</h4>
<p class="text-muted mb-0">
Gia sư: <strong>@tutor?.User?.FullName</strong>
— <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 6v2m0 8v2"/></svg> @tutor?.HourlyRate.ToString("N0") VNĐ/giờ
        </p>
</div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="m10.29 3.86-8.15 14.1A2 2 0 0 0 3.86 21h16.28a2 2 0 0 0 1.72-3.04L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4M12 17h.01"/></svg> @TempData["Error"]</div>
    @if (TempData["Suggest"] != null && TempData["Suggest"]!.ToString() != "")
    {
        <div class="alert alert-info">
            <b>Gợi ý giờ trống gần nhất của gia sư:</b> @TempData["Suggest"]
        </div>
    }
}

    <div class="card" style="border-radius:var(--radius-lg)">
<div class="card-body p-4">
<form method="post" action="/Booking/Create" id="bookingForm">
<input type="hidden" name="tutorProfileId" value="@tutor?.Id" />

                @* Môn học *@
                <div class="mb-3">
<label class="form-label fw-semibold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"/></svg> Môn học</label>
<select name="subjectId" class="form-select" required>
<option value="">-- Chọn môn --</option>
@foreach (var ts in tutor?.TutorSubjects ?? Enumerable.Empty<TutorPlatform.Core.Models.TutorSubject>())
                        {
                            <option value="@ts.SubjectId">@ts.Subject?.Name (@ts.Subject?.Level)</option>
}
                    </select>
</div>

                @* Chọn ngày *@
                <div class="mb-3">
<label class="form-label fw-semibold"> Chọn ngày</label>
<input type="date" id="pickDate" class="form-control"
                           min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
<div id="availabilityInfo" class="mt-2"></div>
</div>

                @* Gợi ý khung giờ - hiện sau khi chọn ngày *@
                <div id="suggestedSlots" class="mb-3" style="display:none"></div>

                @* Chọn giờ - dùng select thay vì input time để tránh lỗi AM/PM *@
                <div class="row g-3 mb-3" id="timeSection">
<div class="col-6">
<label class="form-label fw-semibold"> Giờ bắt đầu</label>
<select id="startTimePicker" class="form-select">
<option value="">-- Chọn giờ --</option>
</select>
<input type="hidden" name="startTime" id="startTimeHidden" />
</div>
<div class="col-6">
<label class="form-label fw-semibold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7"/></svg> Giờ kết thúc</label>
<select id="endTimePicker" class="form-select">
<option value="">-- Chọn giờ --</option>
</select>
<input type="hidden" name="endTime" id="endTimeHidden" />
</div>
<div class="col-12">
<small class="text-muted"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M9 18h6M10 22h4M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg> Chọn ngày trước để xem khung giờ còn trống của gia sư</small>
</div>
</div>

                @* Cảnh báo trùng lịch *@
                <div id="conflictAlert" class="alert alert-danger d-none"></div>
<div id="okAlert" class="alert alert-success d-none">
<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Khung giờ này còn trống, bạn có thể đặt!
                </div>

                @* Hình thức *@
                <div class="mb-3">
<label class="form-label fw-semibold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg> Hình thức dạy</label>
<div class="d-flex gap-3">
@if (tutor?.TeachingMode is "Online" or "Both")
                        {
                            <div class="form-check">
<input class="form-check-input" type="radio"
                                       name="teachingMode" value="Online" id="modeOnline" checked />
<label class="form-check-label" for="modeOnline"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg> Online</label>
</div>
}
                        @if (tutor?.TeachingMode is "Offline" or "Both")
                        {
                            <div class="form-check">
<input class="form-check-input" type="radio"
                                       name="teachingMode" value="Offline" id="modeOffline" />
<label class="form-check-label" for="modeOffline"> Tại nhà</label>
</div>
}
                    </div>
</div>

                @* Ghi chú *@
                <div class="mb-4">
<div class="mb-3">
<label class="form-label">Lặp lại hàng tuần</label>
<select name="repeatWeeks" class="form-select">
<option value="1" selected>Không lặp (1 buổi)</option>
<option value="4">4 tuần (4 buổi cùng giờ)</option>
<option value="8">8 tuần (8 buổi cùng giờ)</option>
</select>
<div class="form-text">Các tuần bị trùng lịch sẽ tự động được bỏ qua.</div>
</div>

<label class="form-label fw-semibold"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Ghi chú (tuỳ chọn)</label>
<textarea name="note" class="form-control" rows="2"
                              placeholder="VD: Học về phần đạo hàm lớp 12..."></textarea>
</div>

                @* Tóm tắt giá *@
                <div id="priceSummary" class="alert alert-info d-none mb-4">
⏱ Thời lượng: <strong id="durationText">—</strong> |
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 6v2m0 8v2"/></svg> Học phí ước tính: <strong id="priceText">—</strong>
</div>

                @* Hint *@
                <div id="selectTimeHint" class="alert alert-warning mb-3">
<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="m10.29 3.86-8.15 14.1A2 2 0 0 0 3.86 21h16.28a2 2 0 0 0 1.72-3.04L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4M12 17h.01"/></svg> Vui lòng <strong>chọn ngày</strong> và <strong>giờ bắt đầu/kết thúc</strong> để kích hoạt nút đặt lịch.
                </div>

                <div class="d-flex gap-3">
<button type="submit" class="btn btn-primary px-5" id="submitBtn" disabled>
<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> Xác nhận đặt lịch
                    </button>
<a href="/Tutor/Detail/@tutor?.Id" class="btn btn-outline-secondary">Quay lại</a>
</div>
</form>
</div>
</div>
</div>

@section Scripts {
    <script>
const TUTOR_ID = @tutor?.Id;
        const HOURLY   = @(tutor?.HourlyRate ?? 0);

        const dateInput     = document.getElementById("pickDate");
        const startPicker   = document.getElementById("startTimePicker");
        const endPicker     = document.getElementById("endTimePicker");
        const conflictAlert = document.getElementById("conflictAlert");
        const okAlert       = document.getElementById("okAlert");
        const priceSummary  = document.getElementById("priceSummary");
        const submitBtn     = document.getElementById("submitBtn");
        const hint          = document.getElementById("selectTimeHint");

        // Tạo danh sách giờ từ 06:00 đến 22:00, bước 30 phút
        function buildTimeOptions(selectEl, startHour = 6, endHour = 22) {
            selectEl.innerHTML = "<option value=''>-- Chọn giờ --</option>";
            for (let h = startHour; h <= endHour; h++) {
                for (let m of [0, 30]) {
                    if (h === endHour && m > 0) break;
                    const hh = String(h).padStart(2, "0");
                    const mm = String(m).padStart(2, "0");
                    const val = `${hh}:${mm}`;
                    const opt = document.createElement("option");
                    opt.value = val;
                    opt.textContent = val;
                    selectEl.appendChild(opt);
                }
            }
        }

        buildTimeOptions(startPicker);
        buildTimeOptions(endPicker);

        // Khi chọn ngày → load lịch trống gia sư
        dateInput.addEventListener("change", async () => {
            const date = dateInput.value;
            if (!date) return;

            try {
                const res  = await fetch(`/Booking/GetBusySlots?tutorProfileId=${TUTOR_ID}&date=${date}`);
                const data = await res.json();
                const avail = data.availableSlots;
                const avInfo = document.getElementById("availabilityInfo");

                if (avail.length === 0) {
                    avInfo.innerHTML = `<span class="badge bg-danger"> Gia sư không làm việc ngày này</span>`;
                    document.getElementById("suggestedSlots").style.display = "none";
                    submitBtn.disabled = true;
                    return;
                }

                // Hiển thị khung giờ làm việc
                avInfo.innerHTML = "<strong> Khung giờ làm việc:</strong> " +
                    avail.map(a => `<span class="badge bg-success me-1">${a.start} – ${a.end}</span>`).join("");

                // Hiển thị giờ bận
                if (data.busySlots.length > 0) {
                    avInfo.innerHTML += " &nbsp; <strong> Đã đặt:</strong> " +
                        data.busySlots.map(b => `<span class="badge bg-danger me-1">${b.start}–${b.end}</span>`).join("");
                }

                // Lọc options trong select chỉ cho phép giờ trong khung làm việc
                filterTimeOptions(avail, data.busySlots);

                // Gợi ý slot trống
                showSuggestedSlots(avail, data.busySlots);
            } catch (e) {
                console.error("Lỗi load lịch:", e);
            }
        });

        // Lọc select chỉ hiện giờ trong khung làm việc
        function filterTimeOptions(avail, busy) {
            buildTimeOptions(startPicker);
            buildTimeOptions(endPicker);

            // Tính tập hợp phút hợp lệ
            const validMins = new Set();
            avail.forEach(a => {
                let cur = toMinutes(a.start);
                const end = toMinutes(a.end);
                while (cur < end) { validMins.add(cur); cur += 30; }
            });

            // Ẩn option không hợp lệ
            [startPicker, endPicker].forEach(sel => {
                Array.from(sel.options).forEach(opt => {
                    if (!opt.value) return;
                    if (!validMins.has(toMinutes(opt.value))) {
                        opt.disabled = true;
                        opt.style.color = "#ccc";
                    }
                });
            });
        }

        // Gợi ý slot 1 tiếng còn trống
        function showSuggestedSlots(avail, busy) {
            const box   = document.getElementById("suggestedSlots");
            const slots = [];

            avail.forEach(a => {
                let cur      = toMinutes(a.start);
                const av_end = toMinutes(a.end);
                while (cur + 60 <= av_end) {
                    const s = toTime(cur), e = toTime(cur + 60);
                    const isBusy = busy.some(b =>
toMinutes(b.start) < cur + 60 && toMinutes(b.end) > cur);
                    if (!isBusy) slots.push({ s, e });
                    cur += 30;
                }
            });

            if (slots.length === 0) { box.style.display = "none"; return; }

            box.style.display = "block";
            box.innerHTML = `
                <label class="form-label fw-semibold"> Khung giờ gợi ý còn trống:</label>
<div class="d-flex flex-wrap gap-2">
${slots.slice(0, 8).map(sl => `
                    <button type="button" class="btn btn-outline-success btn-sm slot-btn"
                            data-start="${sl.s}" data-end="${sl.e}">
${sl.s} – ${sl.e}
                    </button>`).join("")}
                </div>`;

            box.querySelectorAll(".slot-btn").forEach(btn => {
                btn.onclick = () => {
                    startPicker.value = btn.dataset.start;
                    endPicker.value   = btn.dataset.end;
                    checkConflict();
                    box.querySelectorAll(".slot-btn").forEach(b => {
                        b.classList.remove("active", "btn-success");
                        b.classList.add("btn-outline-success");
                    });
                    btn.classList.add("active", "btn-success");
                    btn.classList.remove("btn-outline-success");
                };
            });
        }

        // Kiểm tra conflict khi chọn giờ
        async function checkConflict() {
            const date  = dateInput.value;
            const start = startPicker.value;
            const end   = endPicker.value;

            if (!date || !start || !end) return;

            if (start >= end) {
                conflictAlert.classList.remove("d-none");
                conflictAlert.textContent = " Giờ kết thúc phải sau giờ bắt đầu!";
                okAlert.classList.add("d-none");
                submitBtn.disabled = true;
                return;
            }

            const startDT = `${date}T${start}:00`;
            const endDT   = `${date}T${end}:00`;

            document.getElementById("startTimeHidden").value = startDT;
            document.getElementById("endTimeHidden").value   = endDT;

            // Tính giá
            const hours = (new Date(endDT) - new Date(startDT)) / 3600000;
            document.getElementById("durationText").textContent = `${hours} giờ`;
            document.getElementById("priceText").textContent =
                (hours * HOURLY).toLocaleString("vi-VN") + " VNĐ";
            priceSummary.classList.remove("d-none");
            hint.classList.add("d-none");

            // Gọi API kiểm tra
            try {
                const res  = await fetch(`/Booking/CheckConflict?tutorProfileId=${TUTOR_ID}&start=${startDT}&end=${endDT}`);
                const data = await res.json();

                if (data.hasConflict) {
                    conflictAlert.textContent = " Giờ này đã có người đặt! Vui lòng chọn khung giờ khác.";
                    conflictAlert.classList.remove("d-none");
                    okAlert.classList.add("d-none");
                    submitBtn.disabled = true;
                } else {
                    conflictAlert.classList.add("d-none");
                    okAlert.classList.remove("d-none");
                    submitBtn.disabled = false;
                }
            } catch (e) {
                console.error("Lỗi check conflict:", e);
            }
        }

        startPicker.addEventListener("change", checkConflict);
        endPicker.addEventListener("change", checkConflict);

        function toMinutes(t) {
            const [h, m] = t.split(":").map(Number);
            return h * 60 + m;
        }
        function toTime(m) {
            return `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
        }
    </script>
}
