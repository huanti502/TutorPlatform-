@model TutorPlatform.Core.Models.Booking
@{
    ViewData["Title"] = "Đổi giờ buổi học";
    var start = Model.StartTime.AddHours(7);
    var end = Model.EndTime.AddHours(7);
}

<div class="container py-4" style="max-width:520px;">
    <a asp-action="MyBookings" class="small text-muted text-decoration-none">← Quay lại lịch học</a>
    <h3 class="mt-2 mb-1">Đổi giờ buổi học</h3>
    <p class="text-muted">Gia sư: <b>@Model.TutorProfile?.User?.FullName</b> · Môn: <b>@Model.Subject?.Name</b></p>

    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="alert alert-light border small mb-3">
                Giờ hiện tại: <b>@start.ToString("HH:mm dd/MM/yyyy")</b> – <b>@end.ToString("HH:mm")</b>.
                Sau khi đổi, buổi học sẽ chờ gia sư xác nhận lại.
            </div>

            <form asp-action="Reschedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Bắt đầu</label>
                    <input type="datetime-local" name="startTime" class="form-control"
                           value="@start.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Kết thúc</label>
                    <input type="datetime-local" name="endTime" class="form-control"
                           value="@end.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <button type="submit" class="btn w-100 text-white fw-bold" style="background:#7c3aed;border:none;">
                    Xác nhận đổi giờ
                </button>
            </form>
        </div>
    </div>
</div>
