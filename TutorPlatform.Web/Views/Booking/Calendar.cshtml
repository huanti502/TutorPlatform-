@{
    ViewBag.Title = "Lịch học";
}

<div class="container-fluid py-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<h3 class="fw-bold"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg> Lịch học của tôi</h3>
<a href="@(User.IsInRole("Tutor") ? "/Booking/TutorRequests" : "/Booking/MyBookings")"
           class="btn btn-outline-primary btn-sm"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg> Danh sách</a>
</div>

    @* Chú thích màu sắc *@
    <div class="d-flex flex-wrap gap-2 mb-3">
@foreach (var item in new[] {
            ("Chờ xác nhận","#FFA500"),("Đã xác nhận","#2196F3"),
            ("Hoàn thành","#4CAF50"),("Đã hủy","#9E9E9E"),("Bị từ chối","#F44336")
        })
        {
            <span class="badge px-3 py-2" style="background:@item.Item2">● @item.Item1</span>
}
    </div>

    <div class="card shadow-sm">
<div class="card-body">
<div id="calendar"></div>
</div>
</div>
</div>

@* Modal chi tiết *@
<div class="modal fade" id="detailModal" tabindex="-1">
<div class="modal-dialog">
<div class="modal-content">
<div class="modal-header">
<h5 class="modal-title" id="modalTitle">Chi tiết buổi học</h5>
<button class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body" id="modalBody"></div>
<div class="modal-footer">
<button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
</div>
</div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales/vi.global.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
        const cal = new FullCalendar.Calendar(document.getElementById("calendar"), {
        initialView: "dayGridMonth",
        locale: "vi",
        headerToolbar: {
        left: "prev,next today",
        center: "title",
        right: "dayGridMonth,timeGridWeek,timeGridDay,listWeek"
        },
        height: "auto",

        //  FIX: Xóa fetch thủ công. Giao phó URL cho FullCalendar,
        // nó sẽ tự động gửi "?start=...&end=..." chuẩn xác và không bị lỗi dấu cộng (+)
        events: '/Booking/GetCalendarEvents',

        eventClick: info => {
        const e = info.event, p = e.extendedProps;
        const statusMap = {
        Pending: " Chờ xác nhận", Confirmed: " Đã xác nhận",
        Completed: " Hoàn thành", Cancelled: " Đã hủy", Rejected: " Bị từ chối"
        };

        document.getElementById("modalTitle").textContent = e.title;

        // Xử lý an toàn nếu start/end bị null
        const startTimeStr = e.start ? e.start.toLocaleString("vi-VN") : "—";
        const endTimeStr = e.end ? e.end.toLocaleString("vi-VN") : "—";

        document.getElementById("modalBody").innerHTML = `
        <table class="table table-borderless mb-0">
<tr><td class="fw-semibold" width="130">Bắt đầu:</td><td>${startTimeStr}</td></tr>
<tr><td class="fw-semibold">Kết thúc:</td><td>${endTimeStr}</td></tr>
<tr><td class="fw-semibold">Trạng thái:</td><td>${statusMap[p.status] ?? p.status}</td></tr>
<tr><td class="fw-semibold">Hình thức:</td><td>${p.teachMode ?? "—"}</td></tr>
<tr><td class="fw-semibold">Ghi chú:</td><td>${p.note ?? "Không có"}</td></tr>
</table>`;
        new bootstrap.Modal(document.getElementById("detailModal")).show();
        }
        });
        cal.render();
        });
    </script>
}