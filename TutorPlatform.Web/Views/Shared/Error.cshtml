@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
    int code = ViewBag.Code ?? 0;
    var (title, desc) = code switch
    {
        404 => ("Không tìm thấy trang", "Trang bạn tìm không tồn tại hoặc đã được di chuyển."),
        403 => ("Không có quyền truy cập", "Bạn không có quyền xem nội dung này."),
        401 => ("Cần đăng nhập", "Vui lòng đăng nhập để tiếp tục."),
        500 => ("Lỗi hệ thống", "Đã có sự cố phía máy chủ. Vui lòng thử lại sau ít phút."),
        _   => ("Đã có lỗi xảy ra", "Một sự cố không mong muốn đã xảy ra.")
    };
}

<div class="container py-5">
    <div class="text-center mx-auto" style="max-width:520px;">
        <div class="d-inline-flex align-items-center justify-content-center mb-3"
             style="width:96px;height:96px;border-radius:50%;background:#f5f3ff;color:#7c3aed;">
            @if (code == 404)
            {
                <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35M8 11h6" /></svg>
            }
            else if (code == 403 || code == 401)
            {
                <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            }
            else
            {
                <svg width="44" height="44" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m10.29 3.86-8.15 14.1A2 2 0 0 0 3.86 21h16.28a2 2 0 0 0 1.72-3.04L13.71 3.86a2 2 0 0 0-3.42 0Z" /><path d="M12 9v4M12 17h.01" /></svg>
            }
        </div>
        @if (code > 0)
        {
            <div class="fw-bold" style="font-size:3rem;color:#7c3aed;line-height:1;">@code</div>
        }
        <h3 class="fw-bold mt-2">@title</h3>
        <p class="text-muted">@desc</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a href="/" class="btn text-white fw-bold" style="background:#7c3aed;border:none;">Về trang chủ</a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">Quay lại</a>
        </div>
        @if (code == 0 && !string.IsNullOrEmpty(Model?.RequestId))
        {
            <p class="text-muted small mt-4">Mã lỗi: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
