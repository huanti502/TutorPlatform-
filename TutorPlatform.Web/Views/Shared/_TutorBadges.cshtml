@model ICollection<TutorPlatform.Core.Models.TutorBadge>

@if (Model != null && Model.Any())
{
    <div class="mt-3">
<h6 class="fw-semibold text-muted mb-2"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> Huy hiệu đạt được</h6>
<div class="d-flex flex-wrap gap-2">
@foreach (var tb in Model.OrderBy(b => b.EarnedAt))
            {
                <span class="badge rounded-pill px-3 py-2 shadow-sm"
                      style="background:@tb.Badge?.Color; color:white; font-size:13px;"
                      title="@tb.Badge?.Description — Đạt: @tb.EarnedAt.ToString("dd/MM/yyyy")">
@tb.Badge?.Icon @tb.Badge?.Name
                </span>
}
        </div>
</div>
}
else
{
    <p class="text-muted small mt-2"> Chưa có huy hiệu. Hoàn thành buổi học để nhận!</p>
}