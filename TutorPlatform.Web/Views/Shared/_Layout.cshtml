    <script>
setTimeout(() => {
        ['toastSuccess', 'toastError'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.4s ease';
        setTimeout(() => el.remove(), 400);
        }
        });
        }, 5000);

        window.showToast = function (title, content, link) {
        let container = document.getElementById("toastContainer");
        if (!container) {
        container = document.createElement("div");
        container.id = "toastContainer";
        container.style.cssText = "position:fixed;bottom:24px;right:24px;z-index:var(--z-toast,1000);display:flex;flex-direction:column;gap:8px;";
        document.body.appendChild(container);
        }
        const toast = document.createElement("div");
        toast.style.cssText = `
        background:#fff;border-left:4px solid var(--primary);
        border-radius:var(--radius-md,12px);padding:14px 16px;
        min-width:300px;max-width:380px;
        box-shadow:0 10px 28px rgba(0,0,0,0.12);
        animation:slideIn .3s cubic-bezier(0.16,1,0.3,1);
        cursor:pointer;border:1px solid var(--border);border-left-width:4px;
        `;
        toast.innerHTML = `
        <div style="font-weight:700;font-size:13.5px;margin-bottom:3px;color:var(--text-primary);">${title}</div>
<div style="font-size:13px;color:var(--text-secondary);">${content}</div>
`;
        toast.onclick = () => window.location.href = link;
        container.appendChild(toast);
        setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transition = "opacity .35s ease";
        setTimeout(() => toast.remove(), 400);
        }, 5000);
        };
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
(function () {
            const badge = document.getElementById("notifBadge");
            const listEl = document.getElementById("notifList");
            const bell = document.getElementById("notifBell");
            const markAllBtn = document.getElementById("notifMarkAll");
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";
            let count = 0;

            function setBadge(n) {
            count = n;
            if (!badge) return;
            if (n > 0) { badge.textContent = n > 9 ? "9+" : n; badge.style.display = "inline-flex"; }
            else { badge.style.display = "none"; }
            }
            function esc(s){ const d=document.createElement("div"); d.textContent=s||""; return d.innerHTML; }
            function postForm(url, extra) {
            return fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: (extra ? extra + "&" : "") + "__RequestVerificationToken=" + encodeURIComponent(token)
            }).then(r => r.json());
            }
            function render(items) {
            if (!listEl) return;
            if (!items.length) { listEl.innerHTML = '<div class="notif-empty">Chưa có thông báo</div>'; return; }
            listEl.innerHTML = items.map(n => `
            <a class="notif-item ${n.isRead ? "" : "unread"}" href="${n.link}" data-id="${n.id}">
<div class="notif-item-title">${esc(n.title)}</div>
<div class="notif-item-body">${esc(n.content)}</div>
<div class="notif-item-time">${esc(n.timeAgo)}</div>
</a>`).join("");
            listEl.querySelectorAll(".notif-item").forEach(a => {
            a.addEventListener("click", function () {
            const id = this.getAttribute("data-id");
            if (this.classList.contains("unread")) {
            this.classList.remove("unread");
            postForm("/Notification/MarkRead", "id=" + id).then(d => setBadge(d.count)).catch(()=>{});
            }
            });
            });
            }
            function loadRecent() {
            fetch("/Notification/Recent").then(r => r.json()).then(d => render(d.items)).catch(()=>{});
            }

            fetch("/Notification/UnreadCount").then(r => r.json()).then(d => setBadge(d.count)).catch(()=>{});
            if (bell) bell.addEventListener("click", loadRecent);
            if (markAllBtn) markAllBtn.addEventListener("click", function (e) {
            e.preventDefault(); e.stopPropagation();
            postForm("/Notification/MarkAllRead").then(() => {
            setBadge(0);
            if (listEl) listEl.querySelectorAll(".notif-item.unread").forEach(el => el.classList.remove("unread"));
            }).catch(()=>{});
            });

            const conn = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

            conn.on("ReceiveNotification", function (data) {
            setBadge(count + 1);
            window.showToast(data.title, data.content, data.link);
            if (listEl && !listEl.querySelector(".notif-empty")) {
            const a = document.createElement("a");
            a.className = "notif-item unread";
            a.href = data.link || "/";
            a.innerHTML = `<div class="notif-item-title">${esc(data.title)}</div>
<div class="notif-item-body">${esc(data.content)}</div>
<div class="notif-item-time">Vừa xong</div>`;
            listEl.prepend(a);
            }
            });

            // ── Nhận lời thách đấu Battle từ bất kỳ trang nào ──
            const battleConn = new signalR.HubConnectionBuilder()
            .withUrl("/battleHub")
            .withAutomaticReconnect()
            .build();

            battleConn.on("ReceiveBattleInvite", function (invite) {
            window._pendingBattleInvite = invite;
            window.showToast(
            ` ${invite.challengerName} thách đấu!`,
            `Môn: ${invite.subjectName} · Cấp: ${invite.level} — <a href="/Battle">Vào Battle để trả lời</a>`,
            "/Battle"
            );
            });

            battleConn.start().catch(e => console.error("Battle SignalR:", e));
            window._battleConn = battleConn;

            conn.start().catch(e => console.error("Notif SignalR:", e));
            })();
        </script>

        <script>
function updateCountdowns() {
            document.querySelectorAll('.countdown').forEach(el => {
            const target = new Date(el.dataset.time);
            const diff = target - new Date();
            if (diff <= 0) {
            el.textContent = "Đã đến giờ! Tải lại trang.";
            el.style.color = "var(--danger)";
            return;
            }
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            el.textContent = h > 0 ? `Còn ${h}h ${m}p` : m > 0 ? `Còn ${m}p ${s}s` : `Còn ${s}s`;
            });
            }
            setInterval(updateCountdowns, 1000);
            updateCountdowns();

            async function checkUpcomingClass() {
            try {
            const res = await fetch("/Booking/GetUpcoming");
            const data = await res.json();
            if (data.hasUpcoming) {
            window.showToast("Sắp đến giờ học!", `${data.subjectName} với ${data.partnerName} lúc ${data.startTime}`, data.joinUrl);
            if (Notification.permission === "granted") {
            new Notification("Gia Sư Việt nhắc lịch học!", { body: `${data.subjectName} - ${data.startTime}`, icon: "/favicon.ico" });
            }
            }
            } catch (e) { console.error("Lỗi khi check lịch học:", e); }
            }
            if (Notification.permission === "default") Notification.requestPermission();
            setInterval(checkUpcomingClass, 60000);
            checkUpcomingClass();
        </script>
}

    @await RenderSectionAsync("Scripts", required: false)

    <div id="page-loader"></div>
<script>
(function () {
            var loader = document.getElementById('page-loader');
            function show() { if (loader) loader.classList.add('active'); }
            // Hiện thanh loading khi rời trang (bấm link nội bộ, submit form)
            window.addEventListener('beforeunload', show);
            document.addEventListener('submit', function (e) {
                if (e.target && e.target.method && e.target.method.toLowerCase() === 'post') show();
            }, true);
        })();

        // PWA: đăng ký service worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { });
            });
        }

        // Dark mode toggle (#14)
        (function () {
            var btn = document.getElementById('themeToggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var root = document.documentElement;
                var dark = root.getAttribute('data-theme') === 'dark';
                if (dark) { root.removeAttribute('data-theme'); }
                else { root.setAttribute('data-theme', 'dark'); }
                try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) { }
            });
        })();
    </script>
