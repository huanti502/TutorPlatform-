@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@model IEnumerable<TutorPlatform.Core.Models.TutorProfile>
@{
    ViewData["Title"] = "Duyệt gia sư";
}
<div class="container-fluid py-4 px-4">

    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <a href="/Admin" class="d-inline-flex align-items-center gap-1" style="color:var(--text-muted);text-decoration:none;font-size:0.875rem;font-weight:500;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            Dashboard
        </a>
        <div>
            <h4 style="font-weight:800;margin:0;letter-spacing:-0.03em;">Duyệt hồ sơ gia sư</h4>
            <p style="color:var(--text-muted);font-size:0.85rem;margin:2px 0 0;">@Model.Count() hồ sơ chờ duyệt</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            <h6 style="font-weight:700;color:var(--text-secondary);">Không có hồ sơ nào chờ duyệt</h6>
            <p style="color:var(--text-muted);font-size:0.875rem;">Tất cả hồ sơ gia sư đã được xử lý.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="avatar avatar-md">@t.User?.FullName.FirstOrDefault()</div>
                                <div>
                                    <h6 style="font-weight:700;margin:0;font-size:0.95rem;color:var(--text-primary);">@t.User?.FullName</h6>
                                    <div style="font-size:0.78rem;color:var(--text-muted);">@t.User?.Email</div>
                                </div>
                                <span class="status-badge status-pending ms-auto">Chờ duyệt</span>
                            </div>

                            <div class="mb-3" style="font-size:0.82rem;color:var(--text-secondary);">
                                <div class="mb-1"><span style="color:var(--text-muted);font-weight:500;">Học vấn:</span> @t.Education</div>
                                <div class="mb-1"><span style="color:var(--text-muted);font-weight:500;">Kinh nghiệm:</span> @t.ExperienceYears năm</div>
                                <div class="mb-1"><span style="color:var(--text-muted);font-weight:500;">Học phí:</span> @t.HourlyRate.ToString("N0")đ/h</div>
                                <div class="mb-1"><span style="color:var(--text-muted);font-weight:500;">Khu vực:</span> @t.TeachingArea</div>
                            </div>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var ts in t.TutorSubjects)
                                {
                                    <span class="badge badge-soft-primary">@ts.Subject?.Name</span>
                                }
                            </div>

                            @if (t.Certificates.Any())
                            {
                                <div class="mb-3">
                                    <div style="font-size:0.75rem;color:var(--text-muted);font-weight:600;margin-bottom:5px;">Chứng chỉ đính kèm</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var c in t.Certificates)
                                        {
                                            <a href="@c.FilePath" target="_blank" rel="noopener" class="badge badge-soft-info d-inline-flex align-items-center gap-1" style="text-decoration:none;">
                                                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
                                                @c.Title
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <form method="post" action="/Admin/ApproveTutor" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tutorId" value="@t.Id">
                                    <button class="btn btn-success w-100">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                                        Duyệt
                                    </button>
                                </form>
                                <button class="btn btn-outline-danger flex-grow-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rejectModal"
                                        onclick="document.getElementById('rejectTutorId').value='@t.Id'">
                                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                                    Từ chối
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal từ chối -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border:none;border-radius:var(--radius-lg);box-shadow:var(--shadow-xl);">
            <form method="post" action="/Admin/RejectTutor">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom:1px solid var(--border);">
                    <h5 class="modal-title d-flex align-items-center gap-2" style="font-size:1.05rem;font-weight:700;">
                        <svg width="18" height="18" fill="none" stroke="var(--danger)" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                        Từ chối hồ sơ
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="tutorId" id="rejectTutorId">
                    <label class="form-label">Lý do từ chối</label>
                    <textarea name="reason" class="form-control" rows="3" placeholder="VD: Hồ sơ chưa đầy đủ, thiếu chứng chỉ..."></textarea>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>
