@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@model IEnumerable<TutorPlatform.Core.Models.AppUser>
@{
    ViewData["Title"] = "Quản lý người dùng";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">👥 Quản lý người dùng</h3>
            <p class="text-muted mb-0">@Model.Count() tài khoản</p>
        </div>
        <a href="/Admin" class="btn btn-outline-secondary">← Dashboard</a>
    </div>

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body d-flex gap-3">
            <input name="search" value="@ViewBag.Search" type="text"
                   class="form-control" placeholder="🔍 Tìm tên hoặc email...">
            <select name="role" class="form-select" style="max-width:160px">
                <option value="">Tất cả Role</option>
                <option value="Student" selected="@(ViewBag.Role == "Student" ? "selected" : null)">Student</option>
                <option value="Tutor" selected="@(ViewBag.Role == "Tutor" ? "selected" : null)">Tutor</option>
                <option value="Admin" selected="@(ViewBag.Role == "Admin" ? "selected" : null)">Admin</option>
            </select>
            <button class="btn btn-primary px-4">Lọc</button>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="">
                    <tr>
                        <th class="ps-4">Người dùng</th>
                        <th>Role</th>
                        <th>SĐT</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a href="/Admin/UserDetail/@u.Id"
                                   class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center
                                        justify-content-center fw-bold"
                                         style="width:38px;height:38px;font-size:14px;flex-shrink:0">
                                        @u.FullName.FirstOrDefault()
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@u.FullName</div>
                                        <div class="text-muted small">@u.Email</div>
                                    </div>
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-@(u.Role == "Tutor" ? "success" : u.Role == "Admin" ? "danger" : "primary")">
                                    @u.Role
                                </span>
                            </td>
                            <td class="text-muted">@(u.PhoneNumber ?? "—")</td>
                            <td class="text-muted small">@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@(u.IsLocked ? "danger" : "success")">
                                    @(u.IsLocked ? "Đã khoá" : "Hoạt động")
                                </span>
                            </td>
                            <td class="pe-4">
                                <div class="d-flex gap-2 align-items-center">
                                    <a href="/Admin/UserDetail/@u.Id"
                                       class="btn btn-sm btn-outline-primary">Xem</a>
                                    <form method="post" action="/Admin/ToggleLock" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id">
                                        <button class="btn btn-sm btn-@(u.IsLocked ? "success" : "danger")">
                                            @(u.IsLocked ? "Mở khoá" : "Khoá")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>