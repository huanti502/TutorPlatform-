@using TutorPlatform.Web.Services
@model ReportData
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo cáo thống kê";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;

    string VnStatus(string s) => s switch
    {
        "Pending" => "Chờ duyệt",
        "Confirmed" => "Đã xác nhận",
        "Completed" => "Hoàn thành",
        "Cancelled" => "Đã huỷ",
        "Rejected" => "Bị từ chối",
        _ => s
    };
}

<div class="container-fluid py-4 px-4">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
<div>
<h4 style="font-weight:800;margin:0;letter-spacing:-0.03em;">Báo cáo thống kê</h4>
<p style="color:var(--text-muted);font-size:0.85rem;margin:2px 0 0;">
Tổng hợp số liệu hệ thống và xuất ra Excel
            </p>
</div>
<a class="btn btn-primary d-inline-flex align-items-center gap-2"
           href="/Admin/ExportExcel?from=@from.ToString("yyyy-MM-dd")&to=@to.ToString("yyyy-MM-dd")">
<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
Tải báo cáo Excel
        </a>
</div>

    <!-- Bộ lọc khoảng thời gian -->
<div class="card mb-4">
<div class="card-body">
<form method="get" action="/Admin/Reports" class="row g-2 align-items-end">
<div class="col-12 col-sm-4 col-lg-3">
<label class="form-label" style="font-size:0.8rem;font-weight:600;">Từ ngày</label>
<input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" />
</div>
<div class="col-12 col-sm-4 col-lg-3">
<label class="form-label" style="font-size:0.8rem;font-weight:600;">Đến ngày</label>
<input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" />
</div>
<div class="col-12 col-sm-4 col-lg-3">
<button type="submit" class="btn btn-outline-primary w-100">Áp dụng</button>
</div>
</form>
</div>
</div>

    <!-- KPI -->
<div class="row g-3 mb-4">
<div class="col-6 col-lg-3">
<div class="stat-card h-100">
<div class="stat-value" style="color:var(--primary);">@Model.TotalBookings</div>
<div class="stat-label">Lịch đặt (trong kỳ)</div>
</div>
</div>
<div class="col-6 col-lg-3">
<div class="stat-card h-100">
<div class="stat-value" style="color:var(--success-dark);">@Model.CompletedBookings</div>
<div class="stat-label">Buổi hoàn thành</div>
</div>
</div>
<div class="col-6 col-lg-3">
<div class="stat-card h-100">
<div class="stat-value" style="color:var(--info);">@Model.TotalTutors</div>
<div class="stat-label">Gia sư · @Model.PendingTutors chờ duyệt</div>
</div>
</div>
<div class="col-6 col-lg-3">
<div class="stat-card h-100">
<div class="stat-value" style="color:#f59e0b;">@Model.TotalRevenue.ToString("#,##0")₫</div>
<div class="stat-label">Doanh thu ước tính</div>
</div>
</div>
</div>

    <div class="row g-3">
<!-- Doanh thu theo tháng -->
<div class="col-lg-7">
<div class="card h-100">
<div class="card-body">
<h6 style="font-weight:700;margin:0 0 0.75rem;">Doanh thu theo tháng</h6>
<div class="table-responsive">
<table class="table table-sm align-middle mb-0">
<thead>
<tr style="font-size:0.78rem;color:var(--text-muted);">
<th>Tháng</th>
<th class="text-end">Số buổi</th>
<th class="text-end">Doanh thu (VNĐ)</th>
</tr>
</thead>
<tbody>
@if (!Model.Monthly.Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted py-3">Không có dữ liệu</td></tr>
}
                                @foreach (var m in Model.Monthly)
                                {
                                    <tr>
<td>@m.Month.ToString("00")/@m.Year</td>
<td class="text-end">@m.Count</td>
<td class="text-end">@m.Revenue.ToString("#,##0")</td>
</tr>
}
                            </tbody>
</table>
</div>
</div>
</div>
</div>

        <!-- Lịch đặt theo trạng thái -->
<div class="col-lg-5">
<div class="card h-100">
<div class="card-body">
<h6 style="font-weight:700;margin:0 0 0.75rem;">Lịch đặt theo trạng thái</h6>
<div class="d-flex flex-column gap-2">
@if (!Model.ByStatus.Any())
                        {
                            <div class="text-muted text-center py-3">Không có dữ liệu</div>
}
                        @foreach (var st in Model.ByStatus)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1"
                                 style="border-bottom:1px solid var(--border-subtle);">
<span style="font-size:0.85rem;">@VnStatus(st.Status)</span>
<span style="font-weight:700;">@st.Count</span>
</div>
}
                    </div>
</div>
</div>
</div>

        <!-- Top gia sư -->
<div class="col-lg-7">
<div class="card">
<div class="card-body">
<h6 style="font-weight:700;margin:0 0 0.75rem;">Top gia sư</h6>
<div class="table-responsive">
<table class="table table-sm align-middle mb-0">
<thead>
<tr style="font-size:0.78rem;color:var(--text-muted);">
<th>#</th>
<th>Họ tên</th>
<th class="text-end">Số buổi</th>
<th class="text-end">Rating</th>
</tr>
</thead>
<tbody>
@{
                                    var rank = 1;
                                }
                                @foreach (var t in Model.TopTutors)
                                {
                                    <tr>
<td>@(rank++)</td>
<td>
<div style="font-weight:600;font-size:0.85rem;">@t.Name</div>
<div style="color:var(--text-muted);font-size:0.72rem;">@t.Area</div>
</td>
<td class="text-end">@t.Sessions</td>
<td class="text-end">@(t.AvgRating > 0 ? $" {t.AvgRating:0.0}" : "—")</td>
</tr>
}
                            </tbody>
</table>
</div>
</div>
</div>
</div>

        <!-- Môn học phổ biến -->
<div class="col-lg-5">
<div class="card">
<div class="card-body">
<h6 style="font-weight:700;margin:0 0 0.75rem;">Môn học phổ biến</h6>
<div class="d-flex flex-column gap-2">
@if (!Model.Subjects.Any())
                        {
                            <div class="text-muted text-center py-3">Không có dữ liệu</div>
}
                        @foreach (var s in Model.Subjects)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1"
                                 style="border-bottom:1px solid var(--border-subtle);">
<span style="font-size:0.85rem;">@s.Subject</span>
<span style="font-weight:700;">@s.TutorCount gia sư</span>
</div>
}
                    </div>
</div>
</div>
</div>
</div>
</div>
