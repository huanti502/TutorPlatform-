@{
    ViewData["Title"] = "Thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="mb-4">Thống kê nâng cao</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Tổng buổi học</div>
            <div class="fs-4 fw-bold">@ViewBag.TotalBookings</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Đã hoàn thành</div>
            <div class="fs-4 fw-bold text-success">@ViewBag.Completed</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Tỉ lệ hoàn thành</div>
            <div class="fs-4 fw-bold" style="color:#7c3aed;">@ViewBag.CompletionRate%</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Tỉ lệ huỷ/từ chối</div>
            <div class="fs-4 fw-bold text-danger">@ViewBag.CancelRate%</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3">Đăng ký người dùng theo tháng</h6>
            <canvas id="regChart" height="140"></canvas>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3">Trạng thái buổi học</h6>
            <canvas id="statusChart" height="180"></canvas>
        </div></div>
    </div>
    <div class="col-12">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h6 class="fw-bold mb-3">Top môn học theo số buổi</h6>
            <canvas id="subjectChart" height="90"></canvas>
        </div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const purple = '#7c3aed';
        new Chart(document.getElementById('regChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.RegLabels),
                datasets: [{ label: 'Đăng ký', data: @Html.Raw(ViewBag.RegData),
                    borderColor: purple, backgroundColor: 'rgba(124,58,237,.12)', fill: true, tension: .35 }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Hoàn thành', 'Đã xác nhận', 'Chờ', 'Đã huỷ', 'Từ chối'],
                datasets: [{ data: @Html.Raw(ViewBag.StatusData),
                    backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#9ca3af'] }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        new Chart(document.getElementById('subjectChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(ViewBag.SubjectLabels),
                datasets: [{ label: 'Số buổi', data: @Html.Raw(ViewBag.SubjectData), backgroundColor: purple, borderRadius: 6 }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
