@model List<TutorPlatform.Web.Controllers.AdminController.SentimentItem>
@{
    ViewData["Title"] = "Cảm xúc đánh giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    bool aiOk = ViewBag.AiOk ?? true;
}

<div class="d-flex justify-content-between align-items-end mb-4">
<div>
<h3 class="mb-1"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M12 2a4 4 0 0 0-4 4 4 4 0 0 0-3 6.5A4 4 0 0 0 7 20a4 4 0 0 0 5 1 4 4 0 0 0 5-1 4 4 0 0 0 2-7.5A4 4 0 0 0 16 6a4 4 0 0 0-4-4Z"/><path d="M12 2v19"/></svg> AI phân tích cảm xúc đánh giá</h3>
<p class="text-muted mb-0">AI đọc @Model.Count đánh giá gần nhất, phân loại cảm xúc và cảnh báo gia sư bị phàn nàn.</p>
</div>
</div>

@if (!aiOk)
{
    <div class="alert alert-warning"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="m10.29 3.86-8.15 14.1A2 2 0 0 0 3.86 21h16.28a2 2 0 0 0 1.72-3.04L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4M12 17h.01"/></svg> AI đang bận — kết quả dưới đây phân loại tạm theo số sao. Tải lại trang để thử AI lần nữa.</div>
}

<div class="row g-3 mb-4">
<div class="col-4">
<div class="card border-0 shadow-sm"><div class="card-body">
<div class="text-muted small"> Tích cực</div>
<div class="fs-3 fw-bold text-success">@ViewBag.Positive</div>
</div></div>
</div>
<div class="col-4">
<div class="card border-0 shadow-sm"><div class="card-body">
<div class="text-muted small"> Trung lập</div>
<div class="fs-3 fw-bold text-secondary">@ViewBag.Neutral</div>
</div></div>
</div>
<div class="col-4">
<div class="card border-0 shadow-sm"><div class="card-body">
<div class="text-muted small"> Tiêu cực</div>
<div class="fs-3 fw-bold text-danger">@ViewBag.Negative</div>
</div></div>
</div>
</div>

<div class="row g-4">
<div class="col-lg-5">
<div class="card border-0 shadow-sm h-100"><div class="card-body">
<h6 class="fw-bold mb-3">Tỉ lệ cảm xúc</h6>
<canvas id="sentChart" height="200"></canvas>
</div></div>
</div>
<div class="col-lg-7">
<div class="card border-0 shadow-sm h-100"><div class="card-body">
<h6 class="fw-bold mb-3"> Gia sư cần chú ý (≥ 2 đánh giá tiêu cực)</h6>
@{ var flagged = ViewBag.Flagged as System.Collections.IEnumerable; int flaggedCount = 0; }
            <table class="table table-sm align-middle">
<thead><tr><th>Gia sư</th><th>Số ĐG tiêu cực</th><th></th></tr></thead>
<tbody>
@foreach (dynamic f in flagged!)
                {
                    flaggedCount++;
                    <tr>
<td class="fw-semibold">@f.Tutor</td>
<td><span class="badge bg-danger">@f.Count</span></td>
<td><a href="/Tutor/Detail/@f.TutorProfileId" class="small">Xem hồ sơ →</a></td>
</tr>
}
                </tbody>
</table>
@if (flaggedCount == 0)
            {
                <p class="text-muted small mb-0"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align:-2px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Không có gia sư nào bị phàn nàn nhiều trong lô đánh giá gần đây.</p>
}
        </div></div>
</div>

    <div class="col-12">
<div class="card border-0 shadow-sm"><div class="card-body">
<h6 class="fw-bold mb-3">Chi tiết đánh giá đã phân tích</h6>
<div class="table-responsive">
<table class="table table-sm align-middle">
<thead><tr><th>Gia sư</th><th>Sao</th><th>Bình luận</th><th>Cảm xúc</th></tr></thead>
<tbody>
@foreach (var r in Model)
                    {
                        var (bg, label) = r.Label switch
                        {
                            "positive" => ("bg-success", "Tích cực"),
                            "negative" => ("bg-danger", "Tiêu cực"),
                            _ => ("bg-secondary", "Trung lập")
                        };
                        <tr>
<td style="white-space:nowrap;">@r.Tutor</td>
<td style="white-space:nowrap;">@r.Rating </td>
<td class="small">@r.Comment</td>
<td><span class="badge @bg">@label</span></td>
</tr>
}
                    </tbody>
</table>
</div>
</div></div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
new Chart(document.getElementById('sentChart'), {
            type: 'doughnut',
            data: {
                labels: ['Tích cực', 'Trung lập', 'Tiêu cực'],
                datasets: [{ data: [@ViewBag.Positive, @ViewBag.Neutral, @ViewBag.Negative],
                    backgroundColor: ['#10b981', '#9ca3af', '#ef4444'] }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });
    </script>
}
