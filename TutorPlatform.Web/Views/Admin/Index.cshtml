@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@{
    ViewData["Title"] = "Admin Dashboard";
    var labels = (ViewBag.MonthlyLabels as List<string>) ?? new();
    var revenue = (ViewBag.MonthlyRevenue as List<long>) ?? new();
    var counts = (ViewBag.MonthlyCount as List<int>) ?? new();
}

<div class="container-fluid py-4">
    <h3 class="fw-bold mb-4">⚙️ Admin Dashboard</h3>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card  bg-primary text-white">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="fs-1">👥</span>
                    <div>
                        <div class="h3 mb-0 fw-bold">@ViewBag.TotalUsers</div>
                        <div class="small opacity-75">Tổng người dùng</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card  bg-success text-white">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="fs-1"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> </span>
                    <div>
                        <div class="h3 mb-0 fw-bold">@ViewBag.TotalTutors</div>
                        <div class="small opacity-75">Gia sư <span class="badge bg-warning text-dark">@ViewBag.PendingTutors chờ duyệt</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card  bg-info text-white">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="fs-1"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> </span>
                    <div>
                        <div class="h3 mb-0 fw-bold">@ViewBag.TotalBookings</div>
                        <div class="small opacity-75">Lịch đặt (@ViewBag.CompletedBookings hoàn thành)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card  bg-warning text-dark">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="fs-1"><svg width="14" height="14" fill="#F59E0B" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg> </span>
                    <div>
                        <div class="h3 mb-0 fw-bold">@ViewBag.TotalReviews</div>
                        <div class="small">Đánh giá</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Biểu đồ doanh thu -->
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">📈 Thống kê 6 tháng gần nhất</div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ môn học phổ biến -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">📚 Môn học phổ biến</div>
                <div class="card-body">
                    <canvas id="subjectChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Gia sư chờ duyệt -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">⏳ Gia sư chờ duyệt</span>
                    @if ((int)ViewBag.PendingTutors > 0)
                    {
                        <a href="/Admin/PendingTutors" class="btn btn-warning btn-sm">
                            Xem @ViewBag.PendingTutors hồ sơ →
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    @if ((int)ViewBag.PendingTutors == 0)
                    {
                        <div class="text-center text-muted py-4"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Không có hồ sơ chờ duyệt</div>
                    }
                </div>
            </div>
        </div>

        <!-- Người dùng mới -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">🆕 Người dùng mới (30 ngày)</div>
                <div class="list-group list-group-flush">
                    @foreach (var u in (ViewBag.NewUsers as List<TutorPlatform.Core.Models.AppUser> ?? new()))
                    {
                        <div class="list-group-item d-flex align-items-center gap-2">
                            <img src="@(u.AvatarUrl ?? "/images/default-avatar.png")"
                                 class="rounded-circle" width="36" height="36" style="object-fit:cover">
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">@u.FullName</div>
                                <div class="text-muted" style="font-size:0.75rem">@u.Email</div>
                            </div>
                            <span class="badge bg-@(u.Role == "Tutor" ? "success" : "primary")">@u.Role</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Biểu đồ doanh thu
        new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
        datasets: [
        {
        label: 'Số buổi học',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(counts)),
        backgroundColor: 'rgba(13,110,253,0.2)',
        borderColor: 'rgba(13,110,253,1)',
        borderWidth: 2,
        type: 'line',
        yAxisID: 'y1'
        },
        {
        label: 'Doanh thu (VNĐ)',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenue)),
        backgroundColor: 'rgba(25,135,84,0.7)',
        borderRadius: 6,
        yAxisID: 'y'
        }
        ]
        },
        options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: {
        y: { position: 'left', ticks: { callback: v => v.toLocaleString('vi') + 'đ' } },
        y1: { position: 'right', grid: { drawOnChartArea: false } }
        }
        }
        });

        // Biểu đồ môn học
        fetch('/Admin/StatsApi').then(r => r.json()).then(data => {
        const subjects = data.subjectPopularity;
        new Chart(document.getElementById('subjectChart'), {
        type: 'doughnut',
        data: {
        labels: subjects.map(s => s.subject),
        datasets: [{
        data: subjects.map(s => s.count),
        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#0dcaf0', '#6f42c1']
        }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
        });
        });
    </script>
}