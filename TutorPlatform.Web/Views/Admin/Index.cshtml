@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@{
    ViewData["Title"] = "Admin Dashboard";
    var labels = (ViewBag.MonthlyLabels as List<string>) ?? new();
    var revenue = (ViewBag.MonthlyRevenue as List<long>) ?? new();
    var counts = (ViewBag.MonthlyCount as List<int>) ?? new();
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h4 style="font-weight:800;margin:0;letter-spacing:-0.03em;">Admin Dashboard</h4>
        <p style="color:var(--text-muted);font-size:0.85rem;margin:2px 0 0;">Tổng quan hệ thống</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--primary-light);color:var(--primary);">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87m-4-12a4 4 0 0 1 0 7.75" /></svg>
                    </div>
                    <div>
                        <div class="stat-value" style="color:var(--primary);">@ViewBag.TotalUsers</div>
                        <div class="stat-label">Tổng người dùng</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--success-light);color:var(--success-dark);">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                    </div>
                    <div>
                        <div class="stat-value" style="color:var(--success-dark);">@ViewBag.TotalTutors</div>
                        <div class="stat-label">Gia sư</div>
                        @if ((int)ViewBag.PendingTutors > 0)
                        {
                            <span class="status-badge status-pending mt-1">@ViewBag.PendingTutors chờ duyệt</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--info-light);color:var(--info);">
                        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    </div>
                    <div>
                        <div class="stat-value" style="color:var(--info);">@ViewBag.TotalBookings</div>
                        <div class="stat-label">Lịch đặt · @ViewBag.CompletedBookings xong</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:var(--warning-light);color:var(--warning-dark);">
                        <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" /></svg>
                    </div>
                    <div>
                        <div class="stat-value" style="color:var(--warning-dark);">@ViewBag.TotalReviews</div>
                        <div class="stat-label">Đánh giá</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Biểu đồ doanh thu -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-body">
                    <h6 style="font-weight:700;margin:0 0 1rem;">Thống kê 6 tháng gần nhất</h6>
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ môn học phổ biến -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 style="font-weight:700;margin:0 0 1rem;">Môn học phổ biến</h6>
                    <canvas id="subjectChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Gia sư chờ duyệt -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 style="font-weight:700;margin:0;">Gia sư chờ duyệt</h6>
                        @if ((int)ViewBag.PendingTutors > 0)
                        {
                            <a href="/Admin/PendingTutors" class="btn btn-sm btn-outline-primary">
                                Xem @ViewBag.PendingTutors hồ sơ
                            </a>
                        }
                    </div>
                    @if ((int)ViewBag.PendingTutors == 0)
                    {
                        <div class="text-center py-4" style="color:var(--text-muted);">
                            <svg width="28" height="28" fill="none" stroke="var(--success)" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                            <div class="mt-2" style="font-size:0.875rem;">Không có hồ sơ chờ duyệt</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Người dùng mới -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h6 style="font-weight:700;margin:0 0 0.75rem;">Người dùng mới (30 ngày)</h6>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var u in (ViewBag.NewUsers as List<TutorPlatform.Core.Models.AppUser> ?? new()))
                        {
                            <div class="d-flex align-items-center gap-2 py-1" style="border-bottom:1px solid var(--border-subtle);">
                                @if (!string.IsNullOrEmpty(u.AvatarUrl))
                                {
                                    <img src="@u.AvatarUrl" alt="@u.FullName" class="avatar avatar-sm avatar-img" />
                                }
                                else
                                {
                                    <div class="avatar avatar-sm">@u.FullName.FirstOrDefault()</div>
                                }
                                <div class="flex-grow-1">
                                    <div style="font-weight:700;font-size:0.85rem;">@u.FullName</div>
                                    <div style="color:var(--text-muted);font-size:0.75rem;">@u.Email</div>
                                </div>
                                <span class="badge @(u.Role == "Tutor" ? "badge-soft-success" : "badge-soft-primary")">@u.Role</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Biểu đồ doanh thu
        new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
        datasets: [
        {
        label: 'Số buổi học',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(counts)),
        backgroundColor: 'rgba(13,110,253,0.2)',
        borderColor: 'rgba(13,110,253,1)',
        borderWidth: 2,
        type: 'line',
        yAxisID: 'y1'
        },
        {
        label: 'Doanh thu (VNĐ)',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenue)),
        backgroundColor: 'rgba(25,135,84,0.7)',
        borderRadius: 6,
        yAxisID: 'y'
        }
        ]
        },
        options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: {
        y: { position: 'left', ticks: { callback: v => v.toLocaleString('vi') + 'đ' } },
        y1: { position: 'right', grid: { drawOnChartArea: false } }
        }
        }
        });

        // Biểu đồ môn học
        fetch('/Admin/StatsApi').then(r => r.json()).then(data => {
        const subjects = data.subjectPopularity;
        new Chart(document.getElementById('subjectChart'), {
        type: 'doughnut',
        data: {
        labels: subjects.map(s => s.subject),
        datasets: [{
        data: subjects.map(s => s.count),
        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#0dcaf0', '#6f42c1']
        }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
        });
        });
    </script>
}