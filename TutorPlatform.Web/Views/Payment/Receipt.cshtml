@model TutorPlatform.Core.Models.Payment
@{
    ViewData["Title"] = "Biên nhận";
    Layout = null;
    var b = Model.Booking;
    var subtotal = Model.Amount + Model.DiscountAmount;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Biên nhận #@Model.OrderCode</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; background:#f3f4f6; margin:0; padding:24px; color:#1f2937; }
        .receipt { max-width:560px; margin:auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 6px 24px rgba(0,0,0,.08); }
        .head { background:#7c3aed; color:#fff; padding:22px 26px; }
        .head h1 { margin:0; font-size:20px; }
        .head p { margin:4px 0 0; opacity:.9; font-size:13px; }
        .body { padding:26px; }
        .status { display:inline-block; background:#dcfce7; color:#166534; font-weight:700; font-size:12px; padding:4px 12px; border-radius:20px; margin-bottom:16px; }
        table { width:100%; border-collapse:collapse; font-size:14px; }
        td { padding:7px 0; vertical-align:top; }
        td.label { color:#6b7280; width:42%; }
        td.val { text-align:right; font-weight:600; }
        .divider { border-top:1px dashed #e5e7eb; margin:14px 0; }
        .total { font-size:18px; font-weight:800; color:#7c3aed; }
        .foot { text-align:center; color:#9ca3af; font-size:12px; padding:0 26px 24px; }
        .actions { max-width:560px; margin:16px auto 0; text-align:center; }
        .btn { display:inline-block; border:none; border-radius:8px; padding:10px 20px; font-weight:600; cursor:pointer; text-decoration:none; font-size:14px; }
        .btn-print { background:#7c3aed; color:#fff; }
        .btn-back { background:#e5e7eb; color:#374151; margin-left:8px; }
        @@media print { body { background:#fff; padding:0; } .actions { display:none; } .receipt { box-shadow:none; } }
    </style>
</head>
<body>
    <div class="receipt">
        <div class="head">
            <h1>Gia Sư Việt — Biên nhận thanh toán</h1>
            <p>Mã giao dịch: @Model.OrderCode</p>
        </div>
        <div class="body">
            <span class="status">ĐÃ THANH TOÁN</span>
            <table>
                <tr><td class="label">Ngày thanh toán</td><td class="val">@(Model.PaidAt?.AddHours(7).ToString("HH:mm dd/MM/yyyy"))</td></tr>
                <tr><td class="label">Học viên</td><td class="val">@b?.Student?.FullName</td></tr>
                <tr><td class="label">Gia sư</td><td class="val">@b?.TutorProfile?.User?.FullName</td></tr>
                <tr><td class="label">Môn học</td><td class="val">@b?.Subject?.Name</td></tr>
                <tr><td class="label">Buổi học</td><td class="val">@b?.StartTime.AddHours(7).ToString("HH:mm dd/MM/yyyy")</td></tr>
                @if (!string.IsNullOrEmpty(Model.TransactionNo))
                {
                    <tr><td class="label">Mã VNPay</td><td class="val">@Model.TransactionNo</td></tr>
                }
            </table>
            <div class="divider"></div>
            <table>
                <tr><td class="label">Tạm tính</td><td class="val">@subtotal.ToString("N0")đ</td></tr>
                @if (Model.DiscountAmount > 0)
                {
                    <tr><td class="label">Giảm giá@(string.IsNullOrEmpty(Model.CouponCode) ? "" : $" ({Model.CouponCode})")</td><td class="val" style="color:#059669;">-@Model.DiscountAmount.ToString("N0")đ</td></tr>
                }
                <tr><td class="label total">Tổng thanh toán</td><td class="val total">@Model.Amount.ToString("N0")đ</td></tr>
            </table>
        </div>
        <div class="foot">Cảm ơn bạn đã sử dụng Gia Sư Việt. Biên nhận này được tạo tự động.</div>
    </div>

    <div class="actions">
        <button class="btn btn-print" onclick="window.print()">🖨️ In / Lưu PDF</button>
        <a class="btn btn-back" href="/Booking/MyBookings">Quay lại</a>
    </div>
</body>
</html>
