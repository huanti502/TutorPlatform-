@model TutorPlatform.Web.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-4" style="max-width:560px;">
    <h3 class="mb-3">Xác nhận thanh toán</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Gia sư</span><b>@Model.TutorName</b>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Môn học</span><b>@Model.SubjectName</b>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Thời gian</span><b>@Model.TimeText</b>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Số giờ × học phí</span>
                <b>@Model.Hours h × @Model.HourlyRate.ToString("N0")đ</b>
            </div>
            <hr />
            <div class="d-flex justify-content-between mb-1">
                <span>Tạm tính</span>
                <span id="baseAmount" data-value="@Model.BaseAmount">@Model.BaseAmount.ToString("N0")đ</span>
            </div>
            <div class="d-flex justify-content-between mb-1 text-success" id="discountRow" style="display:none !important;">
                <span>Giảm giá</span><span id="discountText">-0đ</span>
            </div>
            <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                <span>Tổng thanh toán</span>
                <span id="finalAmount" style="color:#7c3aed;">@Model.BaseAmount.ToString("N0")đ</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Mã giảm giá</label>
            <div class="input-group">
                <input type="text" id="couponInput" class="form-control text-uppercase" placeholder="Nhập mã, vd: WELCOME" />
                <button type="button" id="applyBtn" class="btn btn-outline-primary">Áp dụng</button>
            </div>
            <div id="couponMsg" class="small mt-2"></div>
        </div>
    </div>

    <form asp-controller="Payment" asp-action="Pay" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="bookingId" value="@Model.BookingId" />
        <input type="hidden" name="couponCode" id="couponCodeField" value="" />
        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="background:#7c3aed;border:none;">
            Thanh toán qua VNPay
        </button>
    </form>
    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-link w-100 mt-2">Quay lại</a>
</div>

@section Scripts {
<script>
(function () {
    const bookingId = @Model.BookingId;
    const baseEl = document.getElementById("baseAmount");
    const base = parseFloat(baseEl.dataset.value);
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    const input = document.getElementById("couponInput");
    const msg = document.getElementById("couponMsg");
    const discRow = document.getElementById("discountRow");
    const discText = document.getElementById("discountText");
    const finalEl = document.getElementById("finalAmount");
    const codeField = document.getElementById("couponCodeField");

    function fmt(n){ return Number(n).toLocaleString("vi-VN") + "đ"; }

    document.getElementById("applyBtn").addEventListener("click", function () {
        const code = (input.value || "").trim().toUpperCase();
        if (!code) { msg.textContent = "Vui lòng nhập mã."; msg.className = "small mt-2 text-danger"; return; }

        const body = "bookingId=" + bookingId + "&code=" + encodeURIComponent(code)
                   + "&__RequestVerificationToken=" + encodeURIComponent(token);

        fetch("/Payment/ApplyCoupon", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body
        })
        .then(r => r.json())
        .then(d => {
            if (!d.ok) {
                msg.textContent = d.message; msg.className = "small mt-2 text-danger";
                discRow.style.setProperty("display", "none", "important");
                finalEl.textContent = fmt(base);
                codeField.value = "";
                return;
            }
            msg.textContent = d.message; msg.className = "small mt-2 text-success";
            discText.textContent = "-" + fmt(d.discount);
            discRow.style.setProperty("display", "flex", "important");
            finalEl.textContent = fmt(d.finalAmount);
            codeField.value = d.code;
        })
        .catch(() => { msg.textContent = "Lỗi kết nối, thử lại."; msg.className = "small mt-2 text-danger"; });
    });
})();
</script>
}
