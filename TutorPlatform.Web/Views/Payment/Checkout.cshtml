@model TutorPlatform.Core.Models.Booking
@{
    ViewData["Title"] = "Thanh toán";
    decimal totalPrice = (decimal)ViewBag.TotalPrice;
    string qrUrl = ViewBag.QrUrl;
}

<style>
    .pay-card {
        background: #fff;
        border-radius: 24px;
        border: none;
        box-shadow: 0 8px 40px rgba(15,23,42,0.12);
        overflow: hidden;
    }
    .pay-header {
        background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%);
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .pay-header::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 180px; height: 180px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
    }
    .pay-header::after {
        content: '';
        position: absolute;
        bottom: -60px; left: -30px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,0.03);
    }
    .amount-display {
        font-size: clamp(1.75rem, 5vw, 2.5rem);
        font-weight: 800;
        color: #F59E0B;
        letter-spacing: -1px;
    }
    .qr-frame {
        background: #fff;
        border-radius: 20px;
        padding: 1.25rem;
        display: inline-block;
        box-shadow: 0 4px 20px rgba(15,23,42,0.1);
        border: 1px solid #E2E8F0;
    }
    .step-badge {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: #0F172A;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .confirm-btn {
        background: linear-gradient(135deg, #059669, #10B981);
        color: #fff;
        border: none;
        border-radius: 14px;
        padding: 1rem;
        font-weight: 800;
        font-size: 1rem;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 16px rgba(5,150,105,0.35);
    }
    .confirm-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(5,150,105,0.4);
    }
</style>

<section class="section-sm" style="background:var(--bg);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <!-- Breadcrumb -->
                <nav class="mb-4" style="font-size:0.85rem;">
                    <a asp-controller="Booking" asp-action="MyBookings"
                       class="d-inline-flex align-items-center gap-1"
                       style="color:var(--text-muted);text-decoration:none;
                              font-weight:500;">
                        <svg width="14" height="14" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <path d="m15 18-6-6 6-6"/>
                        </svg>
                        Trở về lịch học
                    </a>
                </nav>

                <div class="pay-card">

                    <!-- ===== HEADER ===== -->
                    <div class="pay-header">
                        <div style="position:relative;z-index:1;">
                            <div style="width:52px;height:52px;border-radius:16px;
                                        background:rgba(255,255,255,0.12);
                                        display:flex;align-items:center;
                                        justify-content:center;
                                        margin:0 auto 1rem;border:1px solid
                                        rgba(255,255,255,0.2);">
                                <svg width="26" height="26" fill="none"
                                     stroke="#F59E0B" stroke-width="1.8"
                                     viewBox="0 0 24 24">
                                    <rect x="1" y="4" width="22" height="16"
                                          rx="2" ry="2"/>
                                    <line x1="1" y1="10" x2="23" y2="10"/>
                                </svg>
                            </div>
                            <div style="color:rgba(255,255,255,0.6);font-size:0.78rem;
                                        font-weight:700;text-transform:uppercase;
                                        letter-spacing:0.08em;margin-bottom:0.4rem;">
                                Số tiền thanh toán
                            </div>
                            <div class="amount-display">
                                @totalPrice.ToString("N0") <span style="font-size:1.2rem;color:#F59E0B;">₫</span>
                            </div>
                            <div style="color:rgba(255,255,255,0.5);font-size:0.8rem;
                                        margin-top:0.5rem;">
                                Môn <strong style="color:rgba(255,255,255,0.85);">
                                    @Model.Subject.Name
                                </strong>
                                · Gia sư <strong style="color:rgba(255,255,255,0.85);">
                                    @Model.TutorProfile.User.FullName
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- ===== BODY ===== -->
                    <div class="p-4">

                        <!-- QR Code -->
                        <div class="text-center mb-4">
                            <div style="font-size:0.78rem;font-weight:700;
                                        color:var(--text-muted);
                                        text-transform:uppercase;
                                        letter-spacing:0.06em;
                                        margin-bottom:1rem;">
                                Quét mã QR để thanh toán
                            </div>
                            <div class="qr-frame">
                                <img src="@qrUrl" alt="QR Thanh toán"
                                     style="width:220px;height:220px;
                                            display:block;" />
                            </div>
                            <div style="font-size:0.75rem;color:var(--text-muted);
                                        margin-top:0.75rem;">
                                Hỗ trợ tất cả ứng dụng ngân hàng Việt Nam
                            </div>
                        </div>

                        <!-- Steps -->
                        <div style="background:var(--bg);border-radius:14px;
                                    padding:1.25rem;margin-bottom:1.25rem;">
                            <div style="font-size:0.78rem;font-weight:700;
                                        color:var(--text-muted);
                                        text-transform:uppercase;
                                        letter-spacing:0.06em;
                                        margin-bottom:1rem;">
                                Hướng dẫn thanh toán
                            </div>
                            @foreach (var (num, step) in new[]{
                                ("1", "Mở ứng dụng ngân hàng của bạn"),
                                ("2", "Chọn QR Pay / Quét mã"),
                                ("3", "Quét mã và xác nhận số tiền"),
                                ("4", "Nhấn nút xác nhận bên dưới"),
                            })
                            {
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="step-badge">@num</div>
                                    <span style="font-size:0.875rem;
                                                 color:var(--text-secondary);
                                                 font-weight:500;">
                                        @step
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Warning -->
                        <div style="background:#FFFBEB;border-radius:12px;
                                    padding:0.875rem 1rem;margin-bottom:1.25rem;
                                    border:1px solid #FDE68A;
                                    display:flex;gap:0.75rem;align-items:flex-start;">
                            <svg width="18" height="18" fill="none"
                                 stroke="#D97706" stroke-width="2"
                                 viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94
                                         a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                <line x1="12" y1="9" x2="12" y2="13"/>
                                <line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            <p style="font-size:0.8rem;color:#92400E;
                                      margin:0;line-height:1.6;font-weight:500;">
                                Giữ nguyên <strong>nội dung chuyển khoản</strong>
                                để hệ thống tự động nhận diện thanh toán.
                            </p>
                        </div>

                        <!-- Confirm button -->
                        <form asp-action="ConfirmPayment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.Id"/>
                            <button type="submit" class="confirm-btn">
                                <svg width="20" height="20" fill="none"
                                     stroke="currentColor" stroke-width="2.5"
                                     viewBox="0 0 24 24" style="margin-right:6px;">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                Tôi đã chuyển khoản xong
                            </button>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>